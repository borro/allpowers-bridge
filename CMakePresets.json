{
  "version": 6,
  "cmakeMinimumRequired": {"major": 4, "minor": 4, "patch": 0},
  "configurePresets": [
    {"name": "verify", "inherits": "base", "displayName": "Build products and run every available local check",
     "cacheVariables": {"ALLPOWERS_VERIFY": "ON",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/verify/dist"}},
    {"name": "base", "hidden": true, "generator": "Ninja",
     "binaryDir": "${sourceDir}/build/${presetName}",
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/dist",
       "ALLPOWERS_DEPS_DIR": "${sourceDir}/build/deps"}},
    {"name": "native", "inherits": "base", "displayName": "Portable core; Linux firmware targets"},
    {"name": "static-analysis-linux", "inherits": "native", "displayName": "Clang-Tidy and Cppcheck",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++-18", "ALLPOWERS_STATIC_ANALYSIS": "ON",
       "CMAKE_CXX_SCAN_FOR_MODULES": "OFF",
       "ALLPOWERS_COVERAGE": "OFF", "ALLPOWERS_SANITIZERS": "OFF", "ALLPOWERS_MUTATION": "OFF",
       "ALLPOWERS_FUZZING": "OFF", "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "fuzz-linux", "inherits": "native", "displayName": "Linux BLE and HID fuzzing",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++-18", "ALLPOWERS_FUZZING": "ON",
       "ALLPOWERS_COVERAGE": "OFF", "ALLPOWERS_SANITIZERS": "OFF", "ALLPOWERS_MUTATION": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "valgrind-linux", "inherits": "native", "displayName": "Linux host Memcheck",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug", "ALLPOWERS_COVERAGE": "OFF",
       "ALLPOWERS_SANITIZERS": "OFF", "ALLPOWERS_MUTATION": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "mutation-linux", "inherits": "native", "displayName": "Linux host mutation testing",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"CMAKE_CXX_COMPILER": "clang++-18", "ALLPOWERS_MUTATION": "ON",
       "ALLPOWERS_COVERAGE": "OFF", "ALLPOWERS_SANITIZERS": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "windows", "inherits": "base", "displayName": "Static Windows monitor + portable targets",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows"},
     "cacheVariables": {"ALLPOWERS_BUILD_WINDOWS": "ON"}},
    {"name": "coverage-linux", "inherits": "native", "displayName": "Linux host line coverage",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"ALLPOWERS_COVERAGE": "ON", "ALLPOWERS_SANITIZERS": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "coverage-windows", "inherits": "windows", "displayName": "Windows host line coverage",
     "cacheVariables": {"ALLPOWERS_COVERAGE": "ON", "ALLPOWERS_SANITIZERS": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "sanitizers-linux", "inherits": "native",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"ALLPOWERS_SANITIZERS": "ON", "ALLPOWERS_COVERAGE": "OFF",
       "ALLPOWERS_MUTATION": "OFF", "ALLPOWERS_FUZZING": "OFF",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}},
    {"name": "firmware-linux", "inherits": "native",
     "condition": {"type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux"},
     "cacheVariables": {"BUILD_TESTING": "OFF", "ALLPOWERS_ARDUINO_JOBS": "2",
       "ALLPOWERS_FIRMWARE_PARALLEL_BOARDS": "2",
       "ALLPOWERS_RELEASE_DIR": "${sourceDir}/build/${presetName}/dist"}}
  ],
  "buildPresets": [
    {"name": "verify", "configurePreset": "verify", "targets": ["verify"], "jobs": 2,
     "environment": {"PATH": "${sourceDir}/build/verify/tools/ninja${pathListSep}$penv{PATH}"}},
    {"name": "native", "configurePreset": "native", "targets": ["core", "native-tests"]},
    {"name": "static-analysis-linux", "configurePreset": "static-analysis-linux", "targets": ["static-analysis"]},
    {"name": "fuzz-linux", "configurePreset": "fuzz-linux", "targets": ["fuzz-tests"]},
    {"name": "mutation-linux", "configurePreset": "mutation-linux", "targets": ["mutation-report"]},
    {"name": "windows", "configurePreset": "windows", "targets": ["core", "native-tests", "windows"]},
    {"name": "all-windows", "configurePreset": "windows", "targets": ["products"]},
    {"name": "all-linux", "configurePreset": "native", "targets": ["products"]},
    {"name": "release", "configurePreset": "windows", "targets": ["release"]},
    {"name": "coverage-linux", "configurePreset": "coverage-linux", "targets": ["core", "native-tests"]},
    {"name": "coverage-windows", "configurePreset": "coverage-windows", "targets": ["core", "native-tests", "windows"]},
    {"name": "sanitizers-linux", "configurePreset": "sanitizers-linux", "targets": ["core", "native-tests"]},
    {"name": "firmware-linux", "configurePreset": "firmware-linux", "targets": ["firmware"]}
  ],
  "workflowPresets": [
    {"name": "verify", "steps": [{"type": "configure", "name": "verify"}, {"type": "build", "name": "verify"}]}
  ],
  "testPresets": [
    {"name": "native", "configurePreset": "native", "execution": {"jobs": 4}, "output": {"outputOnFailure": true}},
    {"name": "fuzz-linux", "configurePreset": "fuzz-linux", "execution": {"jobs": 2},
     "filter": {"include": {"label": "^fuzz$"}}, "output": {"outputOnFailure": true}},
    {"name": "windows", "configurePreset": "windows", "execution": {"jobs": 4}, "output": {"outputOnFailure": true}},
    {"name": "coverage-linux", "configurePreset": "coverage-linux",
     "filter": {"include": {"name": "^coverage-report$"}}, "output": {"outputOnFailure": true}},
    {"name": "coverage-windows", "configurePreset": "coverage-windows",
     "filter": {"include": {"name": "^coverage-report$"}}, "output": {"outputOnFailure": true}},
    {"name": "sanitizers-linux", "configurePreset": "sanitizers-linux", "execution": {"jobs": 2},
     "filter": {"include": {"label": "^runtime$"}}, "output": {"outputOnFailure": true}}
  ]
}
