include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Download.cmake")

function(ap_setup_upx)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "DEPS_DIR;WORK;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED DEPS_DIR WORK OUTPUT)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../Dependencies.cmake")
  if(NOT CMAKE_HOST_WIN32)
    message(FATAL_ERROR "UPX setup requires Windows")
  endif()
  get_filename_component(DEPS_DIR "${AP_DEPS_DIR}" ABSOLUTE)
  get_filename_component(WORK "${AP_WORK}" ABSOLUTE)
  set(name "upx-${ALLPOWERS_UPX_VERSION}-win64")
  set(archive "${DEPS_DIR}/downloads/${name}.zip")
  file(MAKE_DIRECTORY "${DEPS_DIR}/downloads" "${WORK}")
  file(LOCK "${WORK}/.upx.lock" GUARD FUNCTION TIMEOUT 180)
  ap_download_verified(URL "https://github.com/upx/upx/releases/download/v${ALLPOWERS_UPX_VERSION}/${name}.zip" DESTINATION "${archive}"
    SHA256 "${ALLPOWERS_UPX_WINDOWS_SHA256}" MISMATCH FAIL TIMEOUT 180 INACTIVITY_TIMEOUT 30)
  # Restore the official unmodified executable from the verified archive on every use.
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK}")
  set(UPX_EXECUTABLE "${WORK}/${name}/upx.exe")
  execute_process(COMMAND "${UPX_EXECUTABLE}" --version OUTPUT_VARIABLE version
    COMMAND_ERROR_IS_FATAL ANY)
  string(REPLACE "." "\\." expected "${ALLPOWERS_UPX_VERSION}")
  if(NOT version MATCHES "^upx ${expected}(\r?\n|$)")
    message(FATAL_ERROR "Unexpected UPX version: ${version}")
  endif()
  message(STATUS "Verified UPX ${ALLPOWERS_UPX_VERSION}")
  set(${AP_OUTPUT} "${UPX_EXECUTABLE}" PARENT_SCOPE)
endfunction()
