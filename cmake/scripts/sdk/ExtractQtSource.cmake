cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Download.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Files.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
foreach(required MODULE SOURCE_CACHE BUILD_ROOT OUTPUT)
  if(NOT ${required})
    message(FATAL_ERROR "Set ${required} for Qt source preparation")
  endif()
endforeach()
if(NOT MODULE MATCHES "^(qtbase|qtconnectivity|qttools)$")
  message(FATAL_ERROR "Unknown Qt module: ${MODULE}")
endif()
ap_assert_child_path(ROOT "${BUILD_ROOT}" PATH "${OUTPUT}")
string(TOUPPER "${MODULE}" key)
set(name "${MODULE}-everywhere-src-${ALLPOWERS_QT_VERSION}")
set(archive "${SOURCE_CACHE}/${name}.tar.xz")
ap_download_verified(URL "${ALLPOWERS_QT_SOURCE_URL}/${name}.tar.xz"
  DESTINATION "${archive}" SHA256 "${ALLPOWERS_${key}_SHA256}" MISMATCH REPLACE)
set(work "${BUILD_ROOT}/qt-extract-${MODULE}")
file(MAKE_DIRECTORY "${BUILD_ROOT}")
file(LOCK "${BUILD_ROOT}/qt-extract-${MODULE}.lock" GUARD PROCESS TIMEOUT 600)
ap_remove_tree(ROOT "${BUILD_ROOT}" PATH "${work}")
file(MAKE_DIRECTORY "${work}")
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${work}" TOUCH)
if(NOT EXISTS "${work}/${name}/CMakeLists.txt")
  message(FATAL_ERROR "Qt archive does not contain ${name}/CMakeLists.txt")
endif()
ap_remove_tree(ROOT "${BUILD_ROOT}" PATH "${OUTPUT}")
file(RENAME "${work}/${name}" "${OUTPUT}")
ap_remove_tree(ROOT "${BUILD_ROOT}" PATH "${work}")
