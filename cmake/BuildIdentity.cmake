cmake_minimum_required(VERSION 3.26)
include("${CMAKE_CURRENT_LIST_DIR}/Version.cmake")
function(write_changed path content)
  if(EXISTS "${path}")
    file(READ "${path}" previous)
    if(previous STREQUAL content)
      return()
    endif()
  endif()
  file(WRITE "${path}" "${content}")
endfunction()
file(MAKE_DIRECTORY "${OUTPUT}")
set(commit source-archive)
if(GIT_FOUND AND EXISTS "${ALLPOWERS_ROOT}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${ALLPOWERS_ROOT}"
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
write_changed("${OUTPUT}/product-version.txt" "${ALLPOWERS_VERSION}\n")
set(dirty 0)
if(ALLPOWERS_VERSION MATCHES "-dirty$")
  set(dirty 1)
endif()
write_changed("${OUTPUT}/product-version.h"
  "#pragma once\n#define APP_VERSION \"${ALLPOWERS_VERSION}\"\n#define AP_PRODUCT_VERSION \"${ALLPOWERS_VERSION}\"\n#define AP_PRODUCT_COMMIT \"${commit}\"\n#define AP_PRODUCT_DIRTY ${dirty}\n")
write_changed("${OUTPUT}/product-identity.cmake"
  "set(ALLPOWERS_VERSION \"${ALLPOWERS_VERSION}\")\nset(ALLPOWERS_VERSION_NUMERIC \"${ALLPOWERS_VERSION_NUMERIC}\")\nset(ALLPOWERS_BUILD_COMMIT \"${commit}\")\nset(ALLPOWERS_BUILD_DIRTY ${dirty})\n")
if(EXISTS "${RESOURCE_SOURCE}/app.rc.in")
  string(REPLACE "." "," ALLPOWERS_RC_VERSION "${ALLPOWERS_VERSION_NUMERIC}")
  set(CMAKE_CURRENT_SOURCE_DIR "${RESOURCE_SOURCE}")
  foreach(app AllpowersMonitor AllpowersWidget)
    set(ALLPOWERS_EXE_NAME "${app}")
    set(ALLPOWERS_EXE_DESCRIPTION "${app}")
    configure_file("${RESOURCE_SOURCE}/app.rc.in" "${OUTPUT}/${app}.rc" @ONLY)
  endforeach()
endif()
if(EXISTS "${RESOURCE_SOURCE}/AllpowersUps.inf.in")
  configure_file("${RESOURCE_SOURCE}/AllpowersUps.inf.in" "${OUTPUT}/../package/AllpowersUps.inf" @ONLY)
endif()
