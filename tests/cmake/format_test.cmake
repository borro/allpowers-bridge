cmake_minimum_required(VERSION 4.4)
if(NOT ROOT OR NOT WORK OR NOT TOOL)
  message(FATAL_ERROR "ROOT, WORK and TOOL are required")
endif()
set(fixture "${WORK}/source")
file(MAKE_DIRECTORY "${fixture}/apps/windows")
configure_file("${ROOT}/.clang-format" "${fixture}/.clang-format" COPYONLY)
file(WRITE "${fixture}/SOURCE_FILES" ".clang-format\napps/windows/control.cpp\n")
set(source "${fixture}/apps/windows/control.cpp")
function(check expected)
  file(SHA256 "${source}" before)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${fixture}" "-DTOOL=${TOOL}"
    -P "${ROOT}/cmake/scripts/quality/RunFormat.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  file(SHA256 "${source}" after)
  if(NOT before STREQUAL after)
    message(FATAL_ERROR "Formatting check changed its input")
  endif()
  if(expected STREQUAL pass AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid formatting rejected: ${output}${error}")
  elseif(expected STREQUAL fail AND (result EQUAL 0 OR NOT "${output}${error}" MATCHES "clang-format-violations"))
    message(FATAL_ERROR "Invalid formatting was not detected: ${output}${error}")
  endif()
endfunction()
file(WRITE "${source}" "int value() {\n  return 1;\n}\n")
check(pass)
file(WRITE "${source}" "int value(){return 1;}\n")
check(fail)
message(STATUS "Formatting controls passed: valid input accepted, invalid input rejected, no source edits")
