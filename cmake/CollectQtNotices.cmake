# Qt attribution paths are relative to qt_attribution.json, not its Path field.
# License names are not standardized (LICENCE.md, BDF-LICENSE.txt, etc.).
function(ap_collect_qt_notices source destination)
  file(REAL_PATH "${source}" source)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${source}/*")
  set(selected)
  foreach(path IN LISTS files)
    get_filename_component(basename "${path}" NAME)
    string(TOLOWER "${basename}" basename)
    file(RELATIVE_PATH relative "${source}" "${path}")
    if(relative MATCHES "^LICENSES/" OR basename MATCHES "licen[cs]e|copying|copyright|notice" OR
        basename STREQUAL "qt_attribution.json")
      list(APPEND selected "${path}")
    endif()
    if(NOT basename STREQUAL "qt_attribution.json")
      continue()
    endif()
    file(READ "${path}" metadata)
    string(JSON kind TYPE "${metadata}")
    if(kind STREQUAL "OBJECT")
      set(metadata "[${metadata}]")
    endif()
    string(JSON count LENGTH "${metadata}")
    if(count EQUAL 0)
      continue()
    endif()
    math(EXPR last "${count}-1")
    get_filename_component(directory "${path}" DIRECTORY)
    foreach(index RANGE ${last})
      set(references)
      foreach(field LicenseFile CopyrightFile)
        string(JSON value ERROR_VARIABLE error GET "${metadata}" ${index} "${field}")
        if(NOT error AND value)
          list(APPEND references "${value}")
        endif()
      endforeach()
      string(JSON length ERROR_VARIABLE error LENGTH "${metadata}" ${index} LicenseFiles)
      if(NOT error AND length GREATER 0)
        math(EXPR end "${length}-1")
        foreach(item RANGE ${end})
          string(JSON value GET "${metadata}" ${index} LicenseFiles ${item})
          list(APPEND references "${value}")
        endforeach()
      endif()
      foreach(reference IN LISTS references)
        file(REAL_PATH "${directory}/${reference}" resolved)
        cmake_path(IS_PREFIX source "${resolved}" NORMALIZE inside)
        if(NOT inside OR NOT EXISTS "${resolved}" OR IS_DIRECTORY "${resolved}")
          message(FATAL_ERROR "Missing/unsafe Qt attribution file: ${path}: ${reference}")
        endif()
        list(APPEND selected "${resolved}")
      endforeach()
    endforeach()
  endforeach()
  list(REMOVE_DUPLICATES selected)
  list(SORT selected)
  foreach(path IN LISTS selected)
    file(RELATIVE_PATH relative "${source}" "${path}")
    get_filename_component(directory "${relative}" DIRECTORY)
    file(MAKE_DIRECTORY "${destination}/${directory}")
    file(COPY_FILE "${path}" "${destination}/${relative}" ONLY_IF_DIFFERENT)
  endforeach()
endfunction()
