cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Arguments.cmake")
get_filename_component(WORK "${WORK}" ABSOLUTE)
file(MAKE_DIRECTORY "${WORK}")
get_filename_component(exe_name "${EXE}" NAME)
if(IDENTITY_FILE)
  if(NOT EXISTS "${IDENTITY_FILE}")
    message(FATAL_ERROR "Generated build identity is missing: ${IDENTITY_FILE}")
  endif()
  include("${IDENTITY_FILE}")
  if(NOT ALLPOWERS_VERSION)
    message(FATAL_ERROR "Generated build identity has no product version")
  endif()
  if(VERSION AND NOT VERSION STREQUAL ALLPOWERS_VERSION)
    message(FATAL_ERROR "Explicit expected version conflicts with generated build identity")
  endif()
  set(VERSION "${ALLPOWERS_VERSION}")
endif()
if(VERSION)
  find_program(powershell NAMES pwsh powershell REQUIRED)
  execute_process(COMMAND "${powershell}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/../../../tools/windows/CheckExeVersion.ps1"
    -Path "${EXE}" -ExpectedVersion "${VERSION}" COMMAND_ERROR_IS_FATAL ANY)
endif()
file(COPY_FILE "${EXE}" "${WORK}/${exe_name}" ONLY_IF_DIFFERENT)
find_program(DUMPBIN dumpbin REQUIRED)
execute_process(COMMAND "${DUMPBIN}" /nologo /dependents "${EXE}"
  OUTPUT_VARIABLE imports COMMAND_ERROR_IS_FATAL ANY)
string(TOLOWER "${imports}" lower)
if(lower MATCHES "(qt[0-9]|msvcp[0-9]|vcruntime|concrt|ucrtbase)[a-z0-9_]*\\.dll")
  message(FATAL_ERROR "Non-static dependency in executable:\n${imports}")
endif()
string(REGEX MATCHALL "[A-Za-z0-9_.-]+\\.[dD][lL][lL]" names "${imports}")
if(NOT names)
  message(FATAL_ERROR "PE import inspection returned no DLLs")
endif()
foreach(name IN LISTS names)
  string(TOLOWER "${name}" normalized)
  if(NOT normalized MATCHES "^(api-ms-win-|ext-ms-win-)" AND NOT EXISTS "$ENV{SystemRoot}/System32/${name}")
    message(FATAL_ERROR "Non-system DLL dependency: ${name}")
  endif()
endforeach()
file(WRITE "${WORK}/imports.txt" "${imports}")
function(ap_run_smoke)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "LANGUAGE;REPORT_PATH;WORK;EXE_NAME" "")
  ap_require_arguments(PREFIX AP REQUIRED LANGUAGE REPORT_PATH WORK EXE_NAME)
  set(WORK "${AP_WORK}")
  set(exe_name "${AP_EXE_NAME}")
  set(language "${AP_LANGUAGE}")
  set(report_path "${AP_REPORT_PATH}")
  set(language_args)
  if(NOT language STREQUAL "system")
    set(language_args --language "${language}")
  endif()
  # Never mistake a report from an earlier run for this process's result.
  file(REMOVE "${report_path}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env
    --unset=QT_PLUGIN_PATH --unset=QT_QPA_PLATFORM_PLUGIN_PATH --unset=QT_QPA_PLATFORM
    "PATH=$ENV{SystemRoot}/System32" -- "${WORK}/${exe_name}"
    --self-test ${language_args} --report "${report_path}" -platform offscreen
    WORKING_DIRECTORY "${WORK}" TIMEOUT 20 RESULT_VARIABLE result
    OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  file(WRITE "${WORK}/self-test-${language}-out.log" "${stdout}")
  file(WRITE "${WORK}/self-test-${language}-err.log" "${stderr}")
  if(NOT result STREQUAL "0")
    set(diagnostics "No JSON report was produced.")
    if(EXISTS "${report_path}")
      file(READ "${report_path}" diagnostics LIMIT 12000)
    endif()
    message(FATAL_ERROR "${exe_name} standalone self-test failed: language=${language}, result=${result}\n"
      "${stdout}\n${stderr}\n${diagnostics}")
  endif()
endfunction()
ap_run_smoke(WORK "${WORK}" EXE_NAME "${exe_name}" LANGUAGE system REPORT_PATH "${WORK}/report.json")
file(READ "${WORK}/report.json" report)
string(JSON status GET "${report}" status)
string(JSON notices GET "${report}" embedded_notices)
string(JSON lgpl GET "${report}" lgpl_notice)
if(NOT status STREQUAL "PASS" OR notices LESS 1 OR NOT lgpl)
  message(FATAL_ERROR "Standalone EXE smoke test failed")
endif()
foreach(language ru en zh-CN zh-TW)
  ap_run_smoke(WORK "${WORK}" EXE_NAME "${exe_name}" LANGUAGE "${language}" REPORT_PATH "${WORK}/report-${language}.json")
  file(READ "${WORK}/report-${language}.json" localized_report)
  string(JSON localized_status GET "${localized_report}" status)
  string(JSON resolved_language GET "${localized_report}" ui_language)
  if(NOT localized_status STREQUAL "PASS" OR NOT resolved_language STREQUAL language)
    message(FATAL_ERROR "Standalone ${language} interface smoke test failed")
  endif()
endforeach()
execute_process(COMMAND "${WORK}/${exe_name}" --export-licenses "${WORK}/licenses"
  -platform offscreen TIMEOUT 20 COMMAND_ERROR_IS_FATAL ANY)
foreach(required LICENSE THIRD_PARTY_NOTICES.md relinking.md windows-runtime-terms.md MSVC-STL.md UPX.md
    Qt/qtbase/LICENSES/LGPL-3.0-only.txt Qt/qtbase/LICENSES/GPL-3.0-only.txt
    Qt/qtbase/src/3rdparty/pcre2/LICENCE.md Qt/qtbase/src/3rdparty/freetype/BDF-LICENSE.txt
    Qt/qtbase/src/3rdparty/libjpeg/COPYRIGHT.txt Qt/qtbase/src/3rdparty/libjpeg/ijg-license.txt)
  if(NOT EXISTS "${WORK}/licenses/${required}")
    message(FATAL_ERROR "Required license/copyright text missing from ${exe_name}: ${required}")
  endif()
endforeach()
if(NOT WIDGET)
execute_process(COMMAND "${WORK}/${exe_name}" --service
  RESULT_VARIABLE service_result TIMEOUT 10)
if(NOT service_result EQUAL 1063)
  message(FATAL_ERROR "Service mode must refuse a console launch (1063): ${service_result}")
endif()
if(DRIVER_PACKAGE)
  execute_process(COMMAND "${WORK}/AllpowersMonitor.exe" --extract-driver "${WORK}/driver"
    TIMEOUT 10 COMMAND_ERROR_IS_FATAL ANY)
  foreach(name AllpowersUps.sys AllpowersUps.inf AllpowersUps.cat)
    file(SHA256 "${WORK}/driver/${name}" embedded_hash)
    file(SHA256 "${DRIVER_PACKAGE}/${name}" built_hash)
    if(NOT embedded_hash STREQUAL built_hash)
      message(FATAL_ERROR "Embedded driver differs from the built package: ${name}")
    endif()
  endforeach()
endif()
endif()
message(STATUS "Single EXE: system-only imports, offline UI/SQLite/notices, SCM guard and driver payload passed")
