cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/project/Version.cmake")
ap_read_version(ROOT "${ALLPOWERS_ROOT}")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Files.cmake")
file(MAKE_DIRECTORY "${OUTPUT}")
set(commit source-archive)
if(GIT_FOUND AND EXISTS "${ALLPOWERS_ROOT}/.git")
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${ALLPOWERS_ROOT}"
    OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
endif()
ap_write_changed(PATH "${OUTPUT}/product-version.txt" CONTENT "${ALLPOWERS_VERSION}\n")
set(dirty 0)
if(ALLPOWERS_VERSION MATCHES "-dirty$")
  set(dirty 1)
endif()
ap_write_changed(PATH "${OUTPUT}/product-version.h" CONTENT "#pragma once\n#define APP_VERSION \"${ALLPOWERS_VERSION}\"\n#define AP_PRODUCT_VERSION \"${ALLPOWERS_VERSION}\"\n#define AP_PRODUCT_COMMIT \"${commit}\"\n#define AP_PRODUCT_DIRTY ${dirty}\n")
ap_write_changed(PATH "${OUTPUT}/product-identity.cmake" CONTENT "set(ALLPOWERS_VERSION \"${ALLPOWERS_VERSION}\")\nset(ALLPOWERS_VERSION_NUMERIC \"${ALLPOWERS_VERSION_NUMERIC}\")\nset(ALLPOWERS_BUILD_COMMIT \"${commit}\")\nset(ALLPOWERS_BUILD_DIRTY ${dirty})\n")
if(EXISTS "${RESOURCE_SOURCE}/app.rc.in")
  string(REPLACE "." "," ALLPOWERS_RC_VERSION "${ALLPOWERS_VERSION_NUMERIC}")
  set(CMAKE_CURRENT_SOURCE_DIR "${RESOURCE_SOURCE}")
  foreach(app AllpowersMonitor AllpowersWidget)
    set(ALLPOWERS_EXE_NAME "${app}")
    set(ALLPOWERS_EXE_DESCRIPTION "${app}")
    configure_file("${RESOURCE_SOURCE}/app.rc.in" "${OUTPUT}/${app}.rc" @ONLY)
  endforeach()
endif()
if(EXISTS "${RESOURCE_SOURCE}/AllpowersUps.inf.in")
  configure_file("${RESOURCE_SOURCE}/AllpowersUps.inf.in" "${OUTPUT}/../package/AllpowersUps.inf" @ONLY)
endif()
