IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/assets/allpowers.ico"
#include <winver.h>
VS_VERSION_INFO VERSIONINFO
 FILEVERSION @ALLPOWERS_RC_VERSION@,0
 PRODUCTVERSION @ALLPOWERS_RC_VERSION@,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904B0"
  BEGIN
   VALUE "FileDescription", "@ALLPOWERS_EXE_DESCRIPTION@\0"
   VALUE "FileVersion", "@ALLPOWERS_VERSION@\0"
   VALUE "InternalName", "@ALLPOWERS_EXE_NAME@\0"
   VALUE "OriginalFilename", "@ALLPOWERS_EXE_NAME@.exe\0"
   VALUE "ProductName", "ALLPOWERS Bridge\0"
   VALUE "ProductVersion", "@ALLPOWERS_VERSION@\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
