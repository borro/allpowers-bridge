include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")
function(ap_little_endian)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;HEX" "")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT HEX)
  set(output "${AP_OUTPUT}")
  set(hex "${AP_HEX}")
  string(LENGTH "${hex}" length)
  set(result "")
  while(length GREATER 0)
    math(EXPR length "${length}-2")
    string(SUBSTRING "${hex}" ${length} 2 byte)
    string(APPEND result "${byte}")
  endwhile()
  math(EXPR result "0x${result}" OUTPUT_FORMAT DECIMAL)
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ap_partitions)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;BINARY;CONTRACT" "")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT BINARY CONTRACT)
  set(output "${AP_OUTPUT}")
  set(binary "${AP_BINARY}")
  set(contract "${AP_CONTRACT}")
  file(SIZE "${binary}" bytes)
  math(EXPR remainder "${bytes}%32")
  if(bytes LESS 32 OR bytes GREATER 4096 OR NOT remainder EQUAL 0)
    message(FATAL_ERROR "Partition table must fit one sector and contain whole entries")
  endif()
  file(READ "${binary}" table HEX)
  string(LENGTH "${table}" length)
  set(entries "{}")
  set(offset 0)
  set(names "")
  set(checksum FALSE)
  while(offset LESS length)
    string(SUBSTRING "${table}" ${offset} 64 record)
    string(SUBSTRING "${record}" 0 4 magic)
    if(magic STREQUAL "ebeb")
      string(SUBSTRING "${record}" 4 28 reserved)
      if(NOT reserved STREQUAL "ffffffffffffffffffffffffffff")
        message(FATAL_ERROR "Invalid partition checksum record")
      endif()
      math(EXPR prefix_bytes "${offset}/2")
      file(READ "${binary}" prefix LIMIT ${prefix_bytes})
      string(MD5 digest "${prefix}")
      string(SUBSTRING "${record}" 32 32 expected_digest)
      if(NOT digest STREQUAL expected_digest)
        message(FATAL_ERROR "Partition table checksum mismatch")
      endif()
      math(EXPR tail_offset "${offset}+64")
      string(SUBSTRING "${table}" ${tail_offset} -1 tail)
      if(NOT tail MATCHES "^f*$")
        message(FATAL_ERROR "Unexpected data after partition checksum")
      endif()
      set(checksum TRUE)
      break()
    elseif(NOT magic STREQUAL "aa50")
      message(FATAL_ERROR "Invalid partition entry or missing checksum")
    endif()
    string(SUBSTRING "${record}" 8 8 address)
    string(SUBSTRING "${record}" 16 8 size)
    ap_little_endian(OUTPUT address HEX "${address}")
    ap_little_endian(OUTPUT size HEX "${size}")
    set(label "")
    set(terminated FALSE)
    foreach(index RANGE 24 54 2)
      string(SUBSTRING "${record}" ${index} 2 byte)
      if(byte STREQUAL "00")
        set(terminated TRUE)
      elseif(terminated)
        message(FATAL_ERROR "Invalid partition label padding")
      else()
        math(EXPR value "0x${byte}")
        string(ASCII ${value} char)
        string(APPEND label "${char}")
      endif()
    endforeach()
    if(NOT terminated OR label IN_LIST names)
      message(FATAL_ERROR "Duplicate or invalid partition label: ${label}")
    endif()
    list(APPEND names "${label}")
    # Full fixed schema, including partitions not listed in the older public
    # fixture. Types/subtypes/flags are as important as offsets and sizes.
    if(label STREQUAL "nvs")
      set(schema "0102;36864;20480")
    elseif(label STREQUAL "otadata")
      set(schema "0100;57344;8192")
    elseif(label STREQUAL "app0")
      set(schema "0010;65536;3145728")
    elseif(label STREQUAL "app1")
      set(schema "0011;3211264;3145728")
    elseif(label STREQUAL "ffat")
      set(schema "0181;6356992;10223616")
    elseif(label STREQUAL "history")
      set(schema "0140;16580608;131072")
    elseif(label STREQUAL "coredump")
      set(schema "0103;16711680;65536")
    else()
      message(FATAL_ERROR "Unexpected partition: ${label}")
    endif()
    list(GET schema 0 type)
    list(GET schema 1 schema_address)
    list(GET schema 2 schema_size)
    string(SUBSTRING "${record}" 4 4 actual_type)
    string(SUBSTRING "${record}" 56 8 flags)
    if(NOT actual_type STREQUAL type OR NOT address EQUAL schema_address OR
       NOT size EQUAL schema_size OR NOT flags STREQUAL "00000000")
      message(FATAL_ERROR "Partition schema mismatch: ${label}")
    endif()
    string(JSON entries SET "${entries}" "${label}" "[${address},${size}]")
    math(EXPR offset "${offset}+64")
  endwhile()
  list(LENGTH names entry_count)
  if(NOT checksum OR NOT entry_count EQUAL 7)
    message(FATAL_ERROR "Incomplete partition schema or checksum")
  endif()
  string(JSON expected GET "${contract}" partitions)
  string(JSON count LENGTH "${expected}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${expected}" ${index})
    string(JSON want GET "${expected}" "${name}")
    string(JSON actual ERROR_VARIABLE error GET "${entries}" "${name}")
    if(error OR NOT actual STREQUAL want)
      message(FATAL_ERROR "Partition contract mismatch: ${name}")
    endif()
  endforeach()
  set(${output} "${entries}" PARENT_SCOPE)
endfunction()
