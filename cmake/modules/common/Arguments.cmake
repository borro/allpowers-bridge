include_guard(GLOBAL)

function(ap_require_arguments)
  cmake_parse_arguments(PARSE_ARGV 0 CHECK "" "PREFIX" "REQUIRED;ALLOW_EMPTY")
  if(NOT CHECK_PREFIX)
    message(FATAL_ERROR "Argument validation requires PREFIX")
  endif()
  if(DEFINED ${CHECK_PREFIX}_UNPARSED_ARGUMENTS)
    message(FATAL_ERROR "Unknown arguments: ${${CHECK_PREFIX}_UNPARSED_ARGUMENTS}")
  endif()
  foreach(name IN LISTS CHECK_REQUIRED)
    if(NOT DEFINED ${CHECK_PREFIX}_${name})
      message(FATAL_ERROR "Missing required argument: ${name}")
    endif()
    if(NOT name IN_LIST CHECK_ALLOW_EMPTY AND "${${CHECK_PREFIX}_${name}}" STREQUAL "")
      message(FATAL_ERROR "Empty required argument: ${name}")
    endif()
  endforeach()
endfunction()
