cmake_minimum_required(VERSION 3.25)
if(NOT TOOLCHAIN OR NOT KIT)
  message(FATAL_ERROR "Set TOOLCHAIN to esp-x32/2601 and KIT to the extracted relink directory")
endif()
find_program(compiler NAMES xtensa-esp32s3-elf-g++ xtensa-esp32s3-elf-g++.exe
  PATHS "${TOOLCHAIN}/bin" NO_DEFAULT_PATH REQUIRED)
file(READ "${KIT}/ld_flags" flags)
file(READ "${KIT}/ld_scripts" scripts)
separate_arguments(flags UNIX_COMMAND "${flags}")
separate_arguments(scripts UNIX_COMMAND "${scripts}")
file(STRINGS "${KIT}/LINK-LIBRARIES.txt" libraries)
file(STRINGS "${KIT}/TOOLCHAIN-LIBRARIES.txt" external_libraries)
set(link_inputs)
foreach(name IN LISTS libraries)
  set(path "lib/${name}")
  foreach(record IN LISTS external_libraries)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 external_name)
    if(name STREQUAL external_name)
      list(GET fields 1 relative)
      set(path "${TOOLCHAIN}/${relative}")
      if(NOT EXISTS "${path}")
        message(FATAL_ERROR "Install the matching esp-x32/2601 runtime: ${relative}")
      endif()
      break()
    endif()
  endforeach()
  list(APPEND link_inputs "${path}")
endforeach()
file(GLOB_RECURSE objects RELATIVE "${KIT}" "${KIT}/objects/*.o")
if(NOT objects OR NOT libraries)
  message(FATAL_ERROR "Empty firmware relinking kit")
endif()
execute_process(COMMAND "${compiler}" ${flags} -Lld ${scripts}
  -Wl,--wrap=esp_panic_handler -Wl,--wrap=esp_bt_mem_release -Wl,--wrap=esp_bt_controller_mem_release
  -Wl,--start-group ${objects} ${link_inputs} -Wl,--end-group -Wl,-EL -o relinked.elf
  WORKING_DIRECTORY "${KIT}" OUTPUT_FILE "${KIT}/relink.log" ERROR_FILE "${KIT}/relink.log"
  COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Firmware relinked without hardware access: ${KIT}/relinked.elf")
