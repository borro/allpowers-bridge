function(ap_json_quote output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(ap_source_hashes output root)
  set(result "{}")
  foreach(directory IN LISTS ARGN)
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${root}/${directory}/*")
    foreach(path IN LISTS files)
      if(path MATCHES "/(__pycache__|build|data)/")
        continue()
      endif()
      file(RELATIVE_PATH name "${root}" "${path}")
      file(SHA256 "${path}" digest)
      string(JSON result SET "${result}" "${name}" "\"${digest}\"")
    endforeach()
  endforeach()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
