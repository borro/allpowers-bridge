foreach(board waveshare-147 pocket-096)
  set(extracted "${scratch}/inspect-${board}")
  file(ARCHIVE_EXTRACT INPUT "${scratch}/output-valid/AllpowersFirmware-1.2.3-alpha.7_build.01-${board}.zip"
    DESTINATION "${extracted}")
  file(GLOB_RECURSE nested_archives "${extracted}/*.zip")
  if(nested_archives)
    message(FATAL_ERROR "Public firmware ZIP contains a nested archive")
  endif()
  if(NOT EXISTS "${extracted}/licenses/MIT.txt")
    message(FATAL_ERROR "Public firmware ZIP lost its license directory")
  endif()
  file(READ "${extracted}/manifest.json" public_manifest)
  string(JSON absent ERROR_VARIABLE error GET "${public_manifest}" files corresponding-source.zip)
  if(NOT error)
    message(FATAL_ERROR "Public firmware manifest refers to an omitted source archive")
  endif()
  file(READ "${extracted}/FIRMWARE-SOURCES.md" source_notice)
  foreach(required "fixture-commit" "v${version}" "git clone --branch" "cmake --build --preset firmware-linux"
      "arduino-esp32" "esp-idf" "SHA256")
    string(FIND "${source_notice}" "${required}" found)
    if(found LESS 0)
      message(FATAL_ERROR "Public firmware source instructions are incomplete: ${required}")
    endif()
  endforeach()
  string(JSON public_count LENGTH "${public_manifest}" files)
  math(EXPR public_last "${public_count}-1")
  foreach(index RANGE ${public_last})
    string(JSON name MEMBER "${public_manifest}" files ${index})
    string(JSON expected GET "${public_manifest}" files "${name}")
    file(SHA256 "${extracted}/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Public firmware manifest hash mismatch: ${name}")
    endif()
  endforeach()
  file(SHA256 "${extracted}/R2500Adapter.ino.bin" public_image_hash)
  file(SHA256 "${input}/firmware/${board}/R2500Adapter.ino.bin" original_image_hash)
  if(NOT public_image_hash STREQUAL original_image_hash)
    message(FATAL_ERROR "Firmware repackaging modified the application image")
  endif()
endforeach()
