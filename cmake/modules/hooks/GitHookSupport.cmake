cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Files.cmake")

function(ap_hook_git)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;ROOT" "ARGS")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT ROOT)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${AP_ROOT}" ${AP_ARGS}
    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  set(${AP_OUTPUT} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_snapshot)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;TREE;SOURCE;VERSION" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT TREE SOURCE VERSION)
  ap_assert_child_path(ROOT "${AP_ROOT}" PATH "${AP_SOURCE}")

  # Validate the tree inventory before extracting anything (including case collisions).
  ap_hook_git(OUTPUT entries ROOT "${AP_ROOT}" ARGS -c core.quotepath=false ls-tree -r "${AP_TREE}")
  if(entries MATCHES ";")
    message(FATAL_ERROR "Snapshot paths must not contain semicolons")
  endif()
  string(REPLACE "\n" ";" entries "${entries}")
  set(files)
  set(objects)
  set(names)
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^100(644|755) blob ([0-9a-f]+)\t([A-Za-z0-9_. /-]+)$")
      message(FATAL_ERROR "Snapshots require regular files with portable paths")
    endif()
    set(object "${CMAKE_MATCH_2}")
    set(name "${CMAKE_MATCH_3}")
    string(TOLOWER "${name}" lower)
    if(name MATCHES "(^|/)([.][.]?|[.]git|build|dist)(/|$)" OR
        IS_ABSOLUTE "${name}" OR name MATCHES "^(VERSION|SOURCE_FILES)$" OR lower IN_LIST names)
      message(FATAL_ERROR "Unsafe or duplicate snapshot path: ${name}")
    endif()
    list(APPEND files "${name}")
    list(APPEND objects "${object}")
    list(APPEND names "${lower}")
  endforeach()

  # Git attributes can alter an archive. Verify every extracted file against its blob.
  get_filename_component(parent "${AP_SOURCE}" DIRECTORY)
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(temporary "${parent}/snapshot-${nonce}")
  ap_assert_child_path(ROOT "${AP_ROOT}" PATH "${temporary}")
  file(MAKE_DIRECTORY "${temporary}/files")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${AP_ROOT}" archive --format=tar
    "--output=${temporary}/snapshot.tar" "${AP_TREE}" COMMAND_ERROR_IS_FATAL ANY)
  file(ARCHIVE_EXTRACT INPUT "${temporary}/snapshot.tar" DESTINATION "${temporary}/files")
  set(paths "")
  foreach(name IN LISTS files)
    string(APPEND paths "${temporary}/files/${name}\n")
  endforeach()
  file(WRITE "${temporary}/paths" "${paths}")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${AP_ROOT}" hash-object --no-filters --stdin-paths
    INPUT_FILE "${temporary}/paths" OUTPUT_VARIABLE hashes OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE code ERROR_VARIABLE error)
  string(REPLACE "\n" ";" hashes "${hashes}")
  if(NOT code EQUAL 0 OR NOT hashes STREQUAL objects)
    file(REMOVE_RECURSE "${temporary}")
    message(FATAL_ERROR "Snapshot differs from Git blobs; check archive attributes. ${error}")
  endif()

  # Publish only verified bytes; keep unchanged timestamps and remove staged deletions.
  file(MAKE_DIRECTORY "${AP_SOURCE}")
  if(EXISTS "${AP_SOURCE}/SOURCE_FILES")
    file(STRINGS "${AP_SOURCE}/SOURCE_FILES" previous)
    foreach(old IN LISTS previous)
      if(NOT old IN_LIST files)
        ap_assert_child_path(ROOT "${AP_SOURCE}" PATH "${AP_SOURCE}/${old}")
        file(REMOVE "${AP_SOURCE}/${old}")
      endif()
    endforeach()
  endif()
  foreach(name IN LISTS files)
    ap_assert_child_path(ROOT "${AP_SOURCE}" PATH "${AP_SOURCE}/${name}")
    get_filename_component(directory "${AP_SOURCE}/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${temporary}/files/${name}" "${AP_SOURCE}/${name}" ONLY_IF_DIFFERENT)
  endforeach()
  list(JOIN files "\n" inventory)
  file(CONFIGURE OUTPUT "${AP_SOURCE}/SOURCE_FILES" CONTENT "${inventory}\n" @ONLY)
  file(CONFIGURE OUTPUT "${AP_SOURCE}/VERSION" CONTENT "${AP_VERSION}\n" @ONLY)
  file(REMOVE_RECURSE "${temporary}")
endfunction()

function(ap_hook_push_commits)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;ROOT;INPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT ROOT INPUT)
  file(STRINGS "${AP_INPUT}" lines)
  set(commits)
  foreach(line IN LISTS lines)
    if(NOT line)
      continue()
    endif()
    if(NOT line MATCHES "^[^ ]+ ([0-9a-f]+) [^ ]+ ([0-9a-f]+)$")
      message(FATAL_ERROR "Invalid Git pre-push input")
    endif()
    set(local "${CMAKE_MATCH_1}")
    set(remote "${CMAKE_MATCH_2}")
    foreach(hash IN ITEMS "${local}" "${remote}")
      string(LENGTH "${hash}" length)
      if(NOT length EQUAL 40 AND NOT length EQUAL 64)
        message(FATAL_ERROR "Invalid Git object ID")
      endif()
    endforeach()
    if(local MATCHES "^0+$")
      continue()
    endif()
    ap_hook_git(OUTPUT commit ROOT "${AP_ROOT}" ARGS rev-parse --verify "${local}^{commit}")
    list(APPEND commits "${commit}")
  endforeach()
  list(REMOVE_DUPLICATES commits)
  set(${AP_OUTPUT} "${commits}" PARENT_SCOPE)
endfunction()

function(ap_hook_ctest)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "BINARY;LOGS" "")
  ap_require_arguments(PREFIX AP REQUIRED BINARY LOGS)
  file(MAKE_DIRECTORY "${AP_LOGS}")
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${AP_BINARY}"
    --parallel 10 --output-on-failure --no-tests=error
    --output-junit "${AP_LOGS}/tests.xml" --output-log "${AP_LOGS}/ctest.log"
    RESULT_VARIABLE code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Hook checks failed (${code}); see ${AP_LOGS}")
  endif()
endfunction()
