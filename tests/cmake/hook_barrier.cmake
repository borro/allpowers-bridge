cmake_minimum_required(VERSION 4.4)
file(WRITE "${WORK}/${NAME}" ready)
set(attempt 0)
while(NOT EXISTS "${WORK}/${OTHER}")
  if(attempt GREATER 100)
    message(FATAL_ERROR "The second check was not started in parallel")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 0.1)
  math(EXPR attempt "${attempt} + 1")
endwhile()
if(FAIL)
  message(FATAL_ERROR "Deliberate hook control failure")
endif()
