include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")
# Keep versions in Dependencies.cmake, but invalidate only the affected consumer.
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
function(ap_dependency_fingerprint)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "GROUP;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED GROUP OUTPUT)
  get_filename_component(root "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../.." ABSOLUTE)
  if(AP_GROUP STREQUAL qt)
    set(pattern "^ALLPOWERS_(QT|QTBASE|QTCONNECTIVITY|QTTOOLS|CXX_STANDARD|MSVC|WINDOWS_SDK|CMAKE_VERSION|NINJA)")
    set(recipes cmake/modules/sdk/QtStatic.cmake cmake/modules/project/WindowsCompiler.cmake cmake/modules/project/SizeOptimization.cmake cmake/scripts/sdk/QtSourceIdentity.cmake)
  elseif(AP_GROUP STREQUAL qt-sources)
    set(pattern "^ALLPOWERS_(QT|QTBASE|QTCONNECTIVITY|QTTOOLS)")
    set(recipes cmake/scripts/sdk/PrepareQtSources.cmake)
  elseif(AP_GROUP STREQUAL arduino)
    set(pattern "^ALLPOWERS_(ARDUINO|ESP32|FQBN|CXX_STANDARD)")
    set(recipes cmake/scripts/sdk/SetupArduino.cmake)
  elseif(AP_GROUP STREQUAL firmware-legal)
    set(pattern "^ALLPOWERS_(ARDUINO|ESP32|FIRMWARE_|FQBN|CXX_STANDARD)")
    set(recipes cmake/scripts/release/PrepareFirmwareKit.cmake cmake/scripts/release/RelinkFirmware.cmake cmake/modules/release/CollectFirmwareNotices.cmake tools/release/firmware_notices.py)
  elseif(AP_GROUP STREQUAL wdk)
    set(pattern "^ALLPOWERS_(WDK|KMDF)")
    set(recipes cmake/scripts/sdk/SetupWdk.cmake cmake/modules/sdk/Wdk.cmake)
  else()
    message(FATAL_ERROR "Unknown dependency group: ${AP_GROUP}")
  endif()
  list(APPEND recipes cmake/modules/common/Arguments.cmake)
  if(AP_GROUP STREQUAL qt)
    list(APPEND recipes cmake/scripts/sdk/QtCompiler.cmake cmake/scripts/sdk/ExtractQtSource.cmake
      cmake/modules/common/Download.cmake cmake/modules/common/Files.cmake)
  else()
    list(APPEND recipes cmake/modules/common/Download.cmake)
  endif()
  if(AP_GROUP STREQUAL firmware-legal)
    list(APPEND recipes cmake/modules/common/Json.cmake cmake/modules/common/Files.cmake
      cmake/modules/common/PublicSources.cmake)
  endif()
  file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../Dependencies.cmake" declarations REGEX "^set\\(ALLPOWERS_")
  set(variables)
  foreach(declaration IN LISTS declarations)
    string(REGEX MATCH "ALLPOWERS_[A-Z0-9_]+" variable "${declaration}")
    list(APPEND variables "${variable}")
  endforeach()
  list(SORT variables)
  set(identity "dependency-cache-v2\n")
  foreach(variable IN LISTS variables)
    # Only pinned dependency inputs, never user/cache variables with similar names.
    if(variable MATCHES "${pattern}" AND NOT variable MATCHES "(_ROOT|_JOBS|_SOURCE_CACHE|_DATA_DIR|_PARALLEL_BOARDS)$")
      string(APPEND identity "${variable}=${${variable}}\n")
    endif()
  endforeach()
  foreach(recipe IN LISTS recipes)
    file(SHA256 "${root}/${recipe}" hash)
    string(APPEND identity "${recipe}=${hash}\n")
  endforeach()
  string(SHA256 digest "${identity}")
  set(${AP_OUTPUT} "${digest}" PARENT_SCOPE)
endfunction()
