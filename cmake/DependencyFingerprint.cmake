# Keep versions in Dependencies.cmake, but invalidate only the affected consumer.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
function(ap_dependency_fingerprint group output)
  if(group STREQUAL qt)
    set(pattern "^ALLPOWERS_(QT|QTBASE|QTCONNECTIVITY|QTTOOLS|CXX_STANDARD|MSVC|WINDOWS_SDK|CMAKE_VERSION|NINJA)")
    set(recipes QtStatic.cmake WindowsCompiler.cmake SizeOptimization.cmake QtSourceIdentity.cmake)
  elseif(group STREQUAL qt-sources)
    set(pattern "^ALLPOWERS_(QT|QTBASE|QTCONNECTIVITY|QTTOOLS)")
    set(recipes PrepareQtSources.cmake)
  elseif(group STREQUAL arduino)
    set(pattern "^ALLPOWERS_(ARDUINO|ESP32|FQBN|CXX_STANDARD)")
    set(recipes SetupArduino.cmake)
  elseif(group STREQUAL firmware-legal)
    set(pattern "^ALLPOWERS_(ARDUINO|ESP32|FIRMWARE_|FQBN|CXX_STANDARD)")
    set(recipes PrepareFirmwareKit.cmake RelinkFirmware.cmake CollectFirmwareNotices.cmake firmware_notices.py)
  elseif(group STREQUAL wdk)
    set(pattern "^ALLPOWERS_(WDK|KMDF)")
    set(recipes SetupWdk.cmake)
  else()
    message(FATAL_ERROR "Unknown dependency group: ${group}")
  endif()
  file(STRINGS "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/Dependencies.cmake" declarations REGEX "^set\\(ALLPOWERS_")
  set(variables)
  foreach(declaration IN LISTS declarations)
    string(REGEX MATCH "ALLPOWERS_[A-Z0-9_]+" variable "${declaration}")
    list(APPEND variables "${variable}")
  endforeach()
  list(SORT variables)
  set(identity "dependency-cache-v2\n")
  foreach(variable IN LISTS variables)
    # Only pinned dependency inputs, never user/cache variables with similar names.
    if(variable MATCHES "${pattern}" AND NOT variable MATCHES "(_ROOT|_JOBS|_SOURCE_CACHE|_DATA_DIR|_PARALLEL_BOARDS)$")
      string(APPEND identity "${variable}=${${variable}}\n")
    endif()
  endforeach()
  foreach(recipe IN LISTS recipes)
    file(SHA256 "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/${recipe}" hash)
    string(APPEND identity "${recipe}=${hash}\n")
  endforeach()
  string(SHA256 digest "${identity}")
  set(${output} "${digest}" PARENT_SCOPE)
endfunction()

if(CMAKE_SCRIPT_MODE_FILE STREQUAL CMAKE_CURRENT_LIST_FILE)
  if(GROUP)
    ap_dependency_fingerprint("${GROUP}" digest)
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${digest}")
  else()
    foreach(group qt-sources arduino firmware-legal wdk)
      ap_dependency_fingerprint("${group}" digest)
      if(DEFINED ENV{GITHUB_OUTPUT})
        file(APPEND "$ENV{GITHUB_OUTPUT}" "${group}=${digest}\n")
      endif()
      message(STATUS "${group}: ${digest}")
    endforeach()
  endif()
endif()
