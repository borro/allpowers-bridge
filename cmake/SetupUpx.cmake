cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
if(NOT CMAKE_HOST_WIN32 OR NOT DEPS_DIR OR NOT WORK)
  message(FATAL_ERROR "UPX setup requires Windows, DEPS_DIR and a dedicated WORK directory")
endif()
set(name "upx-${ALLPOWERS_UPX_VERSION}-win64")
set(archive "${DEPS_DIR}/downloads/${name}.zip")
file(MAKE_DIRECTORY "${DEPS_DIR}/downloads" "${WORK}")
if(NOT EXISTS "${archive}")
  file(DOWNLOAD "https://github.com/upx/upx/releases/download/v${ALLPOWERS_UPX_VERSION}/${name}.zip"
    "${archive}" EXPECTED_HASH "SHA256=${ALLPOWERS_UPX_WINDOWS_SHA256}" TLS_VERIFY ON
    TIMEOUT 180 INACTIVITY_TIMEOUT 30)
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL ALLPOWERS_UPX_WINDOWS_SHA256)
  message(FATAL_ERROR "UPX archive checksum mismatch")
endif()
# Restore the official unmodified executable from the verified archive on every use.
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK}")
set(UPX_EXECUTABLE "${WORK}/${name}/upx.exe")
execute_process(COMMAND "${UPX_EXECUTABLE}" --version OUTPUT_VARIABLE version
  COMMAND_ERROR_IS_FATAL ANY)
string(REPLACE "." "\\." expected "${ALLPOWERS_UPX_VERSION}")
if(NOT version MATCHES "^upx ${expected}(\r?\n|$)")
  message(FATAL_ERROR "Unexpected UPX version: ${version}")
endif()
message(STATUS "Verified UPX ${ALLPOWERS_UPX_VERSION}")
