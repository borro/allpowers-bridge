include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")

function(ap_release_version)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "TAG;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED TAG OUTPUT)
  if(NOT AP_TAG MATCHES "^v(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$")
    message(FATAL_ERROR "Release tags must be vMAJOR.MINOR.PATCH with optional SemVer suffixes")
  endif()
  foreach(part RANGE 1 3)
    string(LENGTH "${CMAKE_MATCH_${part}}" digits)
    if(digits GREATER 5 OR CMAKE_MATCH_${part} GREATER 65535)
      message(FATAL_ERROR "Release version components must fit Windows VERSIONINFO (0..65535)")
    endif()
  endforeach()
  string(SUBSTRING "${AP_TAG}" 1 -1 version)
  string(REGEX REPLACE "^[0-9]+\\.[0-9]+\\.[0-9]+" "" suffix "${version}")
  if(suffix MATCHES "\\.\\.|\\.($|\\+)|^-\\.|\\+\\.")
    message(FATAL_ERROR "Empty SemVer identifier in release tag")
  endif()
  if(suffix MATCHES "^-([^+]+)")
    string(REPLACE "." ";" identifiers "${CMAKE_MATCH_1}")
    foreach(identifier IN LISTS identifiers)
      if(identifier MATCHES "^0[0-9]+$")
        message(FATAL_ERROR "Numeric prerelease identifiers cannot have leading zeroes")
      endif()
    endforeach()
  endif()
  set(${AP_OUTPUT} "${version}" PARENT_SCOPE)
endfunction()

function(ap_check_release_tag)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;TAG;OUTPUT;COMMIT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT TAG OUTPUT)
  ap_release_version(TAG "${AP_TAG}" OUTPUT version)
  find_package(Git REQUIRED)
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --show-toplevel
    WORKING_DIRECTORY "${AP_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE checkout
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  file(REAL_PATH "${AP_ROOT}" canonical_root)
  file(REAL_PATH "${checkout}" canonical_checkout)
  if(CMAKE_HOST_WIN32)
    string(TOLOWER "${canonical_root}" canonical_root)
    string(TOLOWER "${canonical_checkout}" canonical_checkout)
  endif()
  if(NOT result EQUAL 0 OR NOT canonical_root STREQUAL canonical_checkout)
    message(FATAL_ERROR "Release builds require the root of an actual Git checkout")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --verify "refs/tags/${AP_TAG}^{commit}"
    WORKING_DIRECTORY "${AP_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE tagged
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Release tag does not exist in this checkout: ${AP_TAG}")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${AP_ROOT}"
    OUTPUT_VARIABLE head OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  if(NOT tagged STREQUAL head)
    message(FATAL_ERROR "Release tag does not identify checked-out HEAD")
  endif()
  if(AP_COMMIT)
    if(NOT AP_COMMIT MATCHES "^[0-9a-fA-F]+$")
      message(FATAL_ERROR "Expected release commit must be a Git object ID")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse --verify "${AP_COMMIT}^{commit}"
      WORKING_DIRECTORY "${AP_ROOT}" RESULT_VARIABLE result OUTPUT_VARIABLE expected
      OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(NOT result EQUAL 0 OR NOT head STREQUAL expected)
      message(FATAL_ERROR "Checkout does not identify the commit that triggered this release build")
    endif()
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" status --porcelain --untracked-files=normal
    WORKING_DIRECTORY "${AP_ROOT}" OUTPUT_VARIABLE changes COMMAND_ERROR_IS_FATAL ANY)
  if(changes)
    message(FATAL_ERROR "Release builds require a clean checkout")
  endif()
  set(${AP_OUTPUT} "${version}" PARENT_SCOPE)
endfunction()
