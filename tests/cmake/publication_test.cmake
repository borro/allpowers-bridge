cmake_minimum_required(VERSION 4.4)
find_package(Git REQUIRED)
include("${ROOT}/cmake/modules/common/PublicSources.cmake")
# Regression: the broad firmware *.hex ignore rule must not drop retained seeds.
ap_public_sources(OUTPUT project_files ROOT "${ROOT}")
file(GLOB corpus_inputs RELATIVE "${ROOT}" "${ROOT}/tests/fuzz/corpus/*/*.hex")
if(NOT corpus_inputs)
  message(FATAL_ERROR "Retained fuzz corpus is absent")
endif()
foreach(seed IN LISTS corpus_inputs)
  if(NOT seed IN_LIST project_files)
    message(FATAL_ERROR "Retained fuzz input excluded from source package: ${seed}")
  endif()
endforeach()
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside_build)
if(NOT inside_build OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Publication tests require a dedicated build subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
file(MAKE_DIRECTORY "${scratch}/repo")
set(repo "${scratch}/repo")
function(git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${repo}"
    OUTPUT_QUIET ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(audit mode expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DMODE=${mode}"
    -P "${ROOT}/cmake/scripts/quality/Audit.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL pass AND NOT result EQUAL 0)
    message(FATAL_ERROR "Expected ${mode} audit to pass: ${output}${error}")
  elseif(expected STREQUAL fail AND result EQUAL 0)
    message(FATAL_ERROR "${mode} audit incorrectly accepted private/unreviewed data")
  endif()
  if(ARGC GREATER 2 AND NOT "${output}${error}" MATCHES "${ARGV2}")
    message(FATAL_ERROR "Unexpected ${mode} audit diagnostic: ${output}${error}")
  endif()
  file(GLOB leftovers "${repo}/build/audit/index-*")
  if(leftovers)
    message(FATAL_ERROR "Index audit retained a copy of staged contents")
  endif()
endfunction()
git(init -q)
git(config user.name "Publication Test")
git(config user.email "test@example.invalid")
git(config commit.gpgsign false)
git(config core.autocrlf false)
file(WRITE "${repo}/README.md" "Synthetic publication test\n")
file(WRITE "${repo}/.gitignore" "build/\n.env\n.local/\n")
git(add README.md .gitignore)
git(commit -qm "Synthetic baseline")
audit(index pass)
audit(worktree pass)
file(WRITE "${repo}/build/foreign.bin" "Never package this ignored output")
file(WRITE "${repo}/.env" "Private local settings")
ap_public_sources(OUTPUT files ROOT "${repo}")
list(LENGTH files count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Ignored files entered the public source inventory")
endif()
# Only reviewed, hash-named text corpora in the three known targets are public.
string(SHA256 corpus_hash "synthetic")
set(corpus_name "tests/fuzz/corpus/ble/${corpus_hash}.hex")
file(WRITE "${repo}/${corpus_name}" "73796e746865746963\n")
audit(worktree pass)
ap_public_sources(OUTPUT files ROOT "${repo}")
if(NOT corpus_name IN_LIST files)
  message(FATAL_ERROR "Retained fuzz corpus missing from source inventory")
endif()
foreach(unreviewed
    "tests/fuzz/corpus/ble/short.hex"
    "tests/fuzz/corpus/unknown/${corpus_hash}.hex"
    "tests/fuzz/corpus/ble/${corpus_hash}.bin")
  file(WRITE "${repo}/${unreviewed}" "00\n")
  audit(worktree fail)
  file(REMOVE "${repo}/${unreviewed}")
endforeach()
file(REMOVE "${repo}/${corpus_name}")
# A pending deletion belongs to the worktree inventory, while index auditing
# still reads the staged blob. Source archives must never copy a missing file.
file(REMOVE "${repo}/README.md")
ap_public_sources(OUTPUT files ROOT "${repo}")
if("README.md" IN_LIST files)
  message(FATAL_ERROR "Deleted worktree file entered the source archive")
endif()
audit(index pass)
file(WRITE "${repo}/README.md" "Synthetic publication test\n")
# Batch boundaries must survive CRLF, UTF-8, empty blobs and
# content resembling a Git batch header. Approved image blobs remain excluded.
file(WRITE "${repo}/README.md" "Пример UTF-8\r\n-----BEGIN RSA ")
file(WRITE "${repo}/docs/framing.md" "PRIVATE KEY-----\n0123456789abcdef blob 12\n")
file(WRITE "${repo}/docs/empty.md" "")
file(MAKE_DIRECTORY "${repo}/apps/windows/assets")
file(COPY_FILE "${ROOT}/apps/windows/assets/logo.png" "${repo}/apps/windows/assets/logo.png")
git(add README.md docs apps)
audit(index pass)
audit(worktree pass)
string(CONCAT binary_key "-----BEGIN RSA " "PRIVATE KEY-----")
file(COPY_FILE "${ROOT}/apps/windows/assets/logo.png" "${repo}/README.md")
file(APPEND "${repo}/README.md" "${binary_key}\n")
git(add README.md)
audit(index fail "Possible credential")
file(WRITE "${repo}/README.md" "Synthetic publication test\n")
git(add README.md)
audit(index pass)
file(WRITE "${repo}/.local/devices.json" "{\"fixture\":{\"serial\":\"synthetic-private-serial\"}}\n")
file(WRITE "${repo}/README.md" "SYNTHETIC-PRIVATE-SERIAL\n")
audit(index pass)
audit(worktree fail "Private hardware identity")
git(add README.md)
audit(index fail "Private hardware identity")
file(WRITE "${repo}/README.md" "Synthetic publication test\n")
git(add README.md)
audit(index pass)
file(WRITE "${repo}/config/devices.json" "{}")
audit(worktree fail)
file(REMOVE "${repo}/config/devices.json")
string(CONCAT fake_key "-----BEGIN RSA " "PRIVATE KEY-----")
file(WRITE "${repo}/README.md" "${fake_key}\n")
audit(index pass)
audit(worktree fail)
git(add README.md)
audit(index fail)
git(commit -qm "Synthetic credential fixture")
file(WRITE "${repo}/README.md" "Clean again\n")
git(add README.md)
git(commit -qm "Remove fixture")
audit(index pass)
audit(history fail)
git(add -f build/foreign.bin)
audit(index fail)
git(reset -q HEAD -- build/foreign.bin)
git(update-index --cacheinfo "100644,1111111111111111111111111111111111111111,README.md")
audit(index fail "staged blob")
message(STATUS "Publication guards reject unreviewed files, staged secrets and deleted historical secrets")
