cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Arguments.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/ReleaseVersion.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/HistoryCompatibility.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/FirmwareSourceNotice.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/CollectFirmwareNotices.cmake")
ap_release_version(TAG "${TAG}" OUTPUT version)
# GitHub may rename special characters in asset names. Preserve the complete
# version inside the EXEs/manifests, and encode '+' only in uploaded filenames.
string(REPLACE "+" "_" asset_version "${version}")
if(NOT CMAKE_HOST_WIN32)
  message(FATAL_ERROR "Release preparation must inspect VERSIONINFO on Windows")
endif()
if(NOT INPUT OR NOT OUTPUT OR NOT COMMIT)
  message(FATAL_ERROR "Set INPUT, OUTPUT and COMMIT for release packaging and exact source references")
endif()
file(GLOB existing "${OUTPUT}/*" "${OUTPUT}/.*")
if(existing)
  message(FATAL_ERROR "Release staging directory must be empty")
endif()
file(MAKE_DIRECTORY "${OUTPUT}/.stage")
find_program(powershell NAMES pwsh powershell REQUIRED)
function(ap_copy_release_archive)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ARCHIVE;DIRECTORY;INPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED ARCHIVE DIRECTORY INPUT)
  set(INPUT "${AP_INPUT}")
  set(archive "${AP_ARCHIVE}")
  set(directory "${AP_DIRECTORY}")
  file(READ "${INPUT}/${archive}.sha256" record)
  string(SUBSTRING "${record}" 0 64 expected)
  file(SHA256 "${INPUT}/${archive}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Release archive checksum mismatch: ${archive}")
  endif()
  string(REPLACE "+" "_" destination "${archive}")
  file(COPY_FILE "${INPUT}/${archive}" "${directory}/${destination}")
endfunction()
set(runtime "AllpowersMonitor-${version}-win-x64.zip")
set(sources "AllpowersMonitor-${version}-sources-with-qt.zip")
# The runtime ZIP is a checked CI transport, not an additional public download.
ap_copy_release_archive(INPUT "${INPUT}" ARCHIVE "${runtime}" DIRECTORY "${OUTPUT}/.stage")
ap_copy_release_archive(INPUT "${INPUT}" ARCHIVE "${sources}" DIRECTORY "${OUTPUT}")
file(ARCHIVE_EXTRACT INPUT "${INPUT}/${sources}" DESTINATION "${OUTPUT}/.stage/sources"
  PATTERNS "allpowers/VERSION")
file(READ "${OUTPUT}/.stage/sources/allpowers/VERSION" source_version)
string(STRIP "${source_version}" source_version)
if(NOT source_version STREQUAL version)
  message(FATAL_ERROR "Corresponding source version does not match release tag")
endif()
file(READ "${CMAKE_CURRENT_LIST_DIR}/../../../tests/fixtures/usb-contract.json" contract)
string(JSON descriptor GET "${contract}" descriptor_sha256)
# Reject invalid firmware before starting the EXE inspection processes. Keep
# publication of firmware archives after all runtime version checks pass.
foreach(board waveshare-147 pocket-096)
  set(folder "${INPUT}/firmware/${board}")
  file(READ "${folder}/manifest.json" manifest)
  string(JSON model GET "${manifest}" board)
  string(JSON firmware_version GET "${manifest}" project_version)
  string(JSON maintenance GET "${manifest}" maintenance)
  string(JSON efuses GET "${manifest}" efuse_writes)
  string(JSON firmware_descriptor GET "${manifest}" descriptor_sha256)
  if(COMMIT)
    string(JSON firmware_commit GET "${manifest}" build_commit)
    if(NOT firmware_commit STREQUAL COMMIT)
      message(FATAL_ERROR "Firmware commit does not match this release: ${board}")
    endif()
  endif()
  if(EXPECTED_FIRMWARE_HOST)
    string(JSON firmware_host GET "${manifest}" host_platform)
    if(NOT firmware_host STREQUAL EXPECTED_FIRMWARE_HOST)
      message(FATAL_ERROR "Unexpected firmware build host: ${board}")
    endif()
  endif()
  if(NOT model STREQUAL board OR NOT firmware_version STREQUAL version OR efuses OR
      NOT maintenance STREQUAL "BOOT-R2500!!" OR NOT firmware_descriptor STREQUAL descriptor)
    message(FATAL_ERROR "Wrong firmware profile, version or maintenance contract: ${board}")
  endif()
  foreach(part app0 app1 nvs history coredump)
    string(JSON expected GET "${contract}" partitions "${part}")
    string(JSON actual GET "${manifest}" partitions "${part}")
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Wrong firmware partition: ${board}/${part}")
    endif()
  endforeach()
  set(files manifest.json)
  set(public_files "{}")
  string(JSON count LENGTH "${manifest}" files)
  if(count LESS 1)
    message(FATAL_ERROR "Empty firmware manifest")
  endif()
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${manifest}" files ${index})
    if(NOT name MATCHES "^(licenses/)?[A-Za-z0-9][A-Za-z0-9_.-]*$" OR name STREQUAL "manifest.json")
      message(FATAL_ERROR "Unexpected firmware filename")
    endif()
    # The large source/object kit remains a checked build byproduct. Public
    # installation packages refer to the exact GitHub source and pinned origins.
    if(name STREQUAL "corresponding-source.zip")
      continue()
    endif()
    if(name MATCHES "\\.zip$")
      message(FATAL_ERROR "Nested archives are not allowed in firmware packages")
    endif()
    if(name MATCHES "^licenses/" AND NOT name MATCHES "\\.(md|txt|json)$")
      message(FATAL_ERROR "Unexpected file type in firmware licenses: ${name}")
    endif()
    string(JSON expected GET "${manifest}" files "${name}")
    file(REAL_PATH "${folder}" firmware_root)
    file(REAL_PATH "${folder}/${name}" resolved)
    cmake_path(IS_PREFIX firmware_root "${resolved}" NORMALIZE inside_firmware)
    if(NOT inside_firmware)
      message(FATAL_ERROR "Firmware file escapes its package: ${name}")
    endif()
    file(SHA256 "${folder}/${name}" actual)
    if(NOT actual STREQUAL expected)
      message(FATAL_ERROR "Firmware checksum mismatch: ${board}/${name}")
    endif()
    list(APPEND files "${name}")
    string(JSON public_files SET "${public_files}" "${name}" "\"${actual}\"")
  endforeach()
  foreach(required R2500Adapter.ino.bin R2500Adapter.ino.bootloader.bin
      R2500Adapter.ino.partitions.bin boot_app0.bin FIRMWARE-LICENSES.md
      licenses/README.md licenses/NOTICES.md licenses/components.json)
    if(NOT required IN_LIST files)
      message(FATAL_ERROR "Incomplete firmware package: ${board}/${required}")
    endif()
  endforeach()
  ap_validate_firmware_notices(FOLDER "${folder}" FILES "${files}")
  ap_history_validate(MANIFEST "${manifest}" BINARY "${folder}/R2500Adapter.ino.bin")
  set(validated_${board}_files "${files}")
  set(validated_${board}_manifest "${manifest}")
  set(validated_${board}_public_files "${public_files}")
endforeach()
file(ARCHIVE_EXTRACT INPUT "${OUTPUT}/.stage/AllpowersMonitor-${asset_version}-win-x64.zip"
  DESTINATION "${OUTPUT}/.stage/runtime")
foreach(app AllpowersMonitor AllpowersWidget)
  set(exe "${OUTPUT}/.stage/runtime/AllpowersMonitor-${version}-win-x64/${app}.exe")
  execute_process(COMMAND "${powershell}" -NoProfile -File "${CMAKE_CURRENT_LIST_DIR}/../../../tools/windows/CheckExeVersion.ps1"
    -Path "${exe}" -ExpectedVersion "${version}" COMMAND_ERROR_IS_FATAL ANY)
  file(COPY_FILE "${exe}" "${OUTPUT}/${app}-${asset_version}-win-x64.exe")
endforeach()
foreach(board waveshare-147 pocket-096)
  set(folder "${INPUT}/firmware/${board}")
  set(files "${validated_${board}_files}")
  set(manifest "${validated_${board}_manifest}")
  set(public_files "${validated_${board}_public_files}")
  set(public_folder "${OUTPUT}/.stage/firmware-${board}")
  file(MAKE_DIRECTORY "${public_folder}")
  foreach(name IN LISTS files)
    if(NOT name STREQUAL "manifest.json")
      get_filename_component(parent "${public_folder}/${name}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(COPY_FILE "${folder}/${name}" "${public_folder}/${name}")
    endif()
  endforeach()
  ap_firmware_source_notice(OUTPUT "${public_folder}/FIRMWARE-SOURCES.md" TAG "${TAG}" COMMIT "${COMMIT}")
  file(SHA256 "${public_folder}/FIRMWARE-SOURCES.md" notice_hash)
  string(JSON public_files SET "${public_files}" FIRMWARE-SOURCES.md "\"${notice_hash}\"")
  string(JSON manifest SET "${manifest}" files "${public_files}")
  file(WRITE "${public_folder}/manifest.json" "${manifest}\n")
  list(APPEND files FIRMWARE-SOURCES.md)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf
    "${OUTPUT}/AllpowersFirmware-${asset_version}-${board}.zip" --format=zip -- ${files}
    WORKING_DIRECTORY "${public_folder}" COMMAND_ERROR_IS_FATAL ANY)
endforeach()
file(GLOB assets RELATIVE "${OUTPUT}" "${OUTPUT}/*.zip" "${OUTPUT}/*.exe")
list(SORT assets)
set(checksums "")
foreach(name IN LISTS assets)
  file(SHA256 "${OUTPUT}/${name}" hash)
  string(APPEND checksums "${hash}  ${name}\n")
endforeach()
file(WRITE "${OUTPUT}/SHA256SUMS" "${checksums}")
message(STATUS "Prepared complete release assets for ${TAG}")
