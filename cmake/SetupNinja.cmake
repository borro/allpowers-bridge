cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
if(NOT DESTINATION)
  message(FATAL_ERROR "Set DESTINATION to a dedicated Ninja installation directory")
endif()
get_filename_component(destination "${DESTINATION}" ABSOLUTE)
if(CMAKE_HOST_WIN32)
  set(archive_name ninja-win.zip)
  set(expected "${ALLPOWERS_NINJA_WINDOWS_SHA256}")
  set(executable ninja.exe)
elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  set(archive_name ninja-linux.zip)
  set(expected "${ALLPOWERS_NINJA_LINUX_SHA256}")
  set(executable ninja)
else()
  message(FATAL_ERROR "Ninja bootstrap supports Windows and Linux x64 CI hosts")
endif()
file(MAKE_DIRECTORY "${destination}")
set(archive "${destination}/${ALLPOWERS_NINJA_VERSION}-${archive_name}")
set(actual "")
if(EXISTS "${archive}")
  file(SHA256 "${archive}" actual)
endif()
if(NOT actual STREQUAL expected)
  file(DOWNLOAD
    "https://github.com/ninja-build/ninja/releases/download/v${ALLPOWERS_NINJA_VERSION}/${archive_name}"
    "${archive}" EXPECTED_HASH "SHA256=${expected}" TLS_VERIFY ON
    TIMEOUT 180 INACTIVITY_TIMEOUT 30)
endif()
# Always extract the verified archive, even when an executable already exists.
file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
if(NOT CMAKE_HOST_WIN32)
  file(CHMOD "${destination}/${executable}" PERMISSIONS
    OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
execute_process(COMMAND "${destination}/${executable}" --version
  OUTPUT_VARIABLE version OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
if(NOT version STREQUAL ALLPOWERS_NINJA_VERSION)
  message(FATAL_ERROR "Expected Ninja ${ALLPOWERS_NINJA_VERSION}, found ${version}")
endif()
if(NOT "$ENV{GITHUB_PATH}" STREQUAL "")
  file(APPEND "$ENV{GITHUB_PATH}" "${destination}\n")
endif()
message(STATUS "Verified Ninja ${version}: ${destination}/${executable}")
