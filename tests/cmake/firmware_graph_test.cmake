cmake_minimum_required(VERSION 4.4)
find_package(Git REQUIRED)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside)
if(NOT inside OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Firmware graph test requires a dedicated binary subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
set(source "${scratch}/source")
file(MAKE_DIRECTORY "${source}")
foreach(name cmake core firmware tests docs)
  file(COPY "${ROOT}/${name}" DESTINATION "${source}")
endforeach()
file(COPY "${ROOT}/CMakeLists.txt" "${ROOT}/LICENSE" "${ROOT}/THIRD_PARTY_NOTICES.md" DESTINATION "${source}")
file(WRITE "${source}/.gitignore" "build/\n")
file(WRITE "${source}/VERSION" "1.2.3\n")
# Use the actual graph, staging, partition validation and manifest generation.
# Only the external compiler and legal-source packaging boundaries are fixtures.
file(WRITE "${source}/cmake/PrepareFirmwareKit.cmake" [=[
foreach(name corresponding-source.zip licenses.zip FIRMWARE-LICENSES.md)
  file(WRITE "${OUTPUT}/${name}" "offline legal-packaging fixture\n")
endforeach()
]=])
file(MAKE_DIRECTORY "${scratch}/cli-source")
file(CONFIGURE OUTPUT "${scratch}/cli-source/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(OfflineArduinoBoundary LANGUAGES CXX)
include("@ROOT@/cmake/WindowsCompiler.cmake")
add_executable(partitions "@ROOT@/tests/cmake/partition_fixture.cpp")
target_compile_features(partitions PRIVATE cxx_std_23)
add_executable(arduino-cli "@ROOT@/tests/cmake/firmware_graph_cli.cpp")
target_compile_features(arduino-cli PRIVATE cxx_std_23)
target_compile_definitions(arduino-cli PRIVATE PARTITION_FIXTURE="@scratch@/partitions/valid.bin")
]=] @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scratch}/cli-source" -B "${scratch}/cli-build" -G Ninja
  -DCMAKE_BUILD_TYPE=Release -DCMAKE_TRY_COMPILE_CONFIGURATION=Release "-DCMAKE_CXX_COMPILER=${CXX}"
  OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${scratch}/cli-build" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
set(suffix "")
if(CMAKE_HOST_WIN32)
  set(suffix .exe)
endif()
execute_process(COMMAND "${scratch}/cli-build/partitions${suffix}" "${scratch}/partitions" COMMAND_ERROR_IS_FATAL ANY)
include("${ROOT}/cmake/Dependencies.cmake")
set(sdk "${scratch}/data/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
file(MAKE_DIRECTORY "${sdk}/tools/partitions")
file(WRITE "${sdk}/tools/partitions/boot_app0.bin" "offline boot fixture")
file(WRITE "${sdk}/LICENSE.md" "offline license fixture")
function(git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${source}"
    OUTPUT_QUIET ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(configure)
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${source}/build" -G Ninja
    -DCMAKE_BUILD_TYPE=Release -DCMAKE_TRY_COMPILE_CONFIGURATION=Release -DBUILD_TESTING=OFF
    "-DCMAKE_CXX_COMPILER=${CXX}" "-DARDUINO_CLI=${scratch}/cli-build/arduino-cli${suffix}"
    "-DARDUINO_DATA_DIR=${scratch}/data" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(build expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${source}/build" --target waveshare-147 pocket-096
    OUTPUT_VARIABLE log ERROR_VARIABLE error RESULT_VARIABLE result)
  if(result)
    message(FATAL_ERROR "Actual firmware graph failed: ${log}\n${error}")
  endif()
  foreach(board waveshare-147 pocket-096)
    file(STRINGS "${source}/build/dist/firmware/${board}-calls.txt" calls)
    list(LENGTH calls count)
    if(NOT count EQUAL expected)
      message(FATAL_ERROR "${board}: expected ${expected} compiler invocations, got ${count}: ${log}")
    endif()
    foreach(name manifest.json R2500Adapter.ino.bin R2500Adapter.ino.bootloader.bin R2500Adapter.ino.partitions.bin
        boot_app0.bin LICENSE THIRD_PARTY_NOTICES.md AllpowersModels.LICENSE.txt ESP32-Arduino-LICENSE.md
        corresponding-source.zip licenses.zip FIRMWARE-LICENSES.md)
      if(NOT EXISTS "${source}/build/dist/firmware/${board}/${name}")
        message(FATAL_ERROR "Missing existing graph output: ${board}/${name}")
      endif()
    endforeach()
  endforeach()
endfunction()
file(WRITE "${source}/firmware/R2500Adapter/removed.cpp" "// initial removable source\n")
git(init -q)
git(config user.name "Firmware Graph Test")
git(config user.email "graph@example.invalid")
git(config commit.gpgsign false)
git(add .)
git(commit -qm fixture)
git(tag v1.2.3)
# Make identity dirty before the baseline; subsequent membership edits must not
# depend on a clean -> dirty identity transition to invalidate the firmware.
file(APPEND "${source}/core/src/AllpowersCore.h" "\n// fixture remains dirty\n")
configure()
build(1)
build(1)
file(REMOVE "${source}/firmware/R2500Adapter/removed.cpp")
build(2)
file(WRITE "${source}/firmware/R2500Adapter/added.cpp" "// added source\n")
build(3)
file(RENAME "${source}/firmware/R2500Adapter/added.cpp" "${source}/firmware/R2500Adapter/renamed.cpp")
build(4)
foreach(board waveshare-147 pocket-096)
  if(EXISTS "${source}/build/firmware/${board}/sketch/R2500Adapter/removed.cpp" OR
      EXISTS "${source}/build/firmware/${board}/sketch/R2500Adapter/added.cpp" OR
      NOT EXISTS "${source}/build/firmware/${board}/sketch/R2500Adapter/renamed.cpp")
    message(FATAL_ERROR "Graph retained removed/renamed staged source: ${board}")
  endif()
endforeach()
build(4)
# Re-exercise the same production graph as a no-.git corresponding source kit.
file(RENAME "${source}/.git" "${scratch}/fixture-git")
file(WRITE "${source}/VERSION" "1.2.3-dirty\n")
configure()
build(5)
build(5)
message(STATUS "Both real firmware targets handle unchanged/add/rename/deletion-only and archive no-op builds")
