cmake_minimum_required(VERSION 4.4)
find_package(Python3 REQUIRED COMPONENTS Interpreter)
set(source "${WORK}/source")
set(build "${WORK}/build")
file(MAKE_DIRECTORY "${source}/core" "${source}/cmake")
file(COPY "${ROOT}/cmake/AnalysisRules.ruleset" DESTINATION "${source}/cmake")
file(WRITE "${source}/core/a.cpp" "int a() { return 1; }\n")
file(WRITE "${source}/core/b.cpp" "int b() { return 2; }\n")
file(WRITE "${source}/CMakeLists.txt" "cmake_minimum_required(VERSION 4.4)
project(AnalysisControl LANGUAGES CXX)
include(\"${ROOT}/cmake/StaticAnalysis.cmake\")
set(AP_ANALYSIS_ROOT \"${source}\")
add_library(control STATIC core/a.cpp core/b.cpp)
ap_enable_static_analysis(control)
")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${build}" -G Ninja
  "-DCMAKE_CXX_COMPILER=${CXX}" "-DCMAKE_MAKE_PROGRAM=${NINJA}" -DALLPOWERS_STATIC_ANALYSIS=ON
  COMMAND_ERROR_IS_FATAL ANY)
function(build_control)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --parallel 2
    COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(check_control expect_success)
  execute_process(COMMAND "${Python3_EXECUTABLE}" -I -S -B "${ROOT}/cmake/static_analysis.py" msvc
    --root "${source}" --build "${build}" --output "${WORK}/reports" RESULT_VARIABLE result)
  if(expect_success AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid MSVC control failed")
  elseif(NOT expect_success AND result EQUAL 0)
    message(FATAL_ERROR "Defective/incomplete MSVC control passed")
  endif()
endfunction()
build_control()
check_control(TRUE)
file(GLOB reports "${build}/analysis/control/*.sarif")
list(LENGTH reports count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Parallel MSVC units must have independent SARIF files")
endif()
file(WRITE "${source}/core/a.cpp" "int a() { int* p = nullptr; return *p; }\n")
build_control()
check_control(FALSE)
file(WRITE "${source}/core/a.cpp" "int a() { return 1; }\n")
build_control()
check_control(TRUE)
foreach(report IN LISTS reports)
  file(TIMESTAMP "${report}" stamp "%s")
  set(before_${report} "${stamp}")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1)
file(APPEND "${source}/cmake/AnalysisRules.ruleset" "\n<!-- rule update control -->\n")
build_control()
foreach(report IN LISTS reports)
  file(TIMESTAMP "${report}" stamp "%s")
  if(NOT stamp GREATER before_${report})
    message(FATAL_ERROR "Rule change did not rebuild ${report}")
  endif()
endforeach()
check_control(TRUE)
list(GET reports 0 report)
file(WRITE "${report}" "{\"runs\":")
check_control(FALSE)
file(REMOVE "${report}")
check_control(FALSE)
