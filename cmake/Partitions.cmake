function(ap_little_endian output hex)
  string(LENGTH "${hex}" length)
  set(result "")
  while(length GREATER 0)
    math(EXPR length "${length}-2")
    string(SUBSTRING "${hex}" ${length} 2 byte)
    string(APPEND result "${byte}")
  endwhile()
  math(EXPR result "0x${result}" OUTPUT_FORMAT DECIMAL)
  set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(ap_partitions output binary contract)
  file(READ "${binary}" table HEX)
  string(LENGTH "${table}" length)
  set(entries "{}")
  set(offset 0)
  while(offset LESS length)
    string(SUBSTRING "${table}" ${offset} 64 record)
    string(SUBSTRING "${record}" 0 4 magic)
    if(NOT magic STREQUAL "aa50")
      break()
    endif()
    string(SUBSTRING "${record}" 8 8 address)
    string(SUBSTRING "${record}" 16 8 size)
    ap_little_endian(address "${address}")
    ap_little_endian(size "${size}")
    set(label "")
    foreach(index RANGE 24 54 2)
      string(SUBSTRING "${record}" ${index} 2 byte)
      if(byte STREQUAL "00")
        break()
      endif()
      math(EXPR value "0x${byte}")
      string(ASCII ${value} char)
      string(APPEND label "${char}")
    endforeach()
    string(JSON entries SET "${entries}" "${label}" "[${address},${size}]")
    math(EXPR offset "${offset}+64")
  endwhile()
  string(JSON expected GET "${contract}" partitions)
  string(JSON count LENGTH "${expected}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${expected}" ${index})
    string(JSON want GET "${expected}" "${name}")
    string(JSON actual ERROR_VARIABLE error GET "${entries}" "${name}")
    if(error OR NOT actual STREQUAL want)
      message(FATAL_ERROR "Partition contract mismatch: ${name}")
    endif()
  endforeach()
  set(${output} "${entries}" PARENT_SCOPE)
endfunction()
