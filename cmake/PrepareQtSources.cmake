cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
if(NOT SOURCE_CACHE)
  message(FATAL_ERROR "Set SOURCE_CACHE for verified Qt archives")
endif()
file(MAKE_DIRECTORY "${SOURCE_CACHE}")
file(LOCK "${SOURCE_CACHE}/qt-downloads.lock" GUARD PROCESS TIMEOUT 600)
foreach(module qtbase qtconnectivity qttools)
  string(TOUPPER "${module}" key)
  set(name "${module}-everywhere-src-${ALLPOWERS_QT_VERSION}.tar.xz")
  set(actual "")
  if(EXISTS "${SOURCE_CACHE}/${name}")
    file(SHA256 "${SOURCE_CACHE}/${name}" actual)
  endif()
  if(NOT actual STREQUAL ALLPOWERS_${key}_SHA256)
    file(DOWNLOAD "${ALLPOWERS_QT_SOURCE_URL}/${name}" "${SOURCE_CACHE}/${name}.partial"
      EXPECTED_HASH "SHA256=${ALLPOWERS_${key}_SHA256}" TLS_VERIFY ON TIMEOUT 600 INACTIVITY_TIMEOUT 60)
    file(RENAME "${SOURCE_CACHE}/${name}.partial" "${SOURCE_CACHE}/${name}")
  endif()
endforeach()
