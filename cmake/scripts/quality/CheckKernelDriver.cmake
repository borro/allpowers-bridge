cmake_minimum_required(VERSION 4.4)
find_program(DUMPBIN dumpbin REQUIRED)
get_filename_component(DRIVER "${DRIVER}" ABSOLUTE)
execute_process(COMMAND "${DUMPBIN}" /nologo /headers /dependents "${DRIVER}"
  OUTPUT_VARIABLE pe RESULT_VARIABLE result)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Kernel PE inspection failed (${result}): ${pe}")
endif()
string(TOLOWER "${pe}" lower)
if(NOT lower MATCHES "8664 machine" OR NOT lower MATCHES "1 subsystem.*native")
  message(FATAL_ERROR "Driver must be an x64 native-subsystem PE")
endif()
string(REGEX MATCHALL "[a-z0-9_.-]+\\.(dll|sys)" imports "${lower}")
foreach(name IN LISTS imports)
  if(NOT name MATCHES "^(ntoskrnl.exe|hal.dll|wdfldr.sys|battc.sys|allpowersups.sys)$")
    message(FATAL_ERROR "Unexpected kernel dependency: ${name}")
  endif()
endforeach()
foreach(required wdfldr.sys battc.sys)
  if(NOT lower MATCHES "${required}")
    message(FATAL_ERROR "Missing kernel dependency: ${required}")
  endif()
endforeach()
message(STATUS "Kernel PE: x64/native, Battery Class + KMDF, no user-mode DLLs")
