include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Arguments.cmake")

function(ap_assert_child_path)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;PATH;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT PATH)
  cmake_path(ABSOLUTE_PATH AP_ROOT NORMALIZE OUTPUT_VARIABLE base)
  cmake_path(ABSOLUTE_PATH AP_PATH NORMALIZE OUTPUT_VARIABLE target)
  cmake_path(IS_PREFIX base "${target}" NORMALIZE inside)
  if(NOT inside OR base STREQUAL target)
    message(FATAL_ERROR "Path must be a strict workspace descendant: ${target}")
  endif()
  set(cursor "${target}")
  while(NOT cursor STREQUAL base)
    if(IS_SYMLINK "${cursor}")
      message(FATAL_ERROR "Workspace path contains a symlink: ${cursor}")
    endif()
    get_filename_component(cursor "${cursor}" DIRECTORY)
  endwhile()
  if(AP_OUTPUT)
    set(${AP_OUTPUT} "${target}" PARENT_SCOPE)
  endif()
endfunction()

function(ap_remove_tree)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;PATH" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT PATH)
  ap_assert_child_path(ROOT "${AP_ROOT}" PATH "${AP_PATH}" OUTPUT target)
  file(REMOVE_RECURSE "${target}")
endfunction()

function(ap_write_changed)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "PATH;CONTENT" "")
  ap_require_arguments(PREFIX AP REQUIRED PATH CONTENT ALLOW_EMPTY CONTENT)
  if(EXISTS "${AP_PATH}")
    file(READ "${AP_PATH}" previous)
    if(previous STREQUAL AP_CONTENT)
      return()
    endif()
  endif()
  get_filename_component(parent "${AP_PATH}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(WRITE "${AP_PATH}" "${AP_CONTENT}")
endfunction()
