include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../common/Json.cmake")

function(ap_collect_firmware_notices)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;WORK;OUTPUT;DATA;CACHE" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT WORK OUTPUT DATA CACHE)
  set(root "${AP_ROOT}")
  set(work "${AP_WORK}")
  set(output "${AP_OUTPUT}")
  set(data "${AP_DATA}")
  set(cache "${AP_CACHE}")
  find_package(Python3 3.10 REQUIRED COMPONENTS Interpreter)
  set(config "{}")
  foreach(key root work output data cache)
    file(TO_CMAKE_PATH "${${key}}" path)
    ap_json_quote(OUTPUT quoted VALUE "${path}")
    string(JSON config SET "${config}" "${key}" "${quoted}")
  endforeach()
  foreach(key ESP32_VERSION ESP32_TOOLCHAIN_VERSION FIRMWARE_RELINK_LIBRARIES)
    ap_json_quote(OUTPUT quoted VALUE "${ALLPOWERS_${key}}")
    string(JSON config SET "${config}" "${key}" "${quoted}")
  endforeach()
  set(sources "{}")
  foreach(record IN LISTS ALLPOWERS_FIRMWARE_SOURCE_ARCHIVES)
    string(REPLACE "|" ";" fields "${record}")
    list(GET fields 0 name)
    list(GET fields 1 url)
    list(GET fields 2 hash)
    list(GET fields 3 top)
    set(item "{}")
    foreach(key url hash top)
      ap_json_quote(OUTPUT quoted VALUE "${${key}}")
      string(JSON item SET "${item}" "${key}" "${quoted}")
    endforeach()
    string(JSON sources SET "${sources}" "${name}" "${item}")
  endforeach()
  string(JSON config SET "${config}" sources "${sources}")
  set(path "${work}/firmware-notices-input.json")
  file(WRITE "${path}" "${config}\n")
  execute_process(COMMAND "${Python3_EXECUTABLE}" -I -S -B
    "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../../tools/release/firmware_notices.py" "${path}"
    COMMAND_ERROR_IS_FATAL ANY)
endfunction()

# Validate the public inventory independently of the collector: a transport
# manifest must not silently omit a license still referenced by the table.
function(ap_validate_firmware_notices)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "FOLDER;FILES" "")
  ap_require_arguments(PREFIX AP REQUIRED FOLDER FILES)
  file(READ "${AP_FOLDER}/licenses/components.json" components)
  file(READ "${AP_FOLDER}/licenses/NOTICES.md" notices)
  string(JSON count LENGTH "${components}")
  if(count LESS 1)
    message(FATAL_ERROR "Empty firmware component license inventory")
  endif()
  math(EXPR last "${count}-1")
  set(documents)
  foreach(index RANGE ${last})
    string(JSON name MEMBER "${components}" ${index})
    string(JSON texts LENGTH "${components}" "${name}" documents)
    string(JSON blocks LENGTH "${components}" "${name}" notices)
    if(texts EQUAL 0 AND blocks EQUAL 0)
      message(FATAL_ERROR "Missing firmware attribution: ${name}")
    endif()
    if(texts GREATER 0)
      math(EXPR final "${texts}-1")
      foreach(item RANGE ${final})
        string(JSON document GET "${components}" "${name}" documents ${item})
        if(NOT document MATCHES "^[A-Za-z0-9][A-Za-z0-9_.-]*\\.txt$" OR
            NOT "licenses/${document}" IN_LIST AP_FILES)
          message(FATAL_ERROR "Missing/unsafe firmware license text: ${name}/${document}")
        endif()
        list(APPEND documents "licenses/${document}")
      endforeach()
    endif()
    if(blocks GREATER 0)
      math(EXPR final "${blocks}-1")
      foreach(item RANGE ${final})
        string(JSON block GET "${components}" "${name}" notices ${item})
        string(FIND "${notices}" "## ${block}\n" found)
        if(NOT block MATCHES "^notice-[0-9a-f]+$" OR found LESS 0)
          message(FATAL_ERROR "Missing firmware copyright/notice: ${name}/${block}")
        endif()
      endforeach()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES documents)
  set(hashes)
  foreach(document IN LISTS documents)
    file(SHA256 "${AP_FOLDER}/${document}" hash)
    if(hash IN_LIST hashes)
      message(FATAL_ERROR "Duplicate full firmware license text: ${document}")
    endif()
    list(APPEND hashes "${hash}")
  endforeach()
  foreach(name IN LISTS AP_FILES)
    if(name MATCHES "^licenses/.*\\.txt$" AND NOT name IN_LIST documents)
      message(FATAL_ERROR "Firmware license text has no component: ${name}")
    endif()
  endforeach()
endfunction()
