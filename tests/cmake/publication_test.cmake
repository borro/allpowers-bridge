cmake_minimum_required(VERSION 3.25)
find_package(Git REQUIRED)
include("${ROOT}/cmake/PublicSources.cmake")
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside_build)
if(NOT inside_build OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Publication tests require a dedicated build subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
file(MAKE_DIRECTORY "${scratch}/repo")
set(repo "${scratch}/repo")
function(git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${repo}"
    OUTPUT_QUIET ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
endfunction()
function(audit mode expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DMODE=${mode}"
    -P "${ROOT}/cmake/Audit.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL pass AND NOT result EQUAL 0)
    message(FATAL_ERROR "Expected ${mode} audit to pass: ${output}${error}")
  elseif(expected STREQUAL fail AND result EQUAL 0)
    message(FATAL_ERROR "${mode} audit incorrectly accepted private/unreviewed data")
  endif()
endfunction()
git(init -q)
git(config user.name "Publication Test")
git(config user.email "test@example.invalid")
git(config commit.gpgsign false)
file(WRITE "${repo}/README.md" "Synthetic publication test\n")
file(WRITE "${repo}/.gitignore" "build/\n.env\n")
git(add README.md .gitignore)
git(commit -qm "Synthetic baseline")
audit(index pass)
audit(worktree pass)
file(WRITE "${repo}/build/foreign.bin" "Never package this ignored output")
file(WRITE "${repo}/.env" "Private local settings")
ap_public_sources(files "${repo}")
list(LENGTH files count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Ignored files entered the public source inventory")
endif()
file(WRITE "${repo}/config/devices.json" "{}")
audit(worktree fail)
file(REMOVE "${repo}/config/devices.json")
string(CONCAT fake_key "-----BEGIN RSA " "PRIVATE KEY-----")
file(WRITE "${repo}/README.md" "${fake_key}\n")
audit(index pass)
audit(worktree fail)
git(add README.md)
audit(index fail)
git(commit -qm "Synthetic credential fixture")
file(WRITE "${repo}/README.md" "Clean again\n")
git(add README.md)
git(commit -qm "Remove fixture")
audit(index pass)
audit(history fail)
git(add -f build/foreign.bin)
audit(index fail)
message(STATUS "Publication guards reject unreviewed files, staged secrets and deleted historical secrets")
