cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
set(manifest "${PREFIX}/allpowers-source-identity.cmake")
file(GLOB_RECURSE libraries RELATIVE "${PREFIX}" "${PREFIX}/lib/*.lib" "${PREFIX}/plugins/*.lib")
list(SORT libraries)
if(NOT libraries)
  message(FATAL_ERROR "No static Qt libraries found")
endif()
set(identity "")
foreach(module qtbase qtconnectivity)
  string(TOUPPER "${module}" key)
  set(archive "${SOURCE_CACHE}/${module}-everywhere-src-${ALLPOWERS_QT_VERSION}.tar.xz")
  file(SHA256 "${archive}" actual)
  if(NOT actual STREQUAL ALLPOWERS_${key}_SHA256)
    message(FATAL_ERROR "Qt source archive does not match the pinned source")
  endif()
  string(APPEND identity "${module} ${actual}\n")
endforeach()
foreach(library IN LISTS libraries)
  file(SHA256 "${PREFIX}/${library}" actual)
  string(APPEND identity "${library} ${actual}\n")
endforeach()
if(MODE STREQUAL "SEAL")
  # Only the managed source build supplies these directories. Comparing the
  # extracted files also catches edits to a retained ExternalProject source tree.
  foreach(module qtbase qtconnectivity)
    if(NOT IS_DIRECTORY "${${module}_SOURCE}")
      message(FATAL_ERROR "Sealing requires the managed ${module} source tree")
    endif()
    set(reference "${WORK}/${module}")
    file(MAKE_DIRECTORY "${reference}")
    file(ARCHIVE_EXTRACT INPUT "${SOURCE_CACHE}/${module}-everywhere-src-${ALLPOWERS_QT_VERSION}.tar.xz"
      DESTINATION "${reference}")
    set(reference "${reference}/${module}-everywhere-src-${ALLPOWERS_QT_VERSION}")
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${reference}" "${reference}/*" "${reference}/.*")
    foreach(file IN LISTS files)
      file(SHA256 "${reference}/${file}" original)
      file(SHA256 "${${module}_SOURCE}/${file}" built)
      if(NOT original STREQUAL built)
        message(FATAL_ERROR "Modified Qt source needs a matching source kit: ${module}/${file}")
      endif()
    endforeach()
  endforeach()
  file(WRITE "${manifest}" "${identity}")
elseif(MODE STREQUAL "VERIFY")
  if(NOT EXISTS "${manifest}")
    message(FATAL_ERROR "Qt SDK has no corresponding-source identity. Build the managed qt-static target before publishing.")
  endif()
  file(READ "${manifest}" recorded)
  if(NOT recorded STREQUAL identity)
    message(FATAL_ERROR "Qt libraries/source archives changed. Refusing to distribute unrelated corresponding sources.")
  endif()
else()
  message(FATAL_ERROR "Set MODE to SEAL or VERIFY")
endif()
