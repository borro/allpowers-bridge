cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Download.cmake")
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
if(NOT EXISTS "${ROOT}/.git")
  message(FATAL_ERROR "Secret history audit requires a Git checkout")
endif()
if(CMAKE_HOST_WIN32)
  set(platform windows_x64.zip)
  set(hash "${ALLPOWERS_GITLEAKS_WINDOWS_SHA256}")
  set(executable gitleaks.exe)
else()
  set(platform linux_x64.tar.gz)
  set(hash "${ALLPOWERS_GITLEAKS_LINUX_SHA256}")
  set(executable gitleaks)
endif()
set(name "gitleaks_${ALLPOWERS_GITLEAKS_VERSION}_${platform}")
if(NOT DEPS_DIR)
  set(DEPS_DIR "${ROOT}/build/deps")
endif()
if(NOT WORK)
  set(WORK "${ROOT}/build/tools/gitleaks/${CMAKE_HOST_SYSTEM_NAME}")
endif()
set(cache "${DEPS_DIR}/downloads")
set(work "${WORK}")
file(MAKE_DIRECTORY "${cache}" "${work}")
ap_download_verified(URL "https://github.com/gitleaks/gitleaks/releases/download/v${ALLPOWERS_GITLEAKS_VERSION}/${name}" DESTINATION "${cache}/${name}"
  SHA256 "${hash}" MISMATCH FAIL TIMEOUT 180 INACTIVITY_TIMEOUT 30)
file(ARCHIVE_EXTRACT INPUT "${cache}/${name}" DESTINATION "${work}")
foreach(scope history staged worktree)
  if(scope STREQUAL history)
    set(options --log-opts=--all)
  elseif(scope STREQUAL staged)
    set(options --pre-commit --staged)
  else()
    set(options --pre-commit)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env --unset=GITLEAKS_CONFIG
    --unset=GITLEAKS_CONFIG_TOML -- "${work}/${executable}" git "${ROOT}"
    ${options} --redact --no-banner --ignore-gitleaks-allow COMMAND_ERROR_IS_FATAL ANY)
endforeach()
