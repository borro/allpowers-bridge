include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Arguments.cmake")

# A per-artifact lock protects both validation and publication. Consumers never
# observe a partial download, and rejected payloads never replace cached files.
function(ap_download_verified)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "URL;DESTINATION;SHA256;MISMATCH;TIMEOUT;INACTIVITY_TIMEOUT" "")
  ap_require_arguments(PREFIX AP REQUIRED URL DESTINATION SHA256)
  string(LENGTH "${AP_SHA256}" digits)
  if(NOT digits EQUAL 64 OR NOT AP_SHA256 MATCHES "^[0-9a-fA-F]+$")
    message(FATAL_ERROR "A pinned SHA256 is required for ${AP_DESTINATION}")
  endif()
  string(TOLOWER "${AP_SHA256}" expected)
  if(NOT AP_MISMATCH)
    set(AP_MISMATCH FAIL)
  endif()
  if(NOT AP_MISMATCH MATCHES "^(FAIL|REPLACE)$")
    message(FATAL_ERROR "MISMATCH must be FAIL or REPLACE")
  endif()
  if(NOT AP_TIMEOUT)
    set(AP_TIMEOUT 180)
  endif()
  if(NOT AP_INACTIVITY_TIMEOUT)
    set(AP_INACTIVITY_TIMEOUT 30)
  endif()
  get_filename_component(destination "${AP_DESTINATION}" ABSOLUTE)
  get_filename_component(parent "${destination}" DIRECTORY)
  file(MAKE_DIRECTORY "${parent}")
  file(LOCK "${destination}.lock" GUARD FUNCTION TIMEOUT 600)
  if(IS_SYMLINK "${destination}" OR IS_DIRECTORY "${destination}")
    message(FATAL_ERROR "Download destination must be a regular file: ${destination}")
  endif()
  if(EXISTS "${destination}")
    file(SHA256 "${destination}" actual)
    if(actual STREQUAL expected)
      return()
    endif()
    if(AP_MISMATCH STREQUAL "FAIL")
      message(FATAL_ERROR "Cached archive checksum mismatch: ${destination}")
    endif()
  endif()
  string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
  set(partial "${destination}.${suffix}.partial")
  file(DOWNLOAD "${AP_URL}" "${partial}" TLS_VERIFY ON STATUS status
    TIMEOUT "${AP_TIMEOUT}" INACTIVITY_TIMEOUT "${AP_INACTIVITY_TIMEOUT}")
  list(GET status 0 code)
  if(NOT code EQUAL 0)
    file(REMOVE "${partial}")
    message(FATAL_ERROR "Download failed for ${destination}: ${status}")
  endif()
  file(SHA256 "${partial}" actual)
  if(NOT actual STREQUAL expected)
    file(REMOVE "${partial}")
    message(FATAL_ERROR "Downloaded archive checksum mismatch: ${destination}")
  endif()
  file(RENAME "${partial}" "${destination}")
endfunction()
