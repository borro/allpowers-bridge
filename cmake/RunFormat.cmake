cmake_minimum_required(VERSION 4.4)
if(NOT ROOT)
  message(FATAL_ERROR "ROOT is required")
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/PublicSources.cmake")
if(NOT TOOL)
  include("${CMAKE_CURRENT_LIST_DIR}/SetupClangFormat.cmake")
  set(TOOL "${CLANG_FORMAT_TOOL}")
endif()
execute_process(COMMAND "${TOOL}" --version OUTPUT_VARIABLE version
  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
string(REGEX MATCH "clang-format version ([0-9]+[.][0-9]+[.][0-9]+)" matched "${version}")
if(NOT matched OR NOT CMAKE_MATCH_1 STREQUAL ALLPOWERS_CLANG_FORMAT_VERSION)
  message(FATAL_ERROR "Expected clang-format ${ALLPOWERS_CLANG_FORMAT_VERSION}, got: ${version}")
endif()
if(NOT EXISTS "${ROOT}/.clang-format")
  message(FATAL_ERROR "Missing repository formatting policy")
endif()
ap_public_sources(files "${ROOT}")
# Start with the application sources already maintained under .clang-format.
# Other product directories and frozen test fixtures are outside this policy.
list(FILTER files INCLUDE REGEX "^apps/windows/.*[.](cpp|h)$")
if(NOT files)
  message(FATAL_ERROR "No Windows application sources selected for formatting")
endif()
list(LENGTH files count)
list(TRANSFORM files PREPEND "${ROOT}/")
execute_process(COMMAND "${TOOL}" --dry-run --Werror "--style=file:${ROOT}/.clang-format" ${files}
  WORKING_DIRECTORY "${ROOT}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "clang-format ${ALLPOWERS_CLANG_FORMAT_VERSION}: ${count} application files passed")
if(CHECK_CONTROLS)
  if(NOT WORK)
    message(FATAL_ERROR "WORK is required for formatting controls")
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" "-DWORK=${WORK}/controls"
    "-DTOOL=${TOOL}" -P "${CMAKE_CURRENT_LIST_DIR}/../tests/cmake/format_test.cmake"
    COMMAND_ERROR_IS_FATAL ANY)
endif()
