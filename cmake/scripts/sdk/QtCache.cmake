cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Arguments.cmake")
if(NOT ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
endif()
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
if(NOT BUILD_DIRECTORY)
  set(BUILD_DIRECTORY build/windows)
endif()
get_filename_component(BUILD_DIRECTORY "${BUILD_DIRECTORY}" ABSOLUTE BASE_DIR "${ROOT}")
set(install "${BUILD_DIRECTORY}/deps/qt/install")
set(manifest "${install}/allpowers-qt-cache.json")

function(ap_qt_output)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "NAME;VALUE;RESULT_FILE" "")
  ap_require_arguments(PREFIX AP REQUIRED NAME VALUE ALLOW_EMPTY VALUE)
  message(STATUS "${AP_NAME}=${AP_VALUE}")
  if(NOT "$ENV{GITHUB_OUTPUT}" STREQUAL "")
    file(APPEND "$ENV{GITHUB_OUTPUT}" "${AP_NAME}=${AP_VALUE}\n")
  endif()
  if(AP_RESULT_FILE AND AP_NAME STREQUAL "root")
    file(WRITE "${AP_RESULT_FILE}" "${AP_VALUE}")
  endif()
endfunction()

# Run verification in a separate CMake process so Restore can quarantine a
# rejected SDK, while Seal propagates every configure/link/runtime failure.
if(MODE STREQUAL "Verify")
  execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=VERIFY "-DPREFIX=${install}"
    "-DSOURCE_CACHE=${ROOT}/build/deps/downloads" -P "${ROOT}/cmake/scripts/sdk/QtSourceIdentity.cmake"
    COMMAND_ERROR_IS_FATAL ANY)
  set(probe "${BUILD_DIRECTORY}/qt-cache-probe")
  file(MAKE_DIRECTORY "${probe}/source")
  configure_file("${ROOT}/cmake/templates/sdk/QtCacheProbe.cmake.in" "${probe}/source/CMakeLists.txt" COPYONLY)
  execute_process(COMMAND "${CMAKE_COMMAND}" --fresh -S "${probe}/source" -B "${probe}/build" -G Ninja
    -DCMAKE_BUILD_TYPE=Release "-DALLPOWERS_ROOT=${ROOT}" "-DCMAKE_PREFIX_PATH=${install}"
    "-DQt6_DIR=${install}/lib/cmake/Qt6" COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${probe}/build" --parallel 2 COMMAND_ERROR_IS_FATAL ANY)
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${probe}/build" --output-on-failure
    COMMAND_ERROR_IS_FATAL ANY)
  return()
endif()
if(NOT MODE MATCHES "^(Key|Restore|Seal)$")
  message(FATAL_ERROR "Set MODE to Key, Restore or Seal")
endif()
string(TIMESTAMP started "%s")
find_program(compiler cl.exe REQUIRED)
get_filename_component(compiler_dir "${compiler}" DIRECTORY)
set(linker "${compiler_dir}/link.exe")
foreach(name VCToolsVersion WindowsSDKVersion VSCMD_ARG_TGT_ARCH)
  if("$ENV{${name}}" STREQUAL "")
    message(FATAL_ERROR "Missing MSVC environment variable: ${name}")
  endif()
endforeach()
if(NOT "$ENV{VSCMD_ARG_TGT_ARCH}" STREQUAL "x64")
  message(FATAL_ERROR "The Qt cache requires an x64 MSVC environment")
endif()
find_program(ninja ninja REQUIRED)
execute_process(COMMAND "${ninja}" --version OUTPUT_VARIABLE ninja_version
  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
include("${ROOT}/cmake/modules/sdk/DependencyFingerprint.cmake")
ap_dependency_fingerprint(GROUP qt OUTPUT dependencies)
set(fingerprint "{}")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Json.cmake")
function(ap_qt_input)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "JSON;OUTPUT;NAME;VALUE" "")
  ap_require_arguments(PREFIX AP REQUIRED JSON OUTPUT NAME VALUE ALLOW_EMPTY VALUE)
  ap_json_quote(OUTPUT quoted VALUE "${AP_VALUE}")
  string(JSON result SET "${AP_JSON}" "${AP_NAME}" "${quoted}")
  set(${AP_OUTPUT} "${result}" PARENT_SCOPE)
endfunction()
ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME schema VALUE 4)
ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME platform VALUE Windows-x64-Release-static-MT-WinRT)
foreach(name install compiler linker)
  string(TOLOWER "${${name}}" path)
  ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME "${name}" VALUE "${path}")
endforeach()
# Hash actual tool binaries: stronger than their VERSIONINFO and no .NET needed.
foreach(name compiler linker)
  file(SHA256 "${${name}}" hash)
  ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME "${name}SHA256" VALUE "${hash}")
endforeach()
ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME dependencies VALUE "${dependencies}")
foreach(name VCToolsVersion WindowsSDKVersion WindowsSdkDir UCRTVersion)
  ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME "${name}" VALUE "$ENV{${name}}")
endforeach()
ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME cmake VALUE "${CMAKE_VERSION}")
ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME ninja VALUE "${ninja_version}")
# Do not hash the shared fingerprint helper: firmware-only edits do not affect Qt.
foreach(recipe cmake/modules/common/Json.cmake cmake/modules/common/Arguments.cmake
    cmake/modules/sdk/QtStatic.cmake cmake/modules/project/WindowsCompiler.cmake cmake/modules/project/SizeOptimization.cmake cmake/scripts/sdk/QtCache.cmake
    cmake/templates/sdk/QtCacheProbe.cmake.in cmake/scripts/quality/QtCacheImports.cmake tests/sdk/qt_cache_probe.cpp cmake/scripts/sdk/QtSourceIdentity.cmake)
  file(SHA256 "${ROOT}/${recipe}" hash)
  ap_qt_input(JSON "${fingerprint}" OUTPUT fingerprint NAME "${recipe}" VALUE "${hash}")
endforeach()
string(SHA256 digest "${fingerprint}")
set(key "qt-static-v4-windows-x64-${digest}")
string(TIMESTAMP finished "%s")
math(EXPR seconds "${finished} - ${started}")
message(STATUS "Qt cache identity: SHA256 of cl/link, SDK $ENV{WindowsSDKVersion}; computed in ${seconds}s")
if(MODE STREQUAL "Key")
  ap_qt_output(RESULT_FILE "${RESULT_FILE}" NAME key VALUE "${key}")
  ap_qt_output(RESULT_FILE "${RESULT_FILE}" NAME path VALUE "${install}")
  ap_qt_output(RESULT_FILE "${RESULT_FILE}" NAME key-seconds VALUE "${seconds}")
  return()
endif()
set(verify_command "${CMAKE_COMMAND}" -DMODE=Verify "-DROOT=${ROOT}"
  "-DBUILD_DIRECTORY=${BUILD_DIRECTORY}" -P "${CMAKE_CURRENT_LIST_FILE}")
if(MODE STREQUAL "Restore")
  if(EXISTS "${install}")
    set(compatible FALSE)
    if(EXISTS "${manifest}")
      file(READ "${manifest}" saved)
      string(JSON saved_key ERROR_VARIABLE key_error GET "${saved}" key)
      string(JSON saved_fingerprint ERROR_VARIABLE fingerprint_error GET "${saved}" fingerprint)
      if(NOT key_error AND NOT fingerprint_error AND saved_key STREQUAL key AND saved_fingerprint STREQUAL fingerprint)
        set(compatible TRUE)
      endif()
    endif()
    if(compatible)
      execute_process(COMMAND ${verify_command} RESULT_VARIABLE result
        OUTPUT_FILE "${BUILD_DIRECTORY}/qt-cache-verify.log" ERROR_FILE "${BUILD_DIRECTORY}/qt-cache-verify.log")
      if(result STREQUAL "0")
        ap_qt_output(RESULT_FILE "${RESULT_FILE}" NAME root VALUE "${install}")
        message(STATUS "Reusing verified static Qt SDK")
        return()
      endif()
    endif()
    string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
    file(RENAME "${install}" "${BUILD_DIRECTORY}/qt-cache-rejected-${suffix}" NO_REPLACE)
    message(WARNING "Qt cache rejected and preserved for diagnostics; building from source")
  endif()
  ap_qt_output(RESULT_FILE "${RESULT_FILE}" NAME root VALUE "")
  return()
endif()
execute_process(COMMAND ${verify_command} COMMAND_ERROR_IS_FATAL ANY)
set(saved "{}")
# Encode the canonical fingerprint as a JSON string, retaining exact equality.
set(saved_fingerprint "${fingerprint}")
ap_json_quote(OUTPUT escaped VALUE "${saved_fingerprint}")
string(JSON saved SET "${saved}" key "\"${key}\"")
string(JSON saved SET "${saved}" fingerprint "${escaped}")
file(WRITE "${manifest}" "${saved}\n")
message(STATUS "Static Qt SDK verified and ready to cache")
