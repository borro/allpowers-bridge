include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Download.cmake")

function(ap_setup_clang_format)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "WORK;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED WORK OUTPUT)
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../Dependencies.cmake")
  get_filename_component(WORK "${AP_WORK}" ABSOLUTE)
  set(extension "")
  if(CMAKE_HOST_WIN32)
    set(platform WINDOWS)
    set(extension .exe)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL Linux)
    execute_process(COMMAND uname -m OUTPUT_VARIABLE architecture OUTPUT_STRIP_TRAILING_WHITESPACE
      COMMAND_ERROR_IS_FATAL ANY)
    if(NOT architecture STREQUAL x86_64)
      message(FATAL_ERROR "Pinned clang-format requires Linux x64")
    endif()
    set(platform LINUX)
  else()
    message(FATAL_ERROR "Pinned clang-format supports Windows x64 and Linux x64")
  endif()
  file(MAKE_DIRECTORY "${WORK}")
  file(LOCK "${WORK}/.clang-format.lock" GUARD FUNCTION TIMEOUT 180)
  set(archive "${WORK}/clang-format-${ALLPOWERS_CLANG_FORMAT_VERSION}.whl")
  set(expected "${ALLPOWERS_CLANG_FORMAT_${platform}_SHA256}")
  ap_download_verified(URL "${ALLPOWERS_CLANG_FORMAT_${platform}_URL}" DESTINATION "${archive}"
    SHA256 "${expected}" MISMATCH REPLACE TIMEOUT 120 INACTIVITY_TIMEOUT 30)
  # The wheel is just a verified binary container: no pip installation or Python
  # environment is needed. Restore the executable from it on every invocation.
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${WORK}/package")
  set(CLANG_FORMAT_TOOL "${WORK}/package/clang_format/data/bin/clang-format${extension}")
  if(NOT EXISTS "${CLANG_FORMAT_TOOL}")
    message(FATAL_ERROR "Missing clang-format executable in the verified archive")
  endif()
  if(NOT CMAKE_HOST_WIN32)
    file(CHMOD "${CLANG_FORMAT_TOOL}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
      GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
  endif()
  set(${AP_OUTPUT} "${CLANG_FORMAT_TOOL}" PARENT_SCOPE)
endfunction()
