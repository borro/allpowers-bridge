include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Arguments.cmake")
function(ap_json_quote)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;VALUE" "")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT VALUE ALLOW_EMPTY VALUE)
  set(output "${AP_OUTPUT}")
  set(value "${AP_VALUE}")
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(ap_source_hashes)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "OUTPUT;ROOT" "DIRECTORIES")
  ap_require_arguments(PREFIX AP REQUIRED OUTPUT ROOT)
  set(output "${AP_OUTPUT}")
  set(root "${AP_ROOT}")
  set(result "{}")
  foreach(directory IN LISTS AP_DIRECTORIES)
    file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${root}/${directory}/*")
    foreach(path IN LISTS files)
      file(RELATIVE_PATH name "${root}" "${path}")
      if(name MATCHES "(^|/)(__pycache__|build|data)/")
        continue()
      endif()
      file(SHA256 "${path}" digest)
      string(JSON result SET "${result}" "${name}" "\"${digest}\"")
    endforeach()
  endforeach()
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
