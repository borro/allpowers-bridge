cmake_minimum_required(VERSION 4.4)
find_package(Git REQUIRED)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside_build)
if(NOT inside_build OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Release tests require a dedicated binary subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
set(repo "${scratch}/repo")
file(MAKE_DIRECTORY "${repo}/cmake")
file(COPY "${ROOT}/cmake/Version.cmake" "${ROOT}/cmake/ReleaseVersion.cmake" DESTINATION "${repo}/cmake")
file(WRITE "${repo}/.gitignore" "build/\n")
file(WRITE "${repo}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 4.4)
include(cmake/Version.cmake)
project(VersionProbe LANGUAGES NONE)
file(WRITE "${CMAKE_BINARY_DIR}/version.txt" "${ALLPOWERS_VERSION}")
]=])
function(git)
  execute_process(COMMAND "${GIT_EXECUTABLE}" ${ARGN} WORKING_DIRECTORY "${repo}"
    OUTPUT_QUIET ERROR_QUIET COMMAND_ERROR_IS_FATAL ANY)
endfunction()
git(init -q)
git(config user.name "Release Test")
git(config user.email "release@example.invalid")
git(config commit.gpgsign false)
git(add .)
git(commit -qm "Synthetic release fixture")
git(tag v1.2.3-alpha.7)
# Another tag on the same commit must not override the requested release tag.
git(tag -a v2.0.0 -m "Synthetic annotated tag")
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse HEAD WORKING_DIRECTORY "${repo}"
  OUTPUT_VARIABLE first_commit OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" rev-parse refs/tags/v2.0.0 WORKING_DIRECTORY "${repo}"
  OUTPUT_VARIABLE annotated_object OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
function(check tag expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" "-DTAG=${tag}"
    -P "${ROOT}/cmake/CheckReleaseTag.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(expected STREQUAL pass AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid release tag rejected: ${tag}")
  elseif(expected STREQUAL fail AND result EQUAL 0)
    message(FATAL_ERROR "Invalid release accepted: ${tag}")
  endif()
endfunction()
check(v1.2.3-alpha.7 pass)
check(v2.0.0 pass)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" -DTAG=v2.0.0 "-DCOMMIT=${annotated_object}"
  -P "${ROOT}/cmake/CheckReleaseTag.cmake" OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${repo}" -B "${scratch}/configured" -G Ninja
  -DALLPOWERS_RELEASE_TAG=v1.2.3-alpha.7 OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
file(READ "${scratch}/configured/version.txt" version)
if(NOT version STREQUAL "1.2.3-alpha.7")
  message(FATAL_ERROR "Ambiguous Git tags changed the requested product version")
endif()
file(WRITE "${scratch}/format.cmake"
  "include(\"${ROOT}/cmake/ReleaseVersion.cmake\")\nap_release_version(\"\${TAG}\" version)\n")
foreach(tag v1.2 v01.2.3 v1.2.3-alpha.01 v1.2.3-alpha..1 v1.2.3-alpha.+meta
    v1.2.3+meta. v1.2.3-.alpha v1.2.3+.meta v65536.0.0 v999999999999999999999999.0.0)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DTAG=${tag}" -P "${scratch}/format.cmake"
    RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
  if(result EQUAL 0)
    message(FATAL_ERROR "Invalid SemVer tag accepted: ${tag}")
  endif()
endforeach()
git(tag v1.2.3+build.01)
check(v1.2.3+build.01 pass)
check(v3.0.0 fail)
file(WRITE "${repo}/unexpected.txt" "Untracked source\n")
check(v1.2.3-alpha.7 fail)
file(REMOVE "${repo}/unexpected.txt")
file(APPEND "${repo}/.gitignore" "Changed source\n")
check(v1.2.3-alpha.7 fail)
git(add .gitignore)
check(v1.2.3-alpha.7 fail)
git(commit -qm "Different commit")
check(v1.2.3-alpha.7 fail)
git(tag v3.0.0)
check(v3.0.0 pass)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${repo}" -DTAG=v3.0.0 "-DCOMMIT=${first_commit}"
  -P "${ROOT}/cmake/CheckReleaseTag.cmake" RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "A changed tag/checkout was allowed to impersonate the triggering commit")
endif()
file(MAKE_DIRECTORY "${scratch}/archive/cmake")
file(COPY "${ROOT}/cmake/Version.cmake" DESTINATION "${scratch}/archive/cmake")
file(COPY "${repo}/CMakeLists.txt" DESTINATION "${scratch}/archive")
file(WRITE "${scratch}/archive/VERSION" "1.2.3-alpha.7\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scratch}/archive" -B "${scratch}/archive-build"
  -G Ninja -DALLPOWERS_RELEASE_TAG=v1.2.3-alpha.7 RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Source archive was allowed to impersonate a release checkout")
endif()
message(STATUS "Release tag/version, annotated tag, dirty tree and archive guards passed")
