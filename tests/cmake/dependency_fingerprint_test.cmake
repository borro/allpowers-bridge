cmake_minimum_required(VERSION 4.4)
set(source "${WORK}/source")
file(MAKE_DIRECTORY "${source}")
file(COPY "${ROOT}/cmake" "${ROOT}/tools" DESTINATION "${source}")
function(key group output)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DGROUP=${group}" -P "${source}/cmake/scripts/ci/DependencyKeys.cmake"
    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  set(${output} "${value}" PARENT_SCOPE)
endfunction()
foreach(group qt arduino firmware-legal wdk)
  key("${group}" "before_${group}")
endforeach()
file(READ "${source}/cmake/Dependencies.cmake" original)
string(REGEX REPLACE "ALLPOWERS_(CPPCHECK|ACTIONLINT|SHELLCHECK|TIDY_LLVM)_(VERSION|SHA256) \"[^\"]+\""
  "ALLPOWERS_\\1_\\2 \"changed-analysis-tool\"" changed "${original}")
file(WRITE "${source}/cmake/Dependencies.cmake" "${changed}")
foreach(group qt arduino firmware-legal wdk)
  key("${group}" after)
  if(NOT after STREQUAL before_${group})
    message(FATAL_ERROR "Analysis tool invalidated unrelated ${group} cache")
  endif()
endforeach()
string(REPLACE "ALLPOWERS_MULL_VERSION \"0.35.0\"" "ALLPOWERS_MULL_VERSION \"0.99.0\"" changed "${original}")
file(WRITE "${source}/cmake/Dependencies.cmake" "${changed}")
foreach(group qt arduino firmware-legal wdk)
  key("${group}" after)
  if(NOT after STREQUAL before_${group})
    message(FATAL_ERROR "Mull invalidated unrelated ${group} cache")
  endif()
endforeach()
string(REPLACE "ALLPOWERS_ESP32_VERSION \"3.3.11\"" "ALLPOWERS_ESP32_VERSION \"9.0.0\"" changed "${original}")
file(WRITE "${source}/cmake/Dependencies.cmake" "${changed}")
key(qt qt)
key(arduino arduino)
key(firmware-legal legal)
if(NOT qt STREQUAL before_qt OR arduino STREQUAL before_arduino OR legal STREQUAL before_firmware-legal)
  message(FATAL_ERROR "ESP32 invalidation crossed component boundaries or was lost")
endif()
file(WRITE "${source}/cmake/Dependencies.cmake" "${original}")
file(READ "${source}/cmake/modules/sdk/Wdk.cmake" wdk_original)
file(APPEND "${source}/cmake/modules/sdk/Wdk.cmake" "\n# WDK installer recipe control\n")
foreach(group qt arduino firmware-legal wdk)
  key("${group}" changed)
  if(group STREQUAL wdk)
    if(changed STREQUAL before_wdk)
      message(FATAL_ERROR "WDK installer did not invalidate its cache")
    endif()
  elseif(NOT changed STREQUAL before_${group})
    message(FATAL_ERROR "WDK installer invalidated unrelated ${group} cache")
  endif()
endforeach()
file(WRITE "${source}/cmake/modules/sdk/Wdk.cmake" "${wdk_original}")
file(APPEND "${source}/cmake/modules/common/Download.cmake" "\n# shared download recipe control\n")
foreach(group qt arduino firmware-legal wdk)
  key("${group}" changed)
  if(changed STREQUAL before_${group})
    message(FATAL_ERROR "Download helper did not invalidate its ${group} consumer")
  endif()
endforeach()
key(qt before)
file(APPEND "${source}/cmake/modules/quality/StaticAnalysis.cmake" "\n# unrelated analysis control\n")
key(qt after)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unrelated analysis recipe invalidated Qt")
endif()
