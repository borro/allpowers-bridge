# All host-specific hook integration lives here and in Windows.cmake.
include_guard(GLOBAL)

function(ap_hook_setting name output)
  string(JSON value ERROR_VARIABLE error GET "${AP_HOOK_CONFIG}" "${name}")
  if(error)
    message(FATAL_ERROR "Missing hook setting ${name}; run cmake -P cmake/InstallGitHooks.cmake")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_host_tools config output)
  if(NOT EXISTS "${config}")
    message(FATAL_ERROR "Missing ${config}; run cmake -P cmake/InstallGitHooks.cmake")
  endif()
  file(READ "${config}" AP_HOOK_CONFIG)
  if(CMAKE_HOST_WIN32)
    ap_hook_setting(windowsNinja ninja)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    ap_hook_setting(linuxNinja ninja)
  else()
    message(FATAL_ERROR "Local hooks currently support Windows and Linux")
  endif()
  set(AP_HOOK_CONFIG "${AP_HOOK_CONFIG}" PARENT_SCOPE)
  set(${output} "${ninja}" PARENT_SCOPE)
endfunction()

function(ap_hook_tasks phase output)
  if(phase STREQUAL "commit")
    set(tasks audit format secrets whitespace linux-unit analysis linux-coverage sanitizers valgrind)
    if(CMAKE_HOST_WIN32)
      list(APPEND tasks windows-unit)
    endif()
  elseif(phase STREQUAL "push")
    set(tasks mutation fuzz)
    if(CMAKE_HOST_WIN32)
      list(APPEND tasks windows-coverage)
    endif()
  else()
    message(FATAL_ERROR "Unknown hook phase: ${phase}")
  endif()
  if(NOT CMAKE_HOST_WIN32)
    message(STATUS "Windows-only checks are performed by CI on this host")
  endif()
  set(${output} "${tasks}" PARENT_SCOPE)
endfunction()

function(ap_hook_linux_path path output)
  if(CMAKE_HOST_WIN32)
    ap_hook_setting(distribution distribution)
    execute_process(COMMAND wsl.exe -d "${distribution}" --exec wslpath -a -u "${path}"
      OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  else()
    set(value "${path}")
  endif()
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_command task output)
  if(task MATCHES "^(audit|format|secrets|whitespace)$")
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(windowsDeps deps)
    else()
      ap_hook_setting(linuxDeps deps)
    endif()
    set(command "${CMAKE_COMMAND}" "-DTASK=${task}" "-DROOT=${ROOT}" "-DSOURCE=${SOURCE}"
      "-DDEPS_DIR=${deps}" "-DWORK=${ROOT}/build/git-hooks/${task}-${CMAKE_HOST_SYSTEM_NAME}"
      -P "${ROOT}/cmake/HookQuickCheck.cmake")
  elseif(task MATCHES "^windows-")
    set(command "${CMAKE_COMMAND}" "-DROOT=${ROOT}" "-DSOURCE=${SOURCE}"
      "-DCONFIG=${CONFIG}" "-DTASK=${task}" -P "${ROOT}/.githooks/Windows.cmake")
  else()
    ap_hook_linux_path("${SOURCE}" source)
    ap_hook_linux_path("${ROOT}/cmake/RunHookCheck.cmake" script)
    foreach(key linuxCMake linuxNinja linuxDeps linuxCoverage tidy cppcheck mull)
      ap_hook_setting("${key}" "${key}")
    endforeach()
    set(command "${linuxCMake}" "-DROOT=${source}" "-DTASK=${task}" "-DNINJA=${linuxNinja}"
      "-DDEPS=${linuxDeps}" "-DTIDY=${tidy}" "-DCPPCHECK_ROOT=${cppcheck}"
      "-DMULL_ROOT=${mull}" "-DCOVERAGE_TOOL=${linuxCoverage}" -P "${script}")
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(distribution distribution)
      list(PREPEND command wsl.exe -d "${distribution}" --exec)
    endif()
  endif()
  set(${output} "${command}" PARENT_SCOPE)
endfunction()

function(ap_hook_cache build key output)
  set(cache "${ROOT}/build/${build}/CMakeCache.txt")
  if(NOT EXISTS "${cache}")
    message(FATAL_ERROR "Prepare ${build} or supply an existing hook CONFIG file")
  endif()
  file(STRINGS "${cache}" line REGEX "^${key}:[^=]+=" LIMIT_COUNT 1)
  if(NOT line)
    message(FATAL_ERROR "Missing ${key} in ${cache}")
  endif()
  string(REGEX REPLACE "^[^=]+=" "" value "${line}")
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_config_set key value)
  string(REPLACE "\\" "/" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(JSON config SET "${AP_HOOK_CONFIG}" "${key}" "\"${value}\"")
  set(AP_HOOK_CONFIG "${config}" PARENT_SCOPE)
endfunction()

function(ap_hook_install_host config output key_output)
  if(EXISTS "${config}")
    file(READ "${config}" AP_HOOK_CONFIG)
  else()
    set(AP_HOOK_CONFIG "{}")
  endif()
  set(fields_to_discover
    "linuxNinja|coverage-linux|CMAKE_MAKE_PROGRAM"
    "linuxCoverage|coverage-linux|ALLPOWERS_COVERAGE_TOOL"
    "linuxDeps|coverage-linux|ALLPOWERS_DEPS_DIR"
    "linuxCMake|coverage-linux|CMAKE_COMMAND"
    "tidy|static-analysis-linux|ALLPOWERS_CLANG_TIDY"
    "cppcheck|static-analysis-linux|ALLPOWERS_CPPCHECK_ROOT"
    "mull|mutation-linux|ALLPOWERS_MULL_ROOT")
  if(CMAKE_HOST_WIN32)
    list(APPEND fields_to_discover
      "windowsNinja|coverage-windows|CMAKE_MAKE_PROGRAM"
      "windowsCoverage|coverage-windows|ALLPOWERS_COVERAGE_TOOL"
      "windowsDeps|coverage-windows|ALLPOWERS_DEPS_DIR"
      "windowsPython|coverage-windows|_Python3_EXECUTABLE"
      "qt|coverage-windows|ALLPOWERS_QT_ROOT")
  endif()
  foreach(pair IN LISTS fields_to_discover)
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 build)
    list(GET fields 2 cache_key)
    string(JSON existing ERROR_VARIABLE missing GET "${AP_HOOK_CONFIG}" "${key}")
    if(missing)
      ap_hook_cache("${build}" "${cache_key}" value)
      ap_hook_config_set("${key}" "${value}")
    endif()
  endforeach()
  if(CMAKE_HOST_WIN32)
    string(JSON existing ERROR_VARIABLE missing GET "${AP_HOOK_CONFIG}" vcvars)
    if(missing)
      find_program(vswhere vswhere PATHS "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer" REQUIRED)
      execute_process(COMMAND "${vswhere}" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
        -property installationPath OUTPUT_VARIABLE vs OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
      ap_hook_config_set(vcvars "${vs}/VC/Auxiliary/Build/vcvars64.bat")
    endif()
    string(JSON existing ERROR_VARIABLE missing GET "${AP_HOOK_CONFIG}" distribution)
    if(missing)
      ap_hook_config_set(distribution Ubuntu)
    endif()
  endif()
  if(CMAKE_HOST_WIN32)
    string(JSON unused ERROR_VARIABLE missing GET "${AP_HOOK_CONFIG}" powershell)
    if(NOT missing)
      string(JSON AP_HOOK_CONFIG REMOVE "${AP_HOOK_CONFIG}" powershell)
    endif()
    ap_hook_config_set(windowsCMake "${CMAKE_COMMAND}")
    foreach(key vcvars windowsNinja windowsCoverage windowsPython qt windowsDeps)
      ap_hook_setting("${key}" value)
      if(NOT EXISTS "${value}")
        message(FATAL_ERROR "Missing local dependency: ${key}")
      endif()
    endforeach()
    set(config_key allpowers.hookCMakeWindows)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    ap_hook_config_set(linuxCMake "${CMAKE_COMMAND}")
    set(config_key allpowers.hookCMakeLinux)
  else()
    message(FATAL_ERROR "Local hooks currently support Windows and Linux")
  endif()
  foreach(key linuxCMake linuxNinja linuxCoverage tidy cppcheck mull linuxDeps)
    ap_hook_setting("${key}" value)
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(distribution distribution)
      execute_process(COMMAND wsl.exe -d "${distribution}" --exec test -e "${value}"
        COMMAND_ERROR_IS_FATAL ANY)
    elseif(NOT EXISTS "${value}")
      message(FATAL_ERROR "Missing local dependency: ${key}")
    endif()
  endforeach()
  set(${output} "${AP_HOOK_CONFIG}" PARENT_SCOPE)
  set(${key_output} "${config_key}" PARENT_SCOPE)
endfunction()
