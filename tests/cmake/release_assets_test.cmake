file(WRITE "${input}/firmware/pocket-096/manifest.json" "${changed}")
prepare(old-firmware fail)
file(WRITE "${input}/firmware/pocket-096/manifest.json" "${manifest}")
file(WRITE "${scratch}/sources/allpowers/VERSION" "1.2.3-alpha.6\n")
archive("${scratch}/sources" "AllpowersMonitor-${version}-sources-with-qt" allpowers)
prepare(old-sources fail)
file(WRITE "${scratch}/sources/allpowers/VERSION" "${version}\n")
archive("${scratch}/sources" "AllpowersMonitor-${version}-sources-with-qt" allpowers)
file(COPY_FILE "${scratch}/probe-build/Unversioned.exe" "${scratch}/runtime/${runtime}/AllpowersWidget.exe")
archive("${scratch}/runtime" "${runtime}" "${runtime}")
prepare(unversioned-exe fail)
execute_process(COMMAND "${powershell}" -NoProfile -File "${ROOT}/tests/cmake/release_publish_test.ps1"
  -Root "${ROOT}" -Work "${scratch}/publisher-tests" -Assets "${scratch}/output-valid" -Tag "v${version}"
  COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Release VERSIONINFO, source/firmware versions, hashes and publication guards passed")
