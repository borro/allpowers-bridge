cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
set(package "microsoft.windows.wdk.x64.${ALLPOWERS_WDK_VERSION}.nupkg")
if(NOT DEPS_DIR)
  message(FATAL_ERROR "Set DEPS_DIR to the dependency cache directory")
endif()
file(MAKE_DIRECTORY "${DEPS_DIR}/downloads")
file(LOCK "${DEPS_DIR}/wdk-${ALLPOWERS_WDK_VERSION}.lock" GUARD PROCESS TIMEOUT 180)
set(archive "${DEPS_DIR}/downloads/${package}")
if(NOT EXISTS "${archive}")
  file(DOWNLOAD "https://api.nuget.org/v3-flatcontainer/microsoft.windows.wdk.x64/${ALLPOWERS_WDK_VERSION}/${package}"
    "${archive}" EXPECTED_HASH "SHA256=${ALLPOWERS_WDK_SHA256}" TLS_VERIFY ON)
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL ALLPOWERS_WDK_SHA256)
  message(FATAL_ERROR "WDK package checksum mismatch")
endif()
set(destination "${DEPS_DIR}/wdk/${ALLPOWERS_WDK_VERSION}")
if(NOT EXISTS "${destination}/.complete" OR
    NOT EXISTS "${destination}/c/Include/wdf/kmdf/${ALLPOWERS_KMDF_VERSION}/wdf.h")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${destination}")
  file(WRITE "${destination}/.complete" "${ALLPOWERS_WDK_SHA256}\n")
endif()
