cmake_minimum_required(VERSION 4.4)
find_package(Git REQUIRED)
include("${ROOT}/cmake/modules/hooks/GitHookSupport.cmake")
unset(ENV{GIT_INDEX_FILE})
if(CASE STREQUAL "snapshot")
  ap_hook_snapshot(ROOT "${FIXTURE}" TREE "${TREE}" SOURCE "${FIXTURE}/build/snapshot" VERSION "1.2.3")
  return()
elseif(CASE STREQUAL "traversal")
  ap_hook_path(ROOT "${WORK}" PATH "${WORK}/../escape")
  return()
elseif(CASE STREQUAL "scheduler")
  ap_hook_ctest(BINARY "${WORK}/build" LOGS "${WORK}/fail-logs")
  return()
endif()
function(expect_failure)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" ${ARGN}
    -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(code EQUAL 0)
    message(FATAL_ERROR "A negative hook control unexpectedly passed")
  endif()
endfunction()
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(fixture "${WORK}/${nonce} repository with spaces")
file(MAKE_DIRECTORY "${fixture}")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS init -q)
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS config user.name "Hook regression")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS config user.email hooks@example.invalid)
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS config core.autocrlf false)
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS config core.hooksPath disabled-hooks)
file(WRITE "${fixture}/example.cpp" "original\n")
file(WRITE "${fixture}/remove.cpp" "delete me\n")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS add .)
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS commit -qm fixture)
ap_hook_git(OUTPUT first ROOT "${fixture}" ARGS rev-parse HEAD)
file(WRITE "${fixture}/example.cpp" "staged defect\n")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS add example.cpp)
file(WRITE "${fixture}/example.cpp" "unstaged repair\n")
ap_hook_git(OUTPUT tree ROOT "${fixture}" ARGS write-tree)
set(source "${fixture}/build/snapshot")
ap_hook_snapshot(ROOT "${fixture}" TREE "${tree}" SOURCE "${source}" VERSION "1.2.3-dirty")
file(READ "${source}/example.cpp" staged)
file(READ "${fixture}/example.cpp" working)
if(NOT staged STREQUAL "staged defect\n" OR NOT working STREQUAL "unstaged repair\n")
  message(FATAL_ERROR "Snapshot used or modified unstaged contents")
endif()
file(TIMESTAMP "${source}/example.cpp" before "%s" UTC)
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
ap_hook_snapshot(ROOT "${fixture}" TREE "${tree}" SOURCE "${source}" VERSION "1.2.3-dirty")
file(TIMESTAMP "${source}/example.cpp" after "%s" UTC)
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unchanged snapshot invalidated incremental builds")
endif()
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS rm -q remove.cpp)
ap_hook_git(OUTPUT next ROOT "${fixture}" ARGS write-tree)
if(next STREQUAL tree)
  message(FATAL_ERROR "Index update was not detected")
endif()
ap_hook_snapshot(ROOT "${fixture}" TREE "${next}" SOURCE "${source}" VERSION "1.2.3-dirty")
if(EXISTS "${source}/remove.cpp")
  message(FATAL_ERROR "Snapshot retained a staged deletion")
endif()
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS commit -qm next)
ap_hook_git(OUTPUT second ROOT "${fixture}" ARGS rev-parse HEAD)
string(REPEAT 0 40 zero)
file(WRITE "${fixture}/push-input" "refs/heads/old ${first} refs/heads/old ${zero}\nrefs/heads/new ${second} refs/heads/new ${zero}\n(delete) ${zero} refs/heads/deleted ${first}\nrefs/tags/duplicate ${second} refs/tags/duplicate ${zero}\n")
ap_hook_push_commits(OUTPUT commits ROOT "${fixture}" INPUT "${fixture}/push-input")
if(NOT commits STREQUAL "${first};${second}")
  message(FATAL_ERROR "Push ref selection is incorrect: ${commits}")
endif()
file(WRITE "${fixture}/.gitattributes" "example.cpp export-ignore\n")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS add .gitattributes)
ap_hook_git(OUTPUT tree ROOT "${fixture}" ARGS write-tree)
expect_failure(-DCASE=snapshot "-DFIXTURE=${fixture}" "-DTREE=${tree}")
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS reset -q HEAD -- .gitattributes)
file(REMOVE "${fixture}/.gitattributes")
ap_hook_git(OUTPUT blob ROOT "${fixture}" ARGS rev-parse HEAD:example.cpp)
ap_hook_git(OUTPUT unused ROOT "${fixture}" ARGS update-index --add --cacheinfo "120000,${blob},link")
ap_hook_git(OUTPUT tree ROOT "${fixture}" ARGS write-tree)
expect_failure(-DCASE=snapshot "-DFIXTURE=${fixture}" "-DTREE=${tree}")
expect_failure(-DCASE=traversal "-DWORK=${source}")

set(scheduler "${fixture}/scheduler")
file(MAKE_DIRECTORY "${scheduler}")
file(WRITE "${scheduler}/CMakeLists.txt" "cmake_minimum_required(VERSION 4.4)\nproject(Barrier NONE)\nenable_testing()\nadd_test(NAME one COMMAND \"${CMAKE_COMMAND}\" \"-DWORK=${scheduler}\" -DNAME=one -DOTHER=two -P \"${ROOT}/tests/cmake/hook_barrier.cmake\")\nadd_test(NAME two COMMAND \"${CMAKE_COMMAND}\" \"-DWORK=${scheduler}\" -DNAME=two -DOTHER=one \"-DFAIL=\${FAIL}\" -P \"${ROOT}/tests/cmake/hook_barrier.cmake\")\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scheduler}" -B "${scheduler}/build"
  -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}" -DFAIL=OFF COMMAND_ERROR_IS_FATAL ANY)
ap_hook_ctest(BINARY "${scheduler}/build" LOGS "${scheduler}/pass-logs")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scheduler}" -B "${scheduler}/build"
  -DFAIL=ON COMMAND_ERROR_IS_FATAL ANY)
expect_failure(-DCASE=scheduler "-DWORK=${scheduler}")
file(READ "${scheduler}/fail-logs/tests.xml" xml)
if(NOT xml MATCHES "failures=\"1\"")
  message(FATAL_ERROR "Child failure was not recorded")
endif()
message(STATUS "Hook controls passed: staged snapshot, deletions, timestamps, push refs, guards, parallel barrier and failure propagation")
