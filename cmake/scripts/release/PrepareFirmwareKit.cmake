cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Arguments.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Files.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Download.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/PublicSources.cmake")
foreach(required ROOT WORK OUTPUT DATA CACHE VERSION)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "Set ${required} for firmware corresponding-source packaging")
  endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT}")
set(sdk "${DATA}/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
set(binary_sdk "${DATA}/packages/esp32/tools/esp32s3-libs/${ALLPOWERS_ESP32_VERSION}")
set(toolchain "${DATA}/packages/esp32/tools/esp-x32/${ALLPOWERS_ESP32_TOOLCHAIN_VERSION}")
file(READ "${binary_sdk}/versions.txt" versions)
if(NOT versions MATCHES "esp-idf: v5.5.5 b774170ff46" OR NOT versions MATCHES "tinyusb: master 53f8c53c2")
  message(FATAL_ERROR "Firmware SDK changed: review corresponding sources and licenses")
endif()
file(MAKE_DIRECTORY "${CACHE}")
file(LOCK "${CACHE}/firmware-legal.lock" GUARD PROCESS TIMEOUT 600)
# Match the installed SDK to the checksum-pinned binary release before pairing
# its libraries with upstream corresponding sources. versions.txt alone is not
# evidence that the installed archives have not been modified.
set(sdk_archive "${CACHE}/esp32s3-libs-${ALLPOWERS_ESP32_VERSION}.zip")
if(NOT EXISTS "${sdk_archive}")
  set(download "${DATA}/staging/packages/esp32s3-libs-${ALLPOWERS_ESP32_VERSION}.zip")
  if(EXISTS "${download}")
    file(COPY_FILE "${download}" "${sdk_archive}")
  else()
    ap_download_verified(URL "https://github.com/espressif/arduino-esp32/releases/download/${ALLPOWERS_ESP32_VERSION}/esp32s3-libs-${ALLPOWERS_ESP32_VERSION}.zip" DESTINATION "${sdk_archive}"
  SHA256 "${ALLPOWERS_ESP32_S3_ARCHIVE_SHA256}" MISMATCH REPLACE TIMEOUT 600 INACTIVITY_TIMEOUT 60)
  endif()
endif()
file(SHA256 "${sdk_archive}" sdk_hash)
if(NOT sdk_hash STREQUAL ALLPOWERS_ESP32_S3_ARCHIVE_SHA256)
  message(FATAL_ERROR "Wrong ESP32-S3 binary SDK archive")
endif()
set(sdk_reference "${CACHE}/binary-reference/${sdk_hash}")
if(NOT EXISTS "${sdk_reference}/complete")
  file(ARCHIVE_EXTRACT INPUT "${sdk_archive}" DESTINATION "${sdk_reference}")
  file(WRITE "${sdk_reference}/complete" "${sdk_hash}\n")
endif()
function(ap_check_sdk_file)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "PATH;SDK;REFERENCE" "")
  ap_require_arguments(PREFIX AP REQUIRED PATH SDK REFERENCE)
  set(binary_sdk "${AP_SDK}")
  set(sdk_reference "${AP_REFERENCE}")
  set(path "${AP_PATH}")
  file(RELATIVE_PATH relative "${binary_sdk}" "${path}")
  set(reference "${sdk_reference}/esp32s3-libs/${relative}")
  if(NOT EXISTS "${reference}")
    message(FATAL_ERROR "SDK file has no pinned original: ${relative}")
  endif()
  file(SHA256 "${path}" actual)
  file(SHA256 "${reference}" expected)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Modified binary SDK: supply its actual corresponding source: ${relative}")
  endif()
endfunction()
file(GLOB_RECURSE sdk_metadata LIST_DIRECTORIES FALSE
  "${binary_sdk}/ld/*" "${binary_sdk}/flags/*")
list(APPEND sdk_metadata "${binary_sdk}/versions.txt" "${binary_sdk}/qio_opi/sections.ld")
foreach(path IN LISTS sdk_metadata)
  ap_check_sdk_file(SDK "${binary_sdk}" REFERENCE "${sdk_reference}" PATH "${path}")
endforeach()
set(payload "${WORK}/compliance")
file(REAL_PATH "${WORK}" work_root)
get_filename_component(payload_path "${payload}" ABSOLUTE)
if(EXISTS "${payload}")
  file(REAL_PATH "${payload}" payload_path)
endif()
cmake_path(IS_PREFIX work_root "${payload_path}" NORMALIZE inside_work)
if(NOT inside_work OR payload_path STREQUAL work_root)
  message(FATAL_ERROR "Firmware source staging must remain inside its build directory")
endif()
ap_remove_tree(ROOT "${work_root}" PATH "${payload_path}")
file(MAKE_DIRECTORY "${payload}/dependencies" "${payload}/licenses" "${payload}/relink/lib")
set(provenance "# Firmware dependency origins\n\n")
foreach(record IN LISTS ALLPOWERS_FIRMWARE_SOURCE_ARCHIVES ALLPOWERS_FIRMWARE_BINARY_LICENSES)
  string(REPLACE "|" ";" fields "${record}")
  list(GET fields 0 name)
  list(GET fields 1 url)
  list(GET fields 2 expected)
  set(archive "${CACHE}/${name}")
  if(NOT EXISTS "${archive}")
    ap_download_verified(URL "${url}" DESTINATION "${archive}"
  SHA256 "${expected}" MISMATCH REPLACE TIMEOUT 600 INACTIVITY_TIMEOUT 60)
  endif()
  file(SHA256 "${archive}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Wrong firmware license/source archive: ${name}")
  endif()
  string(APPEND provenance "- ${name}: ${url}\n  SHA256: ${expected}\n")
  list(LENGTH fields count)
  if(count EQUAL 3)
    file(COPY_FILE "${archive}" "${payload}/licenses/${name}" ONLY_IF_DIFFERENT)
    continue()
  endif()
  file(COPY_FILE "${archive}" "${payload}/dependencies/${name}" ONLY_IF_DIFFERENT)
  list(GET fields 3 top)
  set(extracted "${CACHE}/extracted/${expected}")
  if(NOT EXISTS "${extracted}/complete")
    file(MAKE_DIRECTORY "${extracted}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${extracted}")
    file(WRITE "${extracted}/complete" "${expected}\n")
  endif()
  set(source "${extracted}/${top}")
  if(name MATCHES "^arduino-esp32-")
    set(arduino_source "${source}")
  endif()
  file(GLOB_RECURSE upstream_files LIST_DIRECTORIES FALSE "${source}/*")
  foreach(path IN LISTS upstream_files)
    get_filename_component(base "${path}" NAME)
    string(TOLOWER "${base}" base)
    if(base MATCHES "licen[cs]e|copying|copyright|notice")
      file(RELATIVE_PATH relative "${source}" "${path}")
      get_filename_component(directory "${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${payload}/licenses/${name}/${directory}")
      file(COPY_FILE "${path}" "${payload}/licenses/${name}/${relative}" ONLY_IF_DIFFERENT)
    endif()
  endforeach()
endforeach()
foreach(part cores libraries variants)
  file(GLOB_RECURSE installed LIST_DIRECTORIES FALSE RELATIVE "${sdk}" "${sdk}/${part}/*")
  foreach(relative IN LISTS installed)
    if(relative STREQUAL "cores/esp32/core_version.h")
      continue() # Generated release header; copied into the source kit below.
    endif()
    if(NOT EXISTS "${arduino_source}/${relative}")
      message(FATAL_ERROR "Installed Arduino source has no corresponding source: ${relative}")
    endif()
    file(SHA256 "${sdk}/${relative}" installed_hash)
    file(SHA256 "${arduino_source}/${relative}" source_hash)
    if(NOT installed_hash STREQUAL source_hash)
      message(FATAL_ERROR "Modified Arduino SDK: supply its actual corresponding sources: ${relative}")
    endif()
  endforeach()
endforeach()
file(COPY_FILE "${sdk}/cores/esp32/core_version.h" "${payload}/dependencies/core_version.h" ONLY_IF_DIFFERENT)
file(COPY_FILE "${binary_sdk}/versions.txt" "${payload}/dependencies/versions.txt" ONLY_IF_DIFFERENT)
foreach(component gcc newlib)
  if(NOT IS_DIRECTORY "${toolchain}/share/licenses/${component}")
    message(FATAL_ERROR "Missing ${component} runtime license notices")
  endif()
  file(COPY "${toolchain}/share/licenses/${component}" DESTINATION "${payload}/licenses/toolchain")
endforeach()
file(COPY_FILE "${ROOT}/docs/firmware-licenses.md" "${payload}/README.md" ONLY_IF_DIFFERENT)
foreach(license LGPL-3.0 GPL-3.0)
  file(COPY_FILE "${ROOT}/docs/licenses/${license}.md" "${payload}/licenses/${license}.txt" ONLY_IF_DIFFERENT)
endforeach()
file(WRITE "${payload}/DEPENDENCIES.md" "${provenance}")

# Preserve only archives actually selected by the linker, and fail closed on new
# dependencies until their licensing has been reviewed. No map/build-options paths
# (which contain local user names) are distributed.
file(READ "${WORK}/compile/R2500Adapter.ino.map" map)
string(FIND "${map}" "Discarded input sections" end)
if(end LESS 0)
  message(FATAL_ERROR "Cannot inspect firmware link map")
endif()
string(SUBSTRING "${map}" 0 ${end} included)
string(REPLACE "\n" ";" lines "${included}")
set(libraries)
set(toolchain_libraries "")
foreach(line IN LISTS lines)
  if(NOT line MATCHES "^([^ \t].*\\.a)\\([^)]*\\)")
    continue()
  endif()
  string(REPLACE "\\" "/" archive "${CMAKE_MATCH_1}")
  get_filename_component(name "${archive}" NAME)
  if(NOT name IN_LIST ALLPOWERS_FIRMWARE_RELINK_LIBRARIES)
    message(FATAL_ERROR "Unreviewed firmware dependency: ${name}")
  endif()
  if(NOT name IN_LIST libraries)
    list(APPEND libraries "${name}")
    cmake_path(IS_PREFIX toolchain "${archive}" NORMALIZE from_toolchain)
    if(from_toolchain)
      file(REAL_PATH "${archive}" resolved)
      file(RELATIVE_PATH relative "${toolchain}" "${resolved}")
      string(APPEND toolchain_libraries "${name}|${relative}\n")
      continue() # GCC's runtime exception does not relicense standalone .a files.
    endif()
    cmake_path(IS_PREFIX binary_sdk "${archive}" NORMALIZE from_sdk)
    if(from_sdk)
      ap_check_sdk_file(SDK "${binary_sdk}" REFERENCE "${sdk_reference}" PATH "${archive}")
    endif()
    file(COPY_FILE "${archive}" "${payload}/relink/lib/${name}" ONLY_IF_DIFFERENT)
  endif()
endforeach()
list(LENGTH libraries count)
if(count LESS 20 OR NOT "core.a" IN_LIST libraries)
  message(FATAL_ERROR "Incomplete firmware relinking library inventory")
endif()
list(SORT libraries)
string(REPLACE ";" "\n" inventory "${libraries}")
file(WRITE "${payload}/relink/LIBRARIES.txt" "${inventory}\n")
file(WRITE "${payload}/relink/TOOLCHAIN-LIBRARIES.txt" "${toolchain_libraries}")
file(READ "${binary_sdk}/flags/ld_libs" ordered_flags)
separate_arguments(ordered_flags UNIX_COMMAND "${ordered_flags}")
set(link_libraries "core.a\n")
foreach(flag IN LISTS ordered_flags)
  if(flag MATCHES "^-l(.+)$")
    set(name "lib${CMAKE_MATCH_1}.a")
    if(name IN_LIST libraries)
      string(APPEND link_libraries "${name}\n")
    endif()
  endif()
endforeach()
file(WRITE "${payload}/relink/LINK-LIBRARIES.txt" "${link_libraries}")
file(GLOB_RECURSE objects RELATIVE "${WORK}/compile" "${WORK}/compile/sketch/*.o" "${WORK}/compile/libraries/*.o")
foreach(object IN LISTS objects)
  get_filename_component(parent "${object}" DIRECTORY)
  file(MAKE_DIRECTORY "${payload}/relink/objects/${parent}")
  file(COPY_FILE "${WORK}/compile/${object}" "${payload}/relink/objects/${object}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY "${binary_sdk}/ld" DESTINATION "${payload}/relink")
file(COPY_FILE "${binary_sdk}/qio_opi/sections.ld" "${payload}/relink/ld/sections.ld" ONLY_IF_DIFFERENT)
file(COPY_FILE "${binary_sdk}/flags/ld_flags" "${payload}/relink/ld_flags" ONLY_IF_DIFFERENT)
file(COPY_FILE "${binary_sdk}/flags/ld_scripts" "${payload}/relink/ld_scripts" ONLY_IF_DIFFERENT)
file(COPY_FILE "${ROOT}/cmake/scripts/release/RelinkFirmware.cmake" "${payload}/relink/RelinkFirmware.cmake" ONLY_IF_DIFFERENT)
execute_process(COMMAND "${CMAKE_COMMAND}" "-DTOOLCHAIN=${toolchain}" "-DKIT=${payload}/relink"
  -P "${ROOT}/cmake/scripts/release/RelinkFirmware.cmake" COMMAND_ERROR_IS_FATAL ANY)

ap_public_sources(OUTPUT public_files ROOT "${ROOT}")
foreach(name IN LISTS public_files)
  get_filename_component(parent "${name}" DIRECTORY)
  file(MAKE_DIRECTORY "${payload}/allpowers/${parent}")
  file(COPY_FILE "${ROOT}/${name}" "${payload}/allpowers/${name}" ONLY_IF_DIFFERENT)
endforeach()
string(REPLACE ";" "\n" inventory "${public_files}")
file(WRITE "${payload}/allpowers/SOURCE_FILES" "${inventory}\n")
file(WRITE "${payload}/allpowers/VERSION" "${VERSION}\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${OUTPUT}/corresponding-source.zip"
  --format=zip -- allpowers dependencies licenses relink README.md DEPENDENCIES.md
  WORKING_DIRECTORY "${payload}" COMMAND_ERROR_IS_FATAL ANY)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/CollectFirmwareNotices.cmake")
ap_collect_firmware_notices(ROOT "${ROOT}" WORK "${WORK}" OUTPUT "${OUTPUT}" DATA "${DATA}" CACHE "${CACHE}")
file(COPY_FILE "${ROOT}/docs/firmware-licenses.md" "${OUTPUT}/FIRMWARE-LICENSES.md" ONLY_IF_DIFFERENT)
