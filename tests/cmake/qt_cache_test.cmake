cmake_minimum_required(VERSION 4.4)
file(TO_CMAKE_PATH "${ROOT}" ROOT)
file(TO_CMAKE_PATH "${WORK}" WORK)
# New fixtures per run; never operate on an installed SDK.
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(scratch "${WORK}/${suffix}")
set(source "${scratch}/source")
file(MAKE_DIRECTORY "${source}/cmake")
foreach(recipe Dependencies.cmake QtStatic.cmake WindowsCompiler.cmake SizeOptimization.cmake
    DependencyFingerprint.cmake QtCache.cmake QtCacheProbe.cmake QtCacheImports.cmake
    qt_cache_probe.cpp QtSourceIdentity.cmake)
  configure_file("${ROOT}/cmake/${recipe}" "${source}/cmake/${recipe}" COPYONLY)
endforeach()
set(ENV{GITHUB_OUTPUT} "${scratch}/outputs.txt")
function(cache mode output)
  file(WRITE "$ENV{GITHUB_OUTPUT}" "")
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DMODE=${mode}" "-DROOT=${source}"
    -P "${source}/cmake/QtCache.cmake" COMMAND_ERROR_IS_FATAL ANY)
  file(READ "$ENV{GITHUB_OUTPUT}" result)
  set(${output} "${result}" PARENT_SCOPE)
endfunction()
function(get_key output)
  cache(Key result)
  string(REGEX MATCH "key=qt-static-v4-windows-x64-[0-9a-f]+" key "${result}")
  if(NOT key)
    message(FATAL_ERROR "Missing Qt cache key")
  endif()
  set(${output} "${key}" PARENT_SCOPE)
endfunction()
get_key(baseline)
get_key(repeated)
if(NOT repeated STREQUAL baseline)
  message(FATAL_ERROR "Identical inputs did not produce a stable key")
endif()
foreach(name UCRTVersion WindowsSDKVersion VCToolsVersion)
  set(saved "$ENV{${name}}")
  set(ENV{${name}} "0.0.0.0")
  get_key(changed)
  set(ENV{${name}} "${saved}")
  if(changed STREQUAL baseline)
    message(FATAL_ERROR "${name} did not invalidate the key")
  endif()
endforeach()
file(READ "${source}/cmake/DependencyFingerprint.cmake" helper)
string(REPLACE "set(recipes PrepareFirmwareKit.cmake "
  "set(recipes FirmwareOnlyFixture.cmake PrepareFirmwareKit.cmake " changed "${helper}")
if(changed STREQUAL helper)
  message(FATAL_ERROR "Firmware helper fixture did not change")
endif()
file(WRITE "${source}/cmake/DependencyFingerprint.cmake" "${changed}")
get_key(changed_key)
file(WRITE "${source}/cmake/DependencyFingerprint.cmake" "${helper}")
if(NOT changed_key STREQUAL baseline)
  message(FATAL_ERROR "Firmware helper recipe invalidated unrelated Qt SDK")
endif()
file(READ "${source}/cmake/Dependencies.cmake" dependencies)
foreach(name ALLPOWERS_MULL_VERSION ALLPOWERS_ESP32_VERSION ALLPOWERS_QT_VERSION
    ALLPOWERS_QTBASE_SHA256 ALLPOWERS_CXX_STANDARD)
  string(REGEX REPLACE "(set\\(${name} +)\"[^\"]+\"(\\))"
    "\\1\"cache-test-change\"\\2" changed "${dependencies}")
  if(changed STREQUAL dependencies)
    message(FATAL_ERROR "${name} fixture did not change")
  endif()
  file(WRITE "${source}/cmake/Dependencies.cmake" "${changed}")
  get_key(changed_key)
  file(WRITE "${source}/cmake/Dependencies.cmake" "${dependencies}")
  if(name MATCHES "(MULL|ESP32)")
    if(NOT changed_key STREQUAL baseline)
      message(FATAL_ERROR "${name} invalidated unrelated Qt SDK")
    endif()
  elseif(changed_key STREQUAL baseline)
    message(FATAL_ERROR "${name} did not invalidate the Qt SDK")
  endif()
endforeach()
foreach(recipe QtStatic.cmake SizeOptimization.cmake)
  get_key(before)
  file(APPEND "${source}/cmake/${recipe}" "\n# changed build recipe\n")
  get_key(after)
  if(before STREQUAL after)
    message(FATAL_ERROR "${recipe} did not invalidate the key")
  endif()
endforeach()
set(install "${source}/build/windows/deps/qt/install")
foreach(fixture absent incomplete incompatible malformed)
  if(NOT fixture STREQUAL "absent")
    file(MAKE_DIRECTORY "${install}")
    file(WRITE "${install}/sentinel" "incomplete SDK")
    if(fixture STREQUAL "incompatible")
      file(WRITE "${install}/allpowers-qt-cache.json" "{\"key\":\"incompatible\",\"fingerprint\":\"incompatible\"}")
    elseif(fixture STREQUAL "malformed")
      file(WRITE "${install}/allpowers-qt-cache.json" "invalid json")
    endif()
  endif()
  cache(Restore result)
  if(NOT result STREQUAL "root=\n" OR EXISTS "${install}")
    message(FATAL_ERROR "${fixture} SDK must request a source build")
  endif()
endforeach()
file(GLOB rejected "${source}/build/windows/qt-cache-rejected-*")
list(LENGTH rejected count)
if(NOT count EQUAL 3)
  message(FATAL_ERROR "Rejected SDKs were not preserved for diagnostics")
endif()
message(STATUS "Qt cache identity, invalidation, misses and quarantine checks passed")

# Exercise Seal/Restore's successful subprocess and JSON round trip with an
# intentionally synthetic probe, then prove a failed runtime check rejects it.
file(WRITE "${source}/cmake/QtSourceIdentity.cmake" "message(STATUS \"Synthetic SDK identity fixture\")\n")
file(WRITE "${source}/cmake/QtCacheProbe.cmake" [=[
cmake_minimum_required(VERSION 4.4)
project(SyntheticSdkProbe LANGUAGES NONE)
enable_testing()
if(DEFINED ENV{ALLPOWERS_QT_TEST_FAIL})
  add_test(NAME synthetic-sdk COMMAND "${CMAKE_COMMAND}" -E false)
else()
  add_test(NAME synthetic-sdk COMMAND "${CMAKE_COMMAND}" -E true)
endif()
]=])
file(MAKE_DIRECTORY "${install}")
cache(Seal unused)
cache(Restore restored)
if(NOT restored STREQUAL "root=${install}\n")
  message(FATAL_ERROR "Sealed synthetic SDK did not survive manifest round trip and revalidation")
endif()
set(ENV{ALLPOWERS_QT_TEST_FAIL} 1)
cache(Restore rejected)
if(NOT rejected STREQUAL "root=\n" OR EXISTS "${install}")
  message(FATAL_ERROR "Failing SDK runtime probe was accepted")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=Seal "-DROOT=${source}"
  -P "${source}/cmake/QtCache.cmake" RESULT_VARIABLE failed_seal OUTPUT_QUIET ERROR_QUIET)
if(failed_seal STREQUAL "0" OR EXISTS "${install}/allpowers-qt-cache.json")
  message(FATAL_ERROR "Failing SDK probe must not seal a cache")
endif()
unset(ENV{ALLPOWERS_QT_TEST_FAIL})
message(STATUS "Qt cache seal, verified restore and failed runtime controls passed")
