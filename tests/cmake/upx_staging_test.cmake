cmake_minimum_required(VERSION 4.4)
file(MAKE_DIRECTORY "${WORK}/build/_CPack_Packages" "${WORK}/outside")
file(WRITE "${WORK}/outside/AllpowersMonitor.exe" "Original executable fixture\n")
file(SHA256 "${WORK}/outside/AllpowersMonitor.exe" original)
function(reject stage expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DALLPOWERS_ROOT=${ROOT}"
    "-DALLPOWERS_BUILD_ROOT=${WORK}/build" "-DALLPOWERS_DEPS_DIR=${WORK}/deps"
    "-DCPACK_PACKAGE_DIRECTORY=${WORK}/build"
    "-DCPACK_TEMPORARY_DIRECTORY=${stage}" -DCPACK_PACKAGE_VERSION=1.2.3
    -P "${ROOT}/cmake/scripts/release/PackWindows.cmake" RESULT_VARIABLE result
    OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "${expected}")
    message(FATAL_ERROR "Unexpected UPX staging result: ${result}\n${output}${error}")
  endif()
endfunction()
reject("${WORK}/outside" "only a CPack staging")
reject("${WORK}/build/_CPack_Packages/../../outside" "only a CPack staging")
reject("${WORK}/build/_CPack_Packages" "only a CPack staging")
file(MAKE_DIRECTORY "${WORK}/build/_CPack_Packages/missing")
file(WRITE "${WORK}/build/_CPack_Packages/missing/AllpowersMonitor.exe" "Incomplete stage\n")
reject("${WORK}/build/_CPack_Packages/missing" "Missing or symlinked staged")
file(SHA256 "${WORK}/outside/AllpowersMonitor.exe" after)
if(NOT after STREQUAL original OR EXISTS "${WORK}/deps")
  message(FATAL_ERROR "Rejected UPX stage changed original files or downloaded tools")
endif()
message(STATUS "UPX rejects original paths, traversal, package root and incomplete stages before mutation")

# Exercise the production install rules with two builds exporting to one release
# directory. CPack must take the selected build's files, not the last export.
set(source "${WORK}/package-source")
set(binary "${WORK}/package-build")
set(release "${WORK}/shared-release")
set(stage "${WORK}/package-stage")
file(MAKE_DIRECTORY "${source}/cmake" "${source}/apps/windows")
file(COPY "${ROOT}/cmake" DESTINATION "${source}")
file(WRITE "${source}/cmake/modules/sdk/QtStatic.cmake" [=[
include(ExternalProject)
function(ap_add_qt_sdk)
  add_custom_target(qt-static)
endfunction()
function(ap_dependency_fingerprint)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "GROUP;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED GROUP OUTPUT ALLOW_EMPTY GROUP OUTPUT)
  set(kind "${AP_GROUP}")
  set(output "${AP_OUTPUT}")
  set(${output} fixture PARENT_SCOPE)
endfunction()
]=])
file(WRITE "${source}/cmake/modules/products/UpsDriver.cmake" "function(ap_add_windows_driver)\n  add_custom_target(ups-driver-project)\nendfunction()\n")
file(WRITE "${source}/apps/windows/CMakeLists.txt" "# Never built: install routing fixture only.\n")
file(WRITE "${source}/CMakeLists.txt" [=[
cmake_minimum_required(VERSION 4.4)
project(PackageRouting NONE)
set(ALLPOWERS_VERSION 1.2.3)
include(cmake/modules/products/WindowsMonitor.cmake)
ap_add_windows_product(ROOT "${PROJECT_SOURCE_DIR}" BUILD_ROOT "${PROJECT_BINARY_DIR}")
include(cmake/modules/release/Windows.cmake)
ap_add_windows_packaging(ROOT "${PROJECT_SOURCE_DIR}" BUILD_ROOT "${PROJECT_BINARY_DIR}")
]=])
if(NOT NINJA)
  find_program(NINJA ninja REQUIRED)
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${NINJA}" "-DALLPOWERS_RELEASE_DIR=${release}" -DBUILD_TESTING=OFF
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Package routing fixture configuration failed: ${output}${error}")
endif()
file(MAKE_DIRECTORY "${binary}/windows-monitor" "${release}/windows/AllpowersMonitor")
foreach(exe AllpowersMonitor AllpowersWidget)
  file(WRITE "${binary}/windows-monitor/${exe}.exe" "Selected build: ${exe}\n")
  file(WRITE "${release}/windows/AllpowersMonitor/${exe}.exe" "Other build: ${exe}\n")
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" --install "${binary}" --prefix "${stage}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Package routing fixture install failed: ${output}${error}")
endif()
foreach(exe AllpowersMonitor AllpowersWidget)
  file(READ "${stage}/${exe}.exe" packaged)
  file(READ "${release}/windows/AllpowersMonitor/${exe}.exe" exported)
  if(NOT packaged STREQUAL "Selected build: ${exe}\n" OR NOT exported STREQUAL "Other build: ${exe}\n")
    message(FATAL_ERROR "Packaging ${exe} consumed or modified another build's export")
  endif()
endforeach()
message(STATUS "Packaging uses its own build even when another build overwrites the shared release directory")
