cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
file(REAL_PATH "${ROOT}/build" build_root)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" work_path)
set(payload_path "${work_path}/payload")
if(EXISTS "${payload_path}")
  file(REAL_PATH "${payload_path}" payload_path)
endif()
cmake_path(IS_PREFIX build_root "${payload_path}" NORMALIZE inside_build)
if(NOT inside_build)
  message(FATAL_ERROR "Source-package staging must stay inside the project's build directory")
endif()
file(REMOVE_RECURSE "${payload_path}")
file(MAKE_DIRECTORY "${WORK}/payload/allpowers" "${WORK}/payload/qt-source" "${OUTPUT}")
set(payload "${WORK}/payload")
foreach(directory core firmware apps tests tools config docs cmake .github)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${ROOT}" "${ROOT}/${directory}/*")
  foreach(name IN LISTS files)
    if(name MATCHES "/(__pycache__|build|data)/" OR name MATCHES "\\.(pyc|pyd|exe|bin|dll|sqlite3|log)$")
      continue()
    endif()
    get_filename_component(parent "${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${payload}/allpowers/${parent}")
    file(COPY_FILE "${ROOT}/${name}" "${payload}/allpowers/${name}" ONLY_IF_DIFFERENT)
  endforeach()
endforeach()
foreach(name LICENSE README.md README.ru.md AGENTS.md CONTRIBUTING.md THIRD_PARTY_NOTICES.md
    CMakeLists.txt CMakePresets.json .gitignore .gitattributes .editorconfig .clang-format)
  file(COPY_FILE "${ROOT}/${name}" "${payload}/allpowers/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(WRITE "${payload}/allpowers/VERSION" "${VERSION}\n")
foreach(module qtbase qtconnectivity)
  set(name "${module}-everywhere-src-${ALLPOWERS_QT_VERSION}.tar.xz")
  string(TOUPPER "${module}" key)
  file(SHA256 "${SOURCE_CACHE}/${name}" actual)
  if(NOT actual STREQUAL ALLPOWERS_${key}_SHA256)
    message(FATAL_ERROR "Qt corresponding-source hash mismatch: ${name}")
  endif()
  file(COPY_FILE "${SOURCE_CACHE}/${name}" "${payload}/qt-source/${name}" ONLY_IF_DIFFERENT)
endforeach()
set(config "${WORK}/CPackSourceConfig.cmake")
file(WRITE "${config}"
  "set(CPACK_GENERATOR ZIP)\nset(CPACK_PACKAGE_NAME AllpowersMonitor)\n"
  "set(CPACK_PACKAGE_VERSION \"${VERSION}\")\nset(CPACK_PACKAGE_DESCRIPTION_SUMMARY \"ALLPOWERS corresponding application and Qt sources\")\n"
  "set(CPACK_PACKAGE_DESCRIPTION_FILE \"${ROOT}/README.md\")\n"
  "set(CPACK_PACKAGE_FILE_NAME \"AllpowersMonitor-${VERSION}-sources\")\n"
  "set(CPACK_PACKAGE_DIRECTORY \"${OUTPUT}\")\nset(CPACK_PACKAGE_CHECKSUM SHA256)\n"
  "set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)\nset(CPACK_INSTALLED_DIRECTORIES \"${payload};/\")\n")
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${config}" COMMAND_ERROR_IS_FATAL ANY)
