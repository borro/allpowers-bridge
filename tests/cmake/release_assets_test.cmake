cmake_minimum_required(VERSION 4.4)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside_build)
if(NOT inside_build OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Release tests require a dedicated binary subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
set(version "1.2.3-alpha.7+build.01")
set(input "${scratch}/input")
file(MAKE_DIRECTORY "${scratch}/probe/assets" "${input}")
file(COPY "${ROOT}/apps/windows/assets/allpowers.ico" DESTINATION "${scratch}/probe/assets")
file(WRITE "${scratch}/probe/main.cpp" "int main() { return 0; }\n")
file(CONFIGURE OUTPUT "${scratch}/probe/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(VersionResourceProbe LANGUAGES CXX RC)
set(ALLPOWERS_VERSION "@version@")
set(ALLPOWERS_RC_VERSION "1,2,3")
foreach(app AllpowersMonitor AllpowersWidget)
  set(ALLPOWERS_EXE_NAME "${app}")
  set(ALLPOWERS_EXE_DESCRIPTION "${app}")
  configure_file("@ROOT@/apps/windows/app.rc.in" "${app}.rc" @ONLY)
  add_executable(${app} main.cpp "${CMAKE_CURRENT_BINARY_DIR}/${app}.rc")
endforeach()
add_executable(Unversioned main.cpp)
]=] @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scratch}/probe" -B "${scratch}/probe-build"
  -G Ninja "-DCMAKE_CXX_COMPILER=${CXX}" -DCMAKE_BUILD_TYPE=Release -DCMAKE_TRY_COMPILE_CONFIGURATION=Release
  OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${scratch}/probe-build"
  OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
find_program(powershell NAMES pwsh powershell REQUIRED)
foreach(app AllpowersMonitor AllpowersWidget)
  execute_process(COMMAND "${powershell}" -NoProfile -File "${ROOT}/cmake/CheckExeVersion.ps1"
    -Path "${scratch}/probe-build/${app}.exe" -ExpectedVersion "${version}"
    OUTPUT_QUIET COMMAND_ERROR_IS_FATAL ANY)
endforeach()
execute_process(COMMAND "${powershell}" -NoProfile -File "${ROOT}/cmake/CheckExeVersion.ps1"
  -Path "${scratch}/probe-build/AllpowersMonitor.exe" -ExpectedVersion "1.2.3-alpha.8"
  RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0)
  message(FATAL_ERROR "Wrong EXE prerelease version was accepted")
endif()
set(runtime "AllpowersMonitor-${version}-win-x64")
file(MAKE_DIRECTORY "${scratch}/runtime/${runtime}" "${scratch}/sources/allpowers")
foreach(app AllpowersMonitor AllpowersWidget)
  file(COPY_FILE "${scratch}/probe-build/${app}.exe" "${scratch}/runtime/${runtime}/${app}.exe")
endforeach()
function(archive base name directory)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${input}/${name}.zip" --format=zip -- "${directory}"
    WORKING_DIRECTORY "${base}" COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${input}/${name}.zip" hash)
  file(WRITE "${input}/${name}.zip.sha256" "${hash}  ${name}.zip\n")
endfunction()
archive("${scratch}/runtime" "${runtime}" "${runtime}")
file(WRITE "${scratch}/sources/allpowers/VERSION" "${version}\n")
archive("${scratch}/sources" "AllpowersMonitor-${version}-sources-with-qt" allpowers)
file(READ "${ROOT}/tests/fixtures/usb-contract.json" contract)
string(JSON descriptor GET "${contract}" descriptor_sha256)
string(JSON partitions GET "${contract}" partitions)
foreach(board waveshare-147 pocket-096)
  set(folder "${input}/firmware/${board}")
  file(MAKE_DIRECTORY "${folder}")
  set(files "{}")
  foreach(name R2500Adapter.ino.bin R2500Adapter.ino.bootloader.bin
      R2500Adapter.ino.partitions.bin boot_app0.bin LICENSE THIRD_PARTY_NOTICES.md
      ESP32-Arduino-LICENSE.md FIRMWARE-LICENSES.md licenses.zip corresponding-source.zip)
    file(WRITE "${folder}/${name}" "Synthetic release test; NOT a firmware image.\n")
    if(name STREQUAL "R2500Adapter.ino.bin")
      file(APPEND "${folder}/${name}" "ALLPOWERS_HISTORY_R12_W2_S32\n")
    endif()
    file(SHA256 "${folder}/${name}" hash)
    string(JSON files SET "${files}" "${name}" "\"${hash}\"")
  endforeach()
  set(manifest "{\"board\":\"${board}\",\"project_version\":\"${version}\",\"maintenance\":\"BOOT-R2500!!\",\"efuse_writes\":false,\"descriptor_sha256\":\"${descriptor}\"}")
  string(JSON manifest SET "${manifest}" partitions "${partitions}")
  string(JSON manifest SET "${manifest}" files "${files}")
  string(JSON manifest SET "${manifest}" history_storage
    "{\"schema\":1,\"read_versions\":[1,2],\"write_version\":2,\"record_bytes\":32,\"capability\":\"ALLPOWERS_HISTORY_R12_W2_S32\"}")
  file(WRITE "${folder}/manifest.json" "${manifest}\n")
endforeach()
function(prepare name expected)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DINPUT=${input}" "-DOUTPUT=${scratch}/output-${name}"
    "-DTAG=v${version}" -P "${ROOT}/cmake/PrepareRelease.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(expected STREQUAL pass AND NOT result EQUAL 0)
    message(FATAL_ERROR "Valid release assets rejected: ${output}${error}")
  elseif(expected STREQUAL fail AND result EQUAL 0)
    message(FATAL_ERROR "Invalid release assets accepted: ${name}")
  endif()
endfunction()
prepare(valid pass)
file(READ "${input}/firmware/pocket-096/manifest.json" complete_manifest)
string(JSON incomplete_manifest REMOVE "${complete_manifest}" files corresponding-source.zip)
file(WRITE "${input}/firmware/pocket-096/manifest.json" "${incomplete_manifest}")
prepare(missing-firmware-sources fail)
file(WRITE "${input}/firmware/pocket-096/manifest.json" "${complete_manifest}")
file(GLOB assets "${scratch}/output-valid/*.zip" "${scratch}/output-valid/*.exe"
  "${scratch}/output-valid/*.sha256" "${scratch}/output-valid/SHA256SUMS")
list(LENGTH assets count)
if(NOT count EQUAL 6)
  message(FATAL_ERROR "Release is missing assets/checksums")
endif()
file(GLOB redundant "${scratch}/output-valid/*-win-x64.zip" "${scratch}/output-valid/*.sha256")
if(redundant)
  message(FATAL_ERROR "Release contains duplicate runtime ZIP or checksum sidecars")
endif()
file(STRINGS "${scratch}/output-valid/SHA256SUMS" checksum_records)
list(LENGTH checksum_records checksum_count)
if(NOT checksum_count EQUAL 5)
  message(FATAL_ERROR "SHA256SUMS must cover the five distinct release payloads")
endif()
file(APPEND "${input}/firmware/waveshare-147/boot_app0.bin" "Tampered\n")
prepare(tampered fail)
file(WRITE "${input}/firmware/waveshare-147/boot_app0.bin" "Synthetic release test; NOT a firmware image.\n")
file(READ "${input}/firmware/pocket-096/manifest.json" manifest)
