cmake_minimum_required(VERSION 4.4)
include_guard(GLOBAL)
find_package(Git REQUIRED)

function(ap_hook_git output root)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" ${ARGN}
    OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  set(${output} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_path root path)
  cmake_path(ABSOLUTE_PATH root NORMALIZE OUTPUT_VARIABLE base)
  cmake_path(ABSOLUTE_PATH path NORMALIZE OUTPUT_VARIABLE target)
  cmake_path(IS_PREFIX base "${target}" NORMALIZE inside)
  if(NOT inside OR base STREQUAL target)
    message(FATAL_ERROR "Hook path escapes its workspace: ${target}")
  endif()
  set(cursor "${target}")
  while(NOT cursor STREQUAL base)
    if(IS_SYMLINK "${cursor}")
      message(FATAL_ERROR "Hook path contains a symlink: ${cursor}")
    endif()
    get_filename_component(cursor "${cursor}" DIRECTORY)
  endwhile()
endfunction()

function(ap_hook_snapshot root tree source version)
  ap_hook_path("${root}" "${source}")
  ap_hook_git(entries "${root}" -c core.quotepath=false ls-tree -r "${tree}")
  if(entries MATCHES ";")
    message(FATAL_ERROR "Snapshot paths must not contain semicolons")
  endif()
  string(REPLACE "\n" ";" entries "${entries}")
  set(files)
  set(objects)
  set(names)
  foreach(entry IN LISTS entries)
    if(NOT entry MATCHES "^100(644|755) blob ([0-9a-f]+)\t([A-Za-z0-9_. /-]+)$")
      message(FATAL_ERROR "Snapshots require regular files with portable paths")
    endif()
    set(object "${CMAKE_MATCH_2}")
    set(name "${CMAKE_MATCH_3}")
    string(TOLOWER "${name}" lower)
    if(name MATCHES "(^|/)([.][.]?|[.]git|build|dist)(/|$)" OR
        IS_ABSOLUTE "${name}" OR name MATCHES "^(VERSION|SOURCE_FILES)$" OR lower IN_LIST names)
      message(FATAL_ERROR "Unsafe or duplicate snapshot path: ${name}")
    endif()
    list(APPEND files "${name}")
    list(APPEND objects "${object}")
    list(APPEND names "${lower}")
  endforeach()
  get_filename_component(parent "${source}" DIRECTORY)
  string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
  set(temporary "${parent}/snapshot-${nonce}")
  ap_hook_path("${root}" "${temporary}")
  file(MAKE_DIRECTORY "${temporary}/files")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" archive --format=tar
    "--output=${temporary}/snapshot.tar" "${tree}" COMMAND_ERROR_IS_FATAL ANY)
  file(ARCHIVE_EXTRACT INPUT "${temporary}/snapshot.tar" DESTINATION "${temporary}/files")
  set(paths "")
  foreach(name IN LISTS files)
    string(APPEND paths "${temporary}/files/${name}\n")
  endforeach()
  file(WRITE "${temporary}/paths" "${paths}")
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" hash-object --no-filters --stdin-paths
    INPUT_FILE "${temporary}/paths" OUTPUT_VARIABLE hashes OUTPUT_STRIP_TRAILING_WHITESPACE
    RESULT_VARIABLE code ERROR_VARIABLE error)
  string(REPLACE "\n" ";" hashes "${hashes}")
  if(NOT code EQUAL 0 OR NOT hashes STREQUAL objects)
    file(REMOVE_RECURSE "${temporary}")
    message(FATAL_ERROR "Snapshot differs from Git blobs; check archive attributes. ${error}")
  endif()
  file(MAKE_DIRECTORY "${source}")
  if(EXISTS "${source}/SOURCE_FILES")
    file(STRINGS "${source}/SOURCE_FILES" previous)
    foreach(old IN LISTS previous)
      if(NOT old IN_LIST files)
        ap_hook_path("${source}" "${source}/${old}")
        file(REMOVE "${source}/${old}")
      endif()
    endforeach()
  endif()
  foreach(name IN LISTS files)
    ap_hook_path("${source}" "${source}/${name}")
    get_filename_component(directory "${source}/${name}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    file(COPY_FILE "${temporary}/files/${name}" "${source}/${name}" ONLY_IF_DIFFERENT)
  endforeach()
  list(JOIN files "\n" inventory)
  file(CONFIGURE OUTPUT "${source}/SOURCE_FILES" CONTENT "${inventory}\n" @ONLY)
  file(CONFIGURE OUTPUT "${source}/VERSION" CONTENT "${version}\n" @ONLY)
  file(REMOVE_RECURSE "${temporary}")
endfunction()

function(ap_hook_push_commits output root input)
  file(STRINGS "${input}" lines)
  set(commits)
  foreach(line IN LISTS lines)
    if(NOT line)
      continue()
    endif()
    if(NOT line MATCHES "^[^ ]+ ([0-9a-f]+) [^ ]+ ([0-9a-f]+)$")
      message(FATAL_ERROR "Invalid Git pre-push input")
    endif()
    set(local "${CMAKE_MATCH_1}")
    set(remote "${CMAKE_MATCH_2}")
    foreach(hash IN ITEMS "${local}" "${remote}")
      string(LENGTH "${hash}" length)
      if(NOT length EQUAL 40 AND NOT length EQUAL 64)
        message(FATAL_ERROR "Invalid Git object ID")
      endif()
    endforeach()
    if(local MATCHES "^0+$")
      continue()
    endif()
    ap_hook_git(commit "${root}" rev-parse --verify "${local}^{commit}")
    list(APPEND commits "${commit}")
  endforeach()
  list(REMOVE_DUPLICATES commits)
  set(${output} "${commits}" PARENT_SCOPE)
endfunction()

function(ap_hook_ctest binary logs)
  file(MAKE_DIRECTORY "${logs}")
  execute_process(COMMAND "${CMAKE_CTEST_COMMAND}" --test-dir "${binary}"
    --parallel 10 --output-on-failure --no-tests=error
    --output-junit "${logs}/tests.xml" --output-log "${logs}/ctest.log"
    RESULT_VARIABLE code)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "Hook checks failed (${code}); see ${logs}")
  endif()
endfunction()
