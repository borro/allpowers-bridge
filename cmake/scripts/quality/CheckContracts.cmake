cmake_minimum_required(VERSION 4.4)
file(READ "${ROOT}/tests/fixtures/usb-contract.json" contract)
string(JSON expected GET "${contract}" descriptor_sha256)
file(SHA256 "${ROOT}/firmware/R2500Adapter/UpsDescriptor.h" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "USB descriptor contract changed")
endif()
file(READ "${ROOT}/firmware/R2500Adapter/R2500Adapter.ino" source)
foreach(required "BOOT-R2500!!" "telemetryHid.enable()" "USB.usbClass(0)" "if(!targetLoaded){pickerOpen=true")
  string(FIND "${source}" "${required}" found)
  if(found LESS 0)
    message(FATAL_ERROR "Required startup/maintenance behavior missing: ${required}")
  endif()
endforeach()
if(source MATCHES "USBCDC|Console[.]|cdcEvent|ARDUINO_USB_CDC_LINE_CODING_EVENT")
  message(FATAL_ERROR "Application CDC must not be registered or handled")
endif()
file(READ "${ROOT}/tests/fixtures/hid-telemetry-contract.json" hid_contract)
string(REGEX MATCH "static const uint8_t vendorDescriptor\\[\\]=\\{([^}]+)\\}" match "${source}")
string(REGEX REPLACE "[ \r\n\t]+" "" maintenance "${CMAKE_MATCH_1}")
string(SHA256 maintenance_hash "${maintenance}")
string(JSON expected_maintenance GET "${hid_contract}" maintenance_source_sha256)
if(NOT maintenance_hash STREQUAL expected_maintenance)
  message(FATAL_ERROR "Legacy maintenance HID descriptor changed")
endif()
file(READ "${ROOT}/firmware/R2500Adapter/HidTelemetryServer.h" telemetry_source)
string(REGEX MATCH "constexpr uint8_t Descriptor\\[\\] = \\{([^}]+)\\}" match "${telemetry_source}")
string(REGEX REPLACE "[ \r\n\t]+" "" telemetry "${CMAKE_MATCH_1}")
string(SHA256 telemetry_hash "${telemetry}")
string(JSON expected_telemetry GET "${hid_contract}" telemetry_source_sha256)
if(NOT telemetry_hash STREQUAL expected_telemetry)
  message(FATAL_ERROR "HID telemetry descriptor changed")
endif()
if(source MATCHES "\"([0-9a-fA-F][0-9a-fA-F]:){5}[0-9a-fA-F][0-9a-fA-F]\"")
  message(FATAL_ERROR "Station identity must not be baked into firmware")
endif()
file(READ "${ROOT}/core/native/api.h" abi)
if(NOT abi MATCHES "#define AP_ABI_VERSION 1")
  message(FATAL_ERROR "C ABI v1 contract changed")
endif()
message(STATUS "USB, startup, ABI and maintenance source contracts passed")
