cmake_minimum_required(VERSION 4.4)
if(TASK STREQUAL "audit")
  set(MODE index)
  include("${SOURCE}/cmake/Audit.cmake")
elseif(TASK STREQUAL "format")
  set(ROOT "${SOURCE}")
  set(CHECK_CONTROLS ON)
  include("${SOURCE}/cmake/RunFormat.cmake")
elseif(TASK STREQUAL "secrets")
  include("${SOURCE}/cmake/CheckSecrets.cmake")
elseif(TASK STREQUAL "whitespace")
  find_package(Git REQUIRED)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" diff --cached --check
    COMMAND_ERROR_IS_FATAL ANY)
else()
  message(FATAL_ERROR "Unknown quick check: ${TASK}")
endif()
