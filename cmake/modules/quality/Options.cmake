include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/../common/Arguments.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Coverage.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Mutation.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/StaticAnalysis.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/Sanitizers.cmake")

function(ap_configure_quality)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;BUILD_ROOT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT BUILD_ROOT)
  set(PROJECT_SOURCE_DIR "${AP_ROOT}")
  set(PROJECT_BINARY_DIR "${AP_BUILD_ROOT}")
  option(ALLPOWERS_COVERAGE "Measure host C++ line coverage" OFF)
  option(ALLPOWERS_SANITIZERS "Instrument portable targets with fatal ASan/UBSan" OFF)
  option(ALLPOWERS_MUTATION "Mutation-test portable host code with Mull" OFF)
  option(ALLPOWERS_FUZZING "Fuzz portable parsers with libFuzzer and ASan/UBSan" OFF)
  option(ALLPOWERS_STATIC_ANALYSIS "Analyze first-party host C++ for defects" OFF)
  set(selected)
  foreach(mode COVERAGE SANITIZERS MUTATION FUZZING STATIC_ANALYSIS)
    if(ALLPOWERS_${mode})
      list(APPEND selected "${mode}")
    endif()
  endforeach()
  list(LENGTH selected count)
  if(count GREATER 1)
    message(FATAL_ERROR "Use separate build directories for quality modes: ${selected}")
  endif()
  if((ALLPOWERS_COVERAGE OR ALLPOWERS_MUTATION OR ALLPOWERS_FUZZING) AND NOT BUILD_TESTING)
    message(FATAL_ERROR "Coverage, mutation and fuzzing require BUILD_TESTING=ON")
  endif()
  if(ALLPOWERS_COVERAGE AND NOT MSVC AND NOT
      (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "GNU"))
    message(FATAL_ERROR "Coverage supports GCC on Linux or MSVC on Windows")
  endif()
  if(ALLPOWERS_SANITIZERS AND (MSVC OR NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang"))
    message(FATAL_ERROR "Portable sanitizer checks require GCC or Clang")
  endif()
  if(ALLPOWERS_MUTATION OR ALLPOWERS_FUZZING)
    if(ALLPOWERS_MUTATION)
      set(llvm "${ALLPOWERS_MULL_LLVM_VERSION}")
    else()
      set(llvm "${ALLPOWERS_FUZZ_LLVM_VERSION}")
    endif()
    if(NOT CMAKE_SYSTEM_NAME STREQUAL "Linux" OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "Clang"
        OR NOT CMAKE_CXX_COMPILER_VERSION MATCHES "^${llvm}[.]")
      message(FATAL_ERROR "Mutation/fuzzing requires Clang ${llvm} on Linux")
    endif()
  endif()
  if(ALLPOWERS_STATIC_ANALYSIS AND NOT MSVC AND NOT
      (CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_CXX_COMPILER_ID STREQUAL "Clang"))
    message(FATAL_ERROR "Static analysis supports Linux Clang or Windows MSVC")
  endif()
  ap_configure_mutation(ROOT "${PROJECT_SOURCE_DIR}" BUILD_ROOT "${PROJECT_BINARY_DIR}")
  ap_configure_static_analysis(ROOT "${PROJECT_SOURCE_DIR}" BUILD_ROOT "${PROJECT_BINARY_DIR}")
  return(PROPAGATE AP_ANALYSIS_ROOT ALLPOWERS_MULL_CONFIG CMAKE_EXPORT_COMPILE_COMMANDS)
endfunction()
