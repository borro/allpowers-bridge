# Evaluate the real CMake inputs rather than parsing CMake syntax in Python.
cmake_minimum_required(VERSION 3.25)
if(NOT OUTPUT)
  message(FATAL_ERROR "OUTPUT is required")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")

function(json_string output value)
  string(REPLACE "\\" "\\\\" value "${value}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(REPLACE "\n" "\\n" value "${value}")
  string(REPLACE "\r" "\\r" value "${value}")
  string(REPLACE "\t" "\\t" value "${value}")
  set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

set(document "{}")
get_cmake_property(variables VARIABLES)
foreach(variable IN LISTS variables)
  if(variable MATCHES "^ALLPOWERS_")
    set(values "[]")
    set(index 0)
    foreach(value IN LISTS ${variable})
      json_string(quoted "${value}")
      string(JSON values SET "${values}" ${index} "${quoted}")
      math(EXPR index "${index}+1")
    endforeach()
    string(JSON document SET "${document}" "${variable}" "${values}")
  endif()
endforeach()
file(WRITE "${OUTPUT}" "${document}\n")
