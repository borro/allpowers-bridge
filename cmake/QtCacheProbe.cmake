cmake_minimum_required(VERSION 4.4)
set(CMAKE_MSVC_RUNTIME_LIBRARY MultiThreaded)
project(QtCacheProbe LANGUAGES CXX)
include("${ALLPOWERS_ROOT}/cmake/Dependencies.cmake")
include("${ALLPOWERS_ROOT}/cmake/WindowsCompiler.cmake")
if(NOT WIN32 OR NOT MSVC OR NOT CMAKE_SIZEOF_VOID_P EQUAL 8)
  message(FATAL_ERROR "The cached Qt SDK requires Windows x64 MSVC")
endif()
find_package(Qt6 ${ALLPOWERS_QT_VERSION} EXACT REQUIRED COMPONENTS Widgets Bluetooth Sql Network Test)
foreach(module Core Gui Widgets Bluetooth Sql Network Test)
  get_target_property(kind Qt6::${module} TYPE)
  if(NOT kind STREQUAL "STATIC_LIBRARY")
    message(FATAL_ERROR "Qt ${module} is not static")
  endif()
endforeach()
get_filename_component(prefix "${Qt6_DIR}/../../.." ABSOLUTE)
foreach(pair "Core|cpp_winrt" "Bluetooth|winrt_bt")
  string(REPLACE "|" ";" pair "${pair}")
  list(GET pair 0 module)
  list(GET pair 1 feature)
  string(TOLOWER "${module}" lower)
  file(READ "${prefix}/include/Qt${module}/${ALLPOWERS_QT_VERSION}/Qt${module}/private/qt${lower}-config_p.h" config)
  if(NOT config MATCHES "#define QT_FEATURE_${feature} 1")
    message(FATAL_ERROR "Qt ${module} lacks ${feature}")
  endif()
endforeach()
qt_add_executable(qt_cache_probe "${ALLPOWERS_ROOT}/cmake/qt_cache_probe.cpp")
target_compile_features(qt_cache_probe PRIVATE cxx_std_23)
target_link_libraries(qt_cache_probe PRIVATE Qt6::Widgets Qt6::Bluetooth Qt6::Sql Qt6::Network Qt6::Test)
qt_import_plugins(qt_cache_probe NO_DEFAULT INCLUDE Qt6::QWindowsIntegrationPlugin
  Qt6::QOffscreenIntegrationPlugin Qt6::QSQLiteDriverPlugin Qt6::QICOPlugin)
enable_testing()
find_program(DUMPBIN dumpbin REQUIRED)
add_test(NAME qt-cache-imports COMMAND "${CMAKE_COMMAND}" "-DEXE=$<TARGET_FILE:qt_cache_probe>"
  "-DDUMPBIN=${DUMPBIN}" -P "${ALLPOWERS_ROOT}/cmake/QtCacheImports.cmake")
add_test(NAME qt-cache-offline COMMAND "${CMAKE_COMMAND}" -E env
  --unset=QT_PLUGIN_PATH --unset=QT_QPA_PLATFORM_PLUGIN_PATH --unset=QT_QPA_PLATFORM
  "PATH=$ENV{SystemRoot}/System32" -- "$<TARGET_FILE:qt_cache_probe>" -platform offscreen)
set_tests_properties(qt-cache-offline PROPERTIES TIMEOUT 30)
