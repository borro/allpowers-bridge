cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
file(MAKE_DIRECTORY "${SOURCE_CACHE}" "${WORK}/notices")
file(LOCK "${SOURCE_CACHE}/notices.lock" GUARD PROCESS TIMEOUT 180)
foreach(module qtbase qtconnectivity)
  string(TOUPPER "${module}" key)
  set(name "${module}-everywhere-src-${ALLPOWERS_QT_VERSION}")
  set(archive "${SOURCE_CACHE}/${name}.tar.xz")
  if(NOT EXISTS "${archive}")
    if(NOT FETCH)
      message(FATAL_ERROR "Qt sources are missing. Build the root windows target or run PrepareNotices.cmake with FETCH=ON before configuring the standalone app")
    endif()
    file(DOWNLOAD "https://download.qt.io/archive/qt/6.8/${ALLPOWERS_QT_VERSION}/submodules/${name}.tar.xz"
      "${archive}" EXPECTED_HASH "SHA256=${ALLPOWERS_${key}_SHA256}" TLS_VERIFY ON SHOW_PROGRESS
      TIMEOUT 180 INACTIVITY_TIMEOUT 30)
  endif()
  file(SHA256 "${archive}" actual)
  if(NOT actual STREQUAL ALLPOWERS_${key}_SHA256)
    message(FATAL_ERROR "Qt source archive hash mismatch: ${name}")
  endif()
  set(source "${SOURCE_CACHE}/sources/${name}")
  if(NOT EXISTS "${source}/LICENSES")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${SOURCE_CACHE}/sources")
  endif()
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE "${source}/*")
  foreach(path IN LISTS files)
    get_filename_component(basename "${path}" NAME)
    string(TOLOWER "${basename}" basename)
    file(RELATIVE_PATH relative "${source}" "${path}")
    if(relative MATCHES "^LICENSES/" OR basename MATCHES "^(license|copying|notice)" OR basename STREQUAL "qt_attribution.json")
      get_filename_component(directory "${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${WORK}/notices/Qt/${module}/${directory}")
      file(COPY_FILE "${path}" "${WORK}/notices/Qt/${module}/${relative}" ONLY_IF_DIFFERENT)
    endif()
  endforeach()
endforeach()
foreach(relative LICENSE THIRD_PARTY_NOTICES.md docs/relinking.md core/src/AllpowersModels.LICENSE.txt drivers/windows/LICENSE.MS-PL.txt)
  get_filename_component(name "${relative}" NAME)
  file(COPY_FILE "${ROOT}/${relative}" "${WORK}/notices/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(GLOB_RECURSE notices LIST_DIRECTORIES FALSE RELATIVE "${WORK}/notices" "${WORK}/notices/*")
set(qrc "<RCC><qresource prefix=\"/licenses\">\n")
foreach(name IN LISTS notices)
  string(REPLACE "&" "&amp;" alias "${name}")
  string(REPLACE "&" "&amp;" path "${WORK}/notices/${name}")
  string(APPEND qrc "<file alias=\"${alias}\">${path}</file>\n")
endforeach()
string(APPEND qrc "</qresource></RCC>\n")
file(WRITE "${WORK}/notices.qrc.tmp" "${qrc}")
file(COPY_FILE "${WORK}/notices.qrc.tmp" "${WORK}/notices.qrc" ONLY_IF_DIFFERENT)
file(REMOVE "${WORK}/notices.qrc.tmp")
