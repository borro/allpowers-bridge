execute_process(COMMAND "${RECOVERABLE}" RESULT_VARIABLE recovered OUTPUT_VARIABLE out ERROR_VARIABLE diagnostics)
if(NOT recovered EQUAL 0 OR NOT diagnostics MATCHES "runtime error: signed integer overflow")
  message(FATAL_ERROR "Recoverable UBSan control did not diagnose UB and exit zero: ${recovered}\n${diagnostics}")
endif()
message(STATUS "Recoverable control diagnostic: ${diagnostics}")
execute_process(COMMAND "${FATAL}" RESULT_VARIABLE fatal OUTPUT_VARIABLE out ERROR_VARIABLE diagnostics)
if(fatal EQUAL 0 OR NOT diagnostics MATCHES "runtime error: signed integer overflow")
  message(FATAL_ERROR "Production sanitizer policy failed to reject deliberate UB: ${fatal}\n${diagnostics}")
endif()
message(STATUS "Fatal control diagnostic: ${diagnostics}")
message(STATUS "Recoverable control diagnoses UB with exit 0; production sanitizer policy diagnoses UB with nonzero exit")
