cmake_minimum_required(VERSION 3.26)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside_build)
if(NOT inside_build OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Incremental-build test requires a dedicated binary subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
file(MAKE_DIRECTORY "${scratch}/source")
file(CONFIGURE OUTPUT "${scratch}/source/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 3.26)
project(HeaderDependency LANGUAGES CXX)
include("@ROOT@/cmake/WindowsCompiler.cmake")
add_executable(probe main.cpp)
]=] @ONLY)
file(WRITE "${scratch}/source/value.h" "#define VALUE 0\n")
file(WRITE "${scratch}/source/main.cpp" "#include \"value.h\"\nint main() { return VALUE; }\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${scratch}/source" -B "${scratch}/build"
  -G Ninja -DCMAKE_BUILD_TYPE=Release "-DCMAKE_CXX_COMPILER=${CXX}"
  COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${scratch}/build" COMMAND_ERROR_IS_FATAL ANY)
set(executable "${scratch}/build/probe")
if(CMAKE_HOST_WIN32)
  string(APPEND executable .exe)
endif()
execute_process(COMMAND "${executable}" COMMAND_ERROR_IS_FATAL ANY)
# Exceed the timestamp granularity of filesystems used by developer checkouts.
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1 COMMAND_ERROR_IS_FATAL ANY)
file(WRITE "${scratch}/source/value.h" "#define VALUE 7\n")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${scratch}/build" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${executable}" RESULT_VARIABLE changed)
if(NOT changed EQUAL 7)
  message(FATAL_ERROR "Changing only a header did not rebuild its consumer")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${scratch}/build"
  OUTPUT_VARIABLE output COMMAND_ERROR_IS_FATAL ANY)
if(NOT output MATCHES "no work to do")
  message(FATAL_ERROR "Unchanged project unexpectedly rebuilt: ${output}")
endif()
message(STATUS "Header-only edits rebuild correctly; unchanged builds do no work")
