cmake_minimum_required(VERSION 4.4)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "The firmware SDK is Linux-only")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Download.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
foreach(required CLI DATA CONFIG)
  if(NOT ${required})
    message(FATAL_ERROR "Set ${required} for Arduino SDK preparation")
  endif()
endforeach()
file(MAKE_DIRECTORY "${DATA}")
file(LOCK "${DATA}/allpowers-setup.lock" GUARD PROCESS TIMEOUT 600)
if(NOT EXISTS "${CLI}")
  get_filename_component(folder "${CLI}" DIRECTORY)
  file(MAKE_DIRECTORY "${folder}")
  set(name "arduino-cli_${ALLPOWERS_ARDUINO_VERSION}_Linux_64bit.tar.gz")
  set(hash "${ALLPOWERS_ARDUINO_LINUX_SHA256}")
  set(actual "")
  if(EXISTS "${folder}/${name}")
    file(SHA256 "${folder}/${name}" actual)
  endif()
  if(NOT actual STREQUAL hash)
    ap_download_verified(URL "https://github.com/arduino/arduino-cli/releases/download/v${ALLPOWERS_ARDUINO_VERSION}/${name}" DESTINATION "${folder}/${name}"
  SHA256 "${hash}" MISMATCH REPLACE TIMEOUT 180 INACTIVITY_TIMEOUT 30)
  endif()
  file(ARCHIVE_EXTRACT INPUT "${folder}/${name}" DESTINATION "${folder}")
  file(REMOVE "${folder}/${name}")
  file(CHMOD "${CLI}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endif()
execute_process(COMMAND "${CLI}" version --format json OUTPUT_VARIABLE version COMMAND_ERROR_IS_FATAL ANY)
string(JSON version GET "${version}" VersionString)
if(NOT version STREQUAL ALLPOWERS_ARDUINO_VERSION)
  message(FATAL_ERROR "Expected Arduino CLI ${ALLPOWERS_ARDUINO_VERSION}, found ${version}")
endif()
set(sdk "${DATA}/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
if(EXISTS "${sdk}/platform.txt" AND EXISTS "${sdk}/tools/partitions/boot_app0.bin")
  # Ask the package manager for the installed version without refreshing indexes.
  execute_process(COMMAND "${CLI}" --config-file "${CONFIG}" core list --format json
    OUTPUT_VARIABLE installed COMMAND_ERROR_IS_FATAL ANY)
  string(JSON count ERROR_VARIABLE error LENGTH "${installed}" platforms)
  if(NOT error AND count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      string(JSON id GET "${installed}" platforms ${index} id)
      string(JSON installed_version GET "${installed}" platforms ${index} installed_version)
      if(id STREQUAL "esp32:esp32" AND installed_version STREQUAL ALLPOWERS_ESP32_VERSION)
        message(STATUS "Reusing Arduino CLI ${version} / ESP32 ${installed_version}")
        return()
      endif()
    endforeach()
  endif()
endif()
set(index_has_version FALSE)
if(EXISTS "${DATA}/package_esp32_index.json" AND EXISTS "${DATA}/package_index.json")
  file(READ "${DATA}/package_esp32_index.json" index_json)
  string(JSON count ERROR_VARIABLE error LENGTH "${index_json}" packages 0 platforms)
  if(NOT error AND count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      string(JSON available GET "${index_json}" packages 0 platforms ${index} version)
      if(available STREQUAL ALLPOWERS_ESP32_VERSION)
        set(index_has_version TRUE)
      endif()
    endforeach()
  endif()
endif()
if(NOT index_has_version)
  execute_process(COMMAND "${CLI}" --config-file "${CONFIG}" core update-index COMMAND_ERROR_IS_FATAL ANY)
endif()
execute_process(COMMAND "${CLI}" --config-file "${CONFIG}" core install "esp32:esp32@${ALLPOWERS_ESP32_VERSION}"
  COMMAND_ERROR_IS_FATAL ANY)
