cmake_minimum_required(VERSION 4.4)
include("${ROOT}/cmake/modules/common/Download.cmake")
include("${ROOT}/cmake/modules/common/Files.cmake")
include("${ROOT}/cmake/modules/common/Json.cmake")
if(CASE STREQUAL "download")
  ap_download_verified(URL "${URL}" DESTINATION "${DESTINATION}" SHA256 "${SHA256}" MISMATCH "${MISMATCH}")
  return()
elseif(CASE STREQUAL "path")
  ap_remove_tree(ROOT "${WORK}" PATH "${CANDIDATE}")
  return()
elseif(CASE STREQUAL "arguments")
  ap_download_verified(URL "file:///unused" SHA256 invalid)
  return()
elseif(CASE STREQUAL "unknown-argument")
  ap_write_changed(PATH "${WORK}/must-not-be-written" CONTENT "test" OFF)
  return()
endif()
string(RANDOM LENGTH 24 ALPHABET 0123456789abcdef suffix)
set(scratch "${WORK}/${suffix} directory with spaces")
file(MAKE_DIRECTORY "${scratch}")
set(source "${scratch}/source.bin")
file(WRITE "${source}" "Pinned local payload\n")
file(SHA256 "${source}" expected)
if(CMAKE_HOST_WIN32)
  set(url "file:///${source}")
else()
  set(url "file://${source}")
endif()
set(destination "${scratch}/cache/payload.bin")
set(worker "${CMAKE_COMMAND}" "-DROOT=${ROOT}" -DCASE=download
  "-DURL=${url}" "-DDESTINATION=${destination}" "-DSHA256=${expected}" -DMISMATCH=FAIL
  -P "${CMAKE_CURRENT_LIST_FILE}")
# execute_process pipelines launch both children concurrently; output is irrelevant.
execute_process(COMMAND ${worker} COMMAND ${worker} RESULTS_VARIABLE results)
if(NOT results STREQUAL "0;0")
  message(FATAL_ERROR "Concurrent cache population failed: ${results}")
endif()
file(SHA256 "${destination}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Concurrent cache publication changed payload")
endif()
file(TIMESTAMP "${destination}" before "%s")
file(REMOVE "${source}")
execute_process(COMMAND ${worker} COMMAND_ERROR_IS_FATAL ANY)
file(TIMESTAMP "${destination}" after "%s")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Verified cache hit rewrote the file")
endif()
function(expect_failure)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" ${ARGN}
    -P "${CMAKE_CURRENT_FUNCTION_LIST_FILE}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(code STREQUAL "0")
    message(FATAL_ERROR "A negative infrastructure control unexpectedly passed")
  endif()
endfunction()
file(WRITE "${destination}" "corrupt cache retained as evidence\n")
file(SHA256 "${destination}" corrupt)
expect_failure(-DCASE=download "-DURL=${url}" "-DDESTINATION=${destination}"
  "-DSHA256=${expected}" -DMISMATCH=FAIL)
expect_failure(-DCASE=download "-DURL=${url}" "-DDESTINATION=${destination}"
  "-DSHA256=${expected}" -DMISMATCH=REPLACE)
file(WRITE "${source}" "wrong remote bytes\n")
expect_failure(-DCASE=download "-DURL=${url}" "-DDESTINATION=${destination}"
  "-DSHA256=${expected}" -DMISMATCH=REPLACE)
file(SHA256 "${destination}" unchanged)
file(GLOB partials "${destination}.*.partial")
if(NOT corrupt STREQUAL unchanged OR partials)
  message(FATAL_ERROR "Failed download changed cached evidence or left a partial payload")
endif()
file(WRITE "${source}" "Pinned local payload\n")
ap_download_verified(URL "${url}" DESTINATION "${destination}" SHA256 "${expected}" MISMATCH REPLACE)
file(SHA256 "${destination}" repaired)
if(NOT repaired STREQUAL expected)
  message(FATAL_ERROR "Explicit cache replacement failed")
endif()
expect_failure(-DCASE=arguments)
expect_failure(-DCASE=unknown-argument "-DWORK=${scratch}")
expect_failure(-DCASE=path "-DWORK=${scratch}" "-DCANDIDATE=${scratch}")
expect_failure(-DCASE=path "-DWORK=${scratch}" "-DCANDIDATE=${scratch}/../outside")
file(MAKE_DIRECTORY "${scratch}/remove/child")
ap_remove_tree(ROOT "${scratch}" PATH "${scratch}/remove")
if(EXISTS "${scratch}/remove" OR NOT EXISTS "${destination}")
  message(FATAL_ERROR "Workspace cleanup crossed its selected boundary")
endif()
if(NOT CMAKE_HOST_WIN32)
  file(CREATE_LINK "${scratch}/cache" "${scratch}/linked" SYMBOLIC)
  expect_failure(-DCASE=path "-DWORK=${scratch}" "-DCANDIDATE=${scratch}/linked")
endif()
set(value "quotes: \"; slash: \\; tab:\t; newline:\n")
ap_json_quote(OUTPUT quoted VALUE "${value}")
string(JSON document SET "{}" value "${quoted}")
string(JSON restored GET "${document}" value)
if(NOT restored STREQUAL value)
  message(FATAL_ERROR "JSON escaping lost content")
endif()
set(stamp "${scratch}/unchanged.txt")
ap_write_changed(PATH "${stamp}" CONTENT "same\n")
file(TIMESTAMP "${stamp}" before "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1.1)
ap_write_changed(PATH "${stamp}" CONTENT "same\n")
file(TIMESTAMP "${stamp}" after "%s")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Unchanged output timestamp was modified")
endif()
# The Qt ExternalProject download entry uses the same locked cache contract.
# A tiny archive exercises its real extraction code without downloading an SDK.
set(qt "${scratch}/qt")
set(name qtbase-everywhere-src-fixture)
file(MAKE_DIRECTORY "${qt}/upstream/${name}")
file(WRITE "${qt}/upstream/${name}/CMakeLists.txt" "# verified Qt source fixture\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cJf "${qt}/upstream/${name}.tar.xz" -- "${name}"
  WORKING_DIRECTORY "${qt}/upstream" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${qt}/upstream/${name}.tar.xz" hash)
file(COPY "${ROOT}/cmake" DESTINATION "${qt}/project")
if(CMAKE_HOST_WIN32)
  set(base "file:///${qt}/upstream")
else()
  set(base "file://${qt}/upstream")
endif()
file(WRITE "${qt}/project/cmake/Dependencies.cmake"
  "set(ALLPOWERS_QT_VERSION fixture)\nset(ALLPOWERS_QTBASE_SHA256 ${hash})\nset(ALLPOWERS_QT_SOURCE_URL \"${base}\")\n")
set(extract "${CMAKE_COMMAND}" -DMODULE=qtbase "-DSOURCE_CACHE=${qt}/cache"
  "-DBUILD_ROOT=${qt}/build" "-DOUTPUT=${qt}/build/source"
  -P "${qt}/project/cmake/scripts/sdk/ExtractQtSource.cmake")
execute_process(COMMAND ${extract} COMMAND_ERROR_IS_FATAL ANY)
file(REMOVE "${qt}/upstream/${name}.tar.xz")
file(WRITE "${qt}/build/source/stale.cpp" "obsolete source\n")
execute_process(COMMAND ${extract} COMMAND_ERROR_IS_FATAL ANY)
if(EXISTS "${qt}/build/source/stale.cpp" OR NOT EXISTS "${qt}/build/source/CMakeLists.txt")
  message(FATAL_ERROR "Qt extraction retained stale inputs or lost verified sources")
endif()
file(WRITE "${qt}/cache/${name}.tar.xz" "corrupt cache\n")
execute_process(COMMAND ${extract} RESULT_VARIABLE result OUTPUT_QUIET ERROR_QUIET)
if(result EQUAL 0 OR NOT EXISTS "${qt}/build/source/CMakeLists.txt")
  message(FATAL_ERROR "Rejected Qt archive replaced a usable source tree")
endif()
message(STATUS "Infrastructure controls passed: concurrent verified cache, Qt extraction, corruption, paths, JSON and timestamps")
