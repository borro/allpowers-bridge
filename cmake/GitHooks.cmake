cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/GitHookSupport.cmake")
if(NOT ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
file(TO_CMAKE_PATH "${ROOT}" ROOT)
if(NOT PHASE MATCHES "^(commit|push)$")
  message(FATAL_ERROR "Set PHASE to commit or push")
endif()
if(NOT CONFIG)
  set(CONFIG "${ROOT}/.local/hooks.json")
endif()
include("${ROOT}/.githooks/Host.cmake")
ap_hook_host_tools("${CONFIG}" ninja)
set(work "${ROOT}/build/git-hooks")
ap_hook_path("${ROOT}" "${work}")
file(MAKE_DIRECTORY "${work}")
file(LOCK "${work}/run.lock" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE locked)
if(NOT locked STREQUAL "0")
  message(FATAL_ERROR "Another hook run is using ${work}")
endif()
string(TIMESTAMP started "%s" UTC)
if(PHASE STREQUAL "commit")
  ap_hook_git(base "${ROOT}" rev-parse HEAD)
  ap_hook_git(tree "${ROOT}" write-tree)
  set(revisions "${base}")
elseif(REVISION)
  ap_hook_git(revisions "${ROOT}" rev-parse --verify "${REVISION}^{commit}")
elseif(PUSH_INPUT)
  ap_hook_push_commits(revisions "${ROOT}" "${PUSH_INPUT}")
else()
  message(FATAL_ERROR "Push checks require REVISION or PUSH_INPUT from Git")
endif()
foreach(commit IN LISTS revisions)
  ap_hook_git(committed_tree "${ROOT}" rev-parse "${commit}^{tree}")
  if(PHASE STREQUAL "push")
    set(tree "${committed_tree}")
  endif()
  ap_hook_git(version "${ROOT}" describe --tags --match "v[0-9]*" "${commit}")
  if(PHASE STREQUAL "commit" AND NOT tree STREQUAL committed_tree)
    string(APPEND version "-dirty")
  endif()
  message(STATUS "Preparing ${PHASE} snapshot ${tree}")
  set(source "${work}/source")
  ap_hook_snapshot("${ROOT}" "${tree}" "${source}" "${version}")
  string(SUBSTRING "${tree}" 0 12 short)
  set(logs "${work}/logs/${CMAKE_HOST_SYSTEM_NAME}/${PHASE}-${short}")
  set(runner "${work}/runner-${CMAKE_HOST_SYSTEM_NAME}")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${ROOT}/cmake/HookChecks" -B "${runner}"
    -G Ninja "-DCMAKE_MAKE_PROGRAM=${ninja}" "-DROOT=${ROOT}" "-DSOURCE=${source}"
    "-DCONFIG=${CONFIG}" "-DPHASE=${PHASE}" COMMAND_ERROR_IS_FATAL ANY)
  ap_hook_ctest("${runner}" "${logs}")
  if(PHASE STREQUAL "commit")
    ap_hook_git(current_tree "${ROOT}" write-tree)
    ap_hook_git(current_head "${ROOT}" rev-parse HEAD)
    if(NOT current_tree STREQUAL tree OR NOT current_head STREQUAL base)
      message(FATAL_ERROR "Index or HEAD changed during validation; retry the commit")
    endif()
  endif()
endforeach()
string(TIMESTAMP finished "%s" UTC)
math(EXPR elapsed "${finished} - ${started}")
message(STATUS "${PHASE} checks passed in ${elapsed}s")
