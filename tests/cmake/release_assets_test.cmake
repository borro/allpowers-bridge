function(archive base name directory)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${input}/${name}.zip" --format=zip -- "${directory}"
    WORKING_DIRECTORY "${base}" COMMAND_ERROR_IS_FATAL ANY)
  file(SHA256 "${input}/${name}.zip" hash)
  file(WRITE "${input}/${name}.zip.sha256" "${hash}  ${name}.zip\n")
endfunction()
