cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
set(report "### Build environment\n\n")
foreach(name ImageOS ImageVersion RUNNER_OS RUNNER_ARCH VCToolsVersion WindowsSDKVersion UCRTVersion)
  string(APPEND report "- ${name}: $ENV{${name}}\n")
endforeach()
foreach(tool cmake ninja git python3)
  execute_process(COMMAND "${tool}" --version OUTPUT_VARIABLE version ERROR_QUIET RESULT_VARIABLE result)
  if(result EQUAL 0)
    string(REGEX MATCH "[^\n\r]+" version "${version}")
    string(APPEND report "- ${version}\n")
  endif()
endforeach()
if(CMAKE_HOST_WIN32)
  execute_process(COMMAND cl /Bv OUTPUT_VARIABLE compiler ERROR_VARIABLE compiler_error)
  string(APPEND report "\n```text\n${compiler}${compiler_error}\n```\n")
else()
  foreach(tool c++ "clang++-${ALLPOWERS_FUZZ_LLVM_VERSION}" valgrind)
    execute_process(COMMAND "${tool}" --version OUTPUT_VARIABLE version ERROR_QUIET RESULT_VARIABLE result)
    if(result EQUAL 0)
      string(REGEX MATCH "[^\n\r]+" version "${version}")
      string(APPEND report "- ${version}\n")
    endif()
  endforeach()
endif()
message(STATUS "${report}")
if(DEFINED ENV{GITHUB_STEP_SUMMARY})
  file(APPEND "$ENV{GITHUB_STEP_SUMMARY}" "<details><summary>Build environment</summary>\n\n${report}\n</details>\n")
endif()
