include("${CMAKE_CURRENT_LIST_DIR}/../cmake/modules/common/Arguments.cmake")
# All host-specific hook integration lives here and in Windows.cmake.
include_guard(GLOBAL)

# The complete local workflow reuses the host adapter, without requiring hook
# installation or validating an index snapshot instead of the working tree.
function(ap_add_wsl_verification)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;BUILD_ROOT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT BUILD_ROOT)
  find_program(wsl wsl.exe)
  set(distribution Ubuntu)
  set(linuxCMake cmake)
  set(options)
  if(EXISTS "${AP_ROOT}/.local/hooks.json")
    file(READ "${AP_ROOT}/.local/hooks.json" settings)
    foreach(key distribution linuxCMake)
      string(JSON value ERROR_VARIABLE missing GET "${settings}" "${key}")
      if(NOT missing)
        set(${key} "${value}")
      endif()
    endforeach()
    foreach(pair "tidy|ALLPOWERS_CLANG_TIDY" "linuxCoverage|ALLPOWERS_COVERAGE_TOOL"
        "mull|ALLPOWERS_MULL_ROOT" "cppcheck|ALLPOWERS_CPPCHECK_ROOT")
      string(REPLACE "|" ";" fields "${pair}")
      list(GET fields 0 key)
      list(GET fields 1 variable)
      string(JSON value ERROR_VARIABLE missing GET "${settings}" "${key}")
      if(NOT missing)
        list(APPEND options "-D${variable}=${value}")
      endif()
    endforeach()
  endif()
  if(wsl)
    execute_process(COMMAND "${wsl}" -d "${distribution}" --exec "${linuxCMake}" --version
      RESULT_VARIABLE code OUTPUT_VARIABLE version ERROR_QUIET TIMEOUT 20)
  endif()
  if(NOT wsl OR NOT code STREQUAL "0" OR NOT version MATCHES "cmake version ([0-9.]+)" OR
      CMAKE_MATCH_1 VERSION_LESS 4.4)
    message(STATUS "Unavailable: Linux checks in WSL (Ubuntu needs CMake 4.4+; optional tool paths: .local/hooks.json)")
    return()
  endif()
  foreach(key ROOT BUILD_ROOT)
    execute_process(COMMAND "${wsl}" -d "${distribution}" --exec wslpath -a -u "${AP_${key}}"
      OUTPUT_VARIABLE linux_${key} OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  endforeach()
  add_custom_target(check-linux
    COMMAND "${wsl}" -d "${distribution}" --exec "${linuxCMake}" --preset verify
      -S "${linux_ROOT}" -B "${linux_BUILD_ROOT}/wsl" ${options}
      "-DALLPOWERS_RELEASE_DIR=${linux_BUILD_ROOT}/wsl/dist"
    COMMAND "${wsl}" -d "${distribution}" --exec "${linuxCMake}" -E env
      --modify "PATH=path_list_prepend:${linux_BUILD_ROOT}/wsl/tools/ninja" --
      "${linuxCMake}" --build "${linux_BUILD_ROOT}/wsl" --target check-all --parallel 2
    JOB_POOL verification VERBATIM)
  add_dependencies(check-all check-linux)
endfunction()

function(ap_hook_setting)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "JSON;NAME;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED JSON NAME OUTPUT)
  string(JSON value ERROR_VARIABLE error GET "${AP_JSON}" "${AP_NAME}")
  if(error)
    message(FATAL_ERROR "Missing hook setting ${AP_NAME}; run cmake -P cmake/scripts/hooks/InstallGitHooks.cmake")
  endif()
  set(${AP_OUTPUT} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_host_tools)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "CONFIG;OUTPUT;JSON_OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED CONFIG OUTPUT JSON_OUTPUT)
  if(NOT EXISTS "${AP_CONFIG}")
    message(FATAL_ERROR "Missing ${AP_CONFIG}; run cmake -P cmake/scripts/hooks/InstallGitHooks.cmake")
  endif()
  file(READ "${AP_CONFIG}" settings)
  if(CMAKE_HOST_WIN32)
    ap_hook_setting(JSON "${settings}" NAME windowsNinja OUTPUT ninja)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    ap_hook_setting(JSON "${settings}" NAME linuxNinja OUTPUT ninja)
  else()
    message(FATAL_ERROR "Local hooks currently support Windows and Linux")
  endif()
  set(${AP_JSON_OUTPUT} "${settings}" PARENT_SCOPE)
  set(${AP_OUTPUT} "${ninja}" PARENT_SCOPE)
endfunction()

function(ap_hook_tasks)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "PHASE;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED PHASE OUTPUT)
  if(AP_PHASE STREQUAL "commit")
    set(tasks audit format secrets whitespace linux-unit analysis linux-coverage sanitizers valgrind)
    if(CMAKE_HOST_WIN32)
      list(APPEND tasks windows-unit)
    endif()
  elseif(AP_PHASE STREQUAL "push")
    set(tasks mutation fuzz)
    if(CMAKE_HOST_WIN32)
      list(APPEND tasks windows-coverage)
    endif()
  else()
    message(FATAL_ERROR "Unknown hook phase: ${AP_PHASE}")
  endif()
  if(NOT CMAKE_HOST_WIN32)
    message(STATUS "Windows-only checks are performed by CI on this host")
  endif()
  set(${AP_OUTPUT} "${tasks}" PARENT_SCOPE)
endfunction()

function(ap_hook_linux_path)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "JSON;PATH;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED JSON PATH OUTPUT)
  if(CMAKE_HOST_WIN32)
    ap_hook_setting(JSON "${AP_JSON}" NAME distribution OUTPUT distribution)
    execute_process(COMMAND wsl.exe -d "${distribution}" --exec wslpath -a -u "${AP_PATH}"
      OUTPUT_VARIABLE value OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
  else()
    set(value "${AP_PATH}")
  endif()
  set(${AP_OUTPUT} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_command)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;SOURCE;CONFIG;JSON;TASK;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT SOURCE CONFIG JSON TASK OUTPUT)
  if(AP_TASK MATCHES "^(audit|format|secrets|whitespace)$")
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(JSON "${AP_JSON}" NAME windowsDeps OUTPUT deps)
    else()
      ap_hook_setting(JSON "${AP_JSON}" NAME linuxDeps OUTPUT deps)
    endif()
    set(command "${CMAKE_COMMAND}" "-DTASK=${AP_TASK}" "-DROOT=${AP_ROOT}" "-DSOURCE=${AP_SOURCE}"
      "-DDEPS_DIR=${deps}" "-DWORK=${AP_ROOT}/build/git-hooks/${AP_TASK}-${CMAKE_HOST_SYSTEM_NAME}"
      -P "${AP_ROOT}/cmake/scripts/hooks/HookQuickCheck.cmake")
  elseif(AP_TASK MATCHES "^windows-")
    set(command "${CMAKE_COMMAND}" "-DROOT=${AP_ROOT}" "-DSOURCE=${AP_SOURCE}"
      "-DCONFIG=${AP_CONFIG}" "-DTASK=${AP_TASK}" -P "${AP_ROOT}/.githooks/Windows.cmake")
  else()
    ap_hook_linux_path(JSON "${AP_JSON}" PATH "${AP_SOURCE}" OUTPUT source)
    ap_hook_linux_path(JSON "${AP_JSON}" PATH "${AP_ROOT}/cmake/scripts/hooks/RunHookCheck.cmake" OUTPUT script)
    foreach(key linuxCMake linuxNinja linuxDeps linuxCoverage tidy cppcheck mull)
      ap_hook_setting(JSON "${AP_JSON}" NAME "${key}" OUTPUT "${key}")
    endforeach()
    set(command "${linuxCMake}" "-DROOT=${source}" "-DTASK=${AP_TASK}" "-DNINJA=${linuxNinja}"
      "-DDEPS=${linuxDeps}" "-DTIDY=${tidy}" "-DCPPCHECK_ROOT=${cppcheck}"
      "-DMULL_ROOT=${mull}" "-DCOVERAGE_TOOL=${linuxCoverage}" -P "${script}")
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(JSON "${AP_JSON}" NAME distribution OUTPUT distribution)
      list(PREPEND command wsl.exe -d "${distribution}" --exec)
    endif()
  endif()
  set(${AP_OUTPUT} "${command}" PARENT_SCOPE)
endfunction()

function(ap_hook_cache)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;BUILD;KEY;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT BUILD KEY OUTPUT)
  set(cache "${AP_ROOT}/build/${AP_BUILD}/CMakeCache.txt")
  if(NOT EXISTS "${cache}")
    message(FATAL_ERROR "Prepare ${AP_BUILD} or supply an existing hook CONFIG file")
  endif()
  file(STRINGS "${cache}" line REGEX "^${AP_KEY}:[^=]+=" LIMIT_COUNT 1)
  if(NOT line)
    message(FATAL_ERROR "Missing ${AP_KEY} in ${cache}")
  endif()
  string(REGEX REPLACE "^[^=]+=" "" value "${line}")
  set(${AP_OUTPUT} "${value}" PARENT_SCOPE)
endfunction()

function(ap_hook_config_set)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "JSON;KEY;VALUE;OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED JSON KEY VALUE OUTPUT ALLOW_EMPTY VALUE)
  string(REPLACE "\\" "/" value "${AP_VALUE}")
  string(REPLACE "\"" "\\\"" value "${value}")
  string(JSON config SET "${AP_JSON}" "${AP_KEY}" "\"${value}\"")
  set(${AP_OUTPUT} "${config}" PARENT_SCOPE)
endfunction()

function(ap_hook_install_host)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "ROOT;CONFIG;OUTPUT;KEY_OUTPUT" "")
  ap_require_arguments(PREFIX AP REQUIRED ROOT CONFIG OUTPUT KEY_OUTPUT)
  if(EXISTS "${AP_CONFIG}")
    file(READ "${AP_CONFIG}" settings)
  else()
    set(settings "{}")
  endif()
  set(fields_to_discover
    "linuxNinja|coverage-linux|CMAKE_MAKE_PROGRAM"
    "linuxCoverage|coverage-linux|ALLPOWERS_COVERAGE_TOOL"
    "linuxDeps|coverage-linux|ALLPOWERS_DEPS_DIR"
    "linuxCMake|coverage-linux|CMAKE_COMMAND"
    "tidy|static-analysis-linux|ALLPOWERS_CLANG_TIDY"
    "cppcheck|static-analysis-linux|ALLPOWERS_CPPCHECK_ROOT"
    "mull|mutation-linux|ALLPOWERS_MULL_ROOT")
  if(CMAKE_HOST_WIN32)
    list(APPEND fields_to_discover
      "windowsNinja|coverage-windows|CMAKE_MAKE_PROGRAM"
      "windowsCoverage|coverage-windows|ALLPOWERS_COVERAGE_TOOL"
      "windowsDeps|coverage-windows|ALLPOWERS_DEPS_DIR"
      "windowsPython|coverage-windows|_Python3_EXECUTABLE"
      "qt|coverage-windows|ALLPOWERS_QT_ROOT")
  endif()
  foreach(pair IN LISTS fields_to_discover)
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 key)
    list(GET fields 1 build)
    list(GET fields 2 cache_key)
    string(JSON existing ERROR_VARIABLE missing GET "${settings}" "${key}")
    if(missing)
      ap_hook_cache(ROOT "${AP_ROOT}" BUILD "${build}" KEY "${cache_key}" OUTPUT value)
      ap_hook_config_set(JSON "${settings}" OUTPUT settings KEY "${key}" VALUE "${value}")
    endif()
  endforeach()
  if(CMAKE_HOST_WIN32)
    string(JSON existing ERROR_VARIABLE missing GET "${settings}" vcvars)
    if(missing)
      find_program(vswhere vswhere PATHS "$ENV{ProgramFiles\(x86\)}/Microsoft Visual Studio/Installer" REQUIRED)
      execute_process(COMMAND "${vswhere}" -latest -products * -requires Microsoft.VisualStudio.Component.VC.Tools.x86.x64
        -property installationPath OUTPUT_VARIABLE vs OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
      ap_hook_config_set(JSON "${settings}" OUTPUT settings KEY vcvars VALUE "${vs}/VC/Auxiliary/Build/vcvars64.bat")
    endif()
    string(JSON existing ERROR_VARIABLE missing GET "${settings}" distribution)
    if(missing)
      ap_hook_config_set(JSON "${settings}" OUTPUT settings KEY distribution VALUE Ubuntu)
    endif()
    string(JSON unused ERROR_VARIABLE missing GET "${settings}" powershell)
    if(NOT missing)
      string(JSON settings REMOVE "${settings}" powershell)
    endif()
    ap_hook_config_set(JSON "${settings}" OUTPUT settings KEY windowsCMake VALUE "${CMAKE_COMMAND}")
    foreach(key vcvars windowsNinja windowsCoverage windowsPython qt windowsDeps)
      ap_hook_setting(JSON "${settings}" NAME "${key}" OUTPUT value)
      if(NOT EXISTS "${value}")
        message(FATAL_ERROR "Missing local dependency: ${key}")
      endif()
    endforeach()
    set(config_key allpowers.hookCMakeWindows)
  elseif(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
    ap_hook_config_set(JSON "${settings}" OUTPUT settings KEY linuxCMake VALUE "${CMAKE_COMMAND}")
    set(config_key allpowers.hookCMakeLinux)
  else()
    message(FATAL_ERROR "Local hooks currently support Windows and Linux")
  endif()
  foreach(key linuxCMake linuxNinja linuxCoverage tidy cppcheck mull linuxDeps)
    ap_hook_setting(JSON "${settings}" NAME "${key}" OUTPUT value)
    if(CMAKE_HOST_WIN32)
      ap_hook_setting(JSON "${settings}" NAME distribution OUTPUT distribution)
      execute_process(COMMAND wsl.exe -d "${distribution}" --exec test -e "${value}"
        COMMAND_ERROR_IS_FATAL ANY)
    elseif(NOT EXISTS "${value}")
      message(FATAL_ERROR "Missing local dependency: ${key}")
    endif()
  endforeach()
  set(${AP_OUTPUT} "${settings}" PARENT_SCOPE)
  set(${AP_KEY_OUTPUT} "${config_key}" PARENT_SCOPE)
endfunction()
