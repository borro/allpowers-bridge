cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Arguments.cmake")
get_filename_component(ROOT "${ROOT}" ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/PublicSources.cmake")
find_package(Git REQUIRED)
if(NOT MODE)
  set(MODE index)
endif()
if(NOT MODE MATCHES "^(index|worktree|history)$")
  message(FATAL_ERROR "Audit MODE must be index, worktree or history")
endif()

# Read private identities locally, but never print their values in diagnostics.
set(identities "")
if(EXISTS "${ROOT}/.local/devices.json")
  file(READ "${ROOT}/.local/devices.json" local)
  string(JSON count LENGTH "${local}")
  if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE ${last})
      string(JSON board MEMBER "${local}" ${index})
      foreach(key mac serial)
        string(JSON value ERROR_VARIABLE error GET "${local}" "${board}" "${key}")
        if(NOT error AND value)
          string(TOLOWER "${value}" value)
          list(APPEND identities "${value}")
        endif()
      endforeach()
    endforeach()
  endif()
endif()

function(ap_audit_text)
  cmake_parse_arguments(PARSE_ARGV 0 AP "" "TEXT;LABEL" "IDENTITIES")
  ap_require_arguments(PREFIX AP REQUIRED TEXT LABEL ALLOW_EMPTY TEXT)
  string(TOLOWER "${AP_TEXT}" lower)
  if(lower MATCHES [=[([a-z]:|/mnt/[a-z])[/\\]users[/\\]|/home/[a-z0-9_.-]+/]=])
    message(FATAL_ERROR "Absolute private user path in ${AP_LABEL}")
  endif()
  foreach(identity IN LISTS AP_IDENTITIES)
    string(FIND "${lower}" "${identity}" found)
    if(NOT found LESS 0)
      message(FATAL_ERROR "Private hardware identity in ${AP_LABEL}")
    endif()
  endforeach()
  if(AP_TEXT MATCHES "-----BEGIN ([A-Z0-9]+ )*PRIVATE KEY-----" OR
      lower MATCHES [=[https?://[^ /\n"'<>:]+:[^ /\n"'<>@]+@]=])
    message(FATAL_ERROR "Possible credential in ${AP_LABEL}; inspect locally")
  endif()
  string(REGEX MATCHALL "(gh[pousr]_|github_pat_|AKIA|ASIA|sk-proj-|xox[baprs]-)[A-Za-z0-9_-]+" candidates "${AP_TEXT}")
  foreach(candidate IN LISTS candidates)
    string(LENGTH "${candidate}" length)
    if(length GREATER_EQUAL 20)
      message(FATAL_ERROR "Possible access token in ${AP_LABEL}; inspect locally")
    endif()
  endforeach()
  string(REGEX MATCHALL "[0-9a-f][0-9a-f](:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])(:[0-9a-f][0-9a-f])" addresses "${lower}")
  foreach(address IN LISTS addresses)
    if(NOT address MATCHES "^(00:00:00:00:00:00|02:00:00:00:00:(01|02|03|ff)|01:23:45:67:89:ab)$")
      message(FATAL_ERROR "Non-synthetic device address in ${AP_LABEL}")
    endif()
  endforeach()
endfunction()

if(MODE STREQUAL "history")
  # All reachable branches/tags, including deleted files and commit messages.
  execute_process(COMMAND "${GIT_EXECUTABLE}" log --all --format= --name-only
    WORKING_DIRECTORY "${ROOT}" OUTPUT_VARIABLE names COMMAND_ERROR_IS_FATAL ANY)
  if(names MATCHES "(^|\n)([^\n]*/)?(\\.env[^/\n]*|[^\n]*\\.(bin|elf|exe|dll|sys|zip|7z|pfx|p12|pem|key|sqlite3|db|log))\n" OR
      names MATCHES "(^|\n)(\\.local|recovery|dist|build|captures|reports)/")
    message(FATAL_ERROR "Private/generated file in reachable Git history; review before publishing")
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" log --all --format=fuller --patch
    --no-ext-diff --no-renames WORKING_DIRECTORY "${ROOT}"
    OUTPUT_VARIABLE history COMMAND_ERROR_IS_FATAL ANY)
  ap_audit_text(IDENTITIES ${identities} TEXT "${history}" LABEL "reachable Git history")
else()
  if(MODE STREQUAL "index")
    execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files --others --exclude-standard
      WORKING_DIRECTORY "${ROOT}" OUTPUT_VARIABLE untracked COMMAND_ERROR_IS_FATAL ANY)
    if(untracked)
      message(FATAL_ERROR "Review/stage public files before index audit:\n${untracked}")
    endif()
    execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files "--format=%(objectname) %(stage) %(path)"
      WORKING_DIRECTORY "${ROOT}"
      OUTPUT_VARIABLE inventory COMMAND_ERROR_IS_FATAL ANY)
    string(REPLACE "\n" ";" entries "${inventory}")
    list(FILTER entries EXCLUDE REGEX "^$")
    if(NOT entries)
      message(FATAL_ERROR "Public source inventory is empty")
    endif()
    set(names)
    set(objects)
    foreach(entry IN LISTS entries)
      if(NOT entry MATCHES "^([0-9a-f]+) 0 (.+)$")
        message(FATAL_ERROR "Index audit requires resolved stage-zero files")
      endif()
      set(object "${CMAKE_MATCH_1}")
      set(name "${CMAKE_MATCH_2}")
      ap_check_public_path(NAME "${name}")
      if(NOT name MATCHES "\\.(png|ico)$")
        list(APPEND names "${name}")
        list(APPEND objects "${object}")
      endif()
    endforeach()
    if(NOT objects)
      message(STATUS "Publication audit passed (${MODE})")
      return()
    endif()
    # One Git process reads the exact staged blob IDs from this snapshot. Never
    # substitute working-tree files or reuse a previous successful audit.
    file(MAKE_DIRECTORY "${ROOT}/build/audit")
    string(RANDOM LENGTH 20 ALPHABET 0123456789abcdef nonce)
    set(batch "${ROOT}/build/audit/index-${nonce}")
    set(marker "AP-AUDIT-${nonce} ")
    list(JOIN objects "\n" requests)
    file(WRITE "${batch}.input" "${requests}\n")
    execute_process(COMMAND "${GIT_EXECUTABLE}" cat-file "--batch=${marker}%(objectname) %(objecttype)"
      WORKING_DIRECTORY "${ROOT}" INPUT_FILE "${batch}.input" OUTPUT_VARIABLE indexed
      RESULT_VARIABLE result ERROR_VARIABLE error)
    file(REMOVE "${batch}.input")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "Cannot read staged objects: ${error}")
    endif()
    # CMake normalizes CRLF/NUL in process output (as in the old per-file show),
    # so Git byte sizes cannot frame this string. Use explicit markers instead.
    # A marker collision in any payload is rejected, never interpreted as data.
    string(REGEX MATCHALL "${marker}" markers "${indexed}")
    list(LENGTH markers marker_count)
    list(LENGTH objects object_count)
    if(NOT marker_count EQUAL object_count)
      message(FATAL_ERROR "Unexpected staged blob boundary count")
    endif()
    set(blob_index 0)
    foreach(object IN LISTS objects)
      string(REGEX MATCH "^${marker}${object} blob\n" header "${indexed}")
      if(NOT header)
        message(FATAL_ERROR "Missing or malformed staged blob")
      endif()
      string(LENGTH "${header}" header_size)
      string(SUBSTRING "${indexed}" ${header_size} -1 indexed)
      string(FIND "${indexed}" "${marker}" next)
      if(next LESS 0)
        set(index_text_${blob_index} "${indexed}")
        set(indexed "")
      else()
        string(SUBSTRING "${indexed}" 0 ${next} index_text_${blob_index})
        string(SUBSTRING "${indexed}" ${next} -1 indexed)
      endif()
      math(EXPR blob_index "${blob_index}+1")
    endforeach()
    if(indexed)
      message(FATAL_ERROR "Unexpected trailing staged objects")
    endif()
  else()
    ap_public_sources(OUTPUT names ROOT "${ROOT}")
  endif()
  if(NOT names)
    message(FATAL_ERROR "Public source inventory is empty")
  endif()
  set(blob_index 0)
  foreach(name IN LISTS names)
    ap_check_public_path(NAME "${name}")
    if(name MATCHES "\\.(png|ico)$")
      continue()
    endif()
    if(MODE STREQUAL "index")
      set(text "${index_text_${blob_index}}")
      math(EXPR blob_index "${blob_index}+1")
    else()
      file(READ "${ROOT}/${name}" text)
    endif()
    ap_audit_text(IDENTITIES ${identities} TEXT "${text}" LABEL "${MODE}: ${name}")
  endforeach()
endif()
message(STATUS "Publication audit passed (${MODE})")
