cmake_minimum_required(VERSION 4.4)
if(NOT CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  message(FATAL_ERROR "Firmware compilation is Linux-only; use the firmware-linux preset in Linux/WSL")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Json.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/Partitions.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../quality/CheckContracts.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/HistoryCompatibility.cmake")
if(NOT JOBS)
  set(JOBS 2)
endif()
if(IDENTITY_FILE)
  include("${IDENTITY_FILE}")
  set(VERSION "${ALLPOWERS_VERSION}")
endif()
if(NOT EXISTS "${CLI}" OR NOT IS_DIRECTORY "${DATA}/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
  message(FATAL_ERROR "Arduino CLI/SDK missing. Build target arduino-setup first.")
endif()
execute_process(COMMAND "${CLI}" version --format json OUTPUT_VARIABLE version COMMAND_ERROR_IS_FATAL ANY)
string(JSON version GET "${version}" VersionString)
if(NOT version STREQUAL ALLPOWERS_ARDUINO_VERSION)
  message(FATAL_ERROR "Expected Arduino CLI ${ALLPOWERS_ARDUINO_VERSION}, found ${version}")
endif()
ap_source_hashes(OUTPUT before ROOT "${ROOT}" DIRECTORIES core/src firmware)
file(SHA256 "${ROOT}/core/library.properties.in" library_metadata_hash)
string(JSON before SET "${before}" "core/library.properties.in" "\"${library_metadata_hash}\"")
set(sketch "${WORK}/sketch/R2500Adapter")
set(library "${WORK}/library/AllpowersCore")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/release/StageFirmware.cmake")
ap_stage_firmware(ROOT "${ROOT}" WORK "${WORK}")
file(MAKE_DIRECTORY "${OUTPUT}")
if(NOT ALLPOWERS_BUILD_COMMIT)
  set(ALLPOWERS_BUILD_COMMIT source-archive)
endif()
if(NOT ALLPOWERS_BUILD_DIRTY)
  set(ALLPOWERS_BUILD_DIRTY 0)
endif()
file(CONFIGURE OUTPUT "${sketch}/ProductIdentity.h" CONTENT
  "#pragma once\n#define AP_PRODUCT_VERSION \"${VERSION}\"\n#define AP_PRODUCT_COMMIT \"${ALLPOWERS_BUILD_COMMIT}\"\n#define AP_PRODUCT_DIRTY ${ALLPOWERS_BUILD_DIRTY}\n")
string(REGEX MATCH "^[0-9]+\\.[0-9]+\\.[0-9]+" LIBRARY_VERSION "${VERSION}")
configure_file("${ROOT}/core/library.properties.in" "${library}/library.properties" @ONLY)
execute_process(COMMAND "${CLI}" --config-file "${CONFIG}" compile --fqbn "${ALLPOWERS_FQBN}"
  --jobs "${JOBS}"
  --library "${library}" --build-path "${WORK}/compile" --output-dir "${OUTPUT}"
  --build-property "compiler.cpp.extra_flags=-std=gnu++${ALLPOWERS_CXX_STANDARD} -DADAPTER_BOARD=${BOARD_NUMBER}" "${sketch}"
  COMMAND_ERROR_IS_FATAL ANY)
file(READ "${ROOT}/tests/fixtures/usb-contract.json" contract)
ap_partitions(OUTPUT partitions BINARY "${OUTPUT}/R2500Adapter.ino.partitions.bin" CONTRACT "${contract}")
set(sdk "${DATA}/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
file(COPY_FILE "${sdk}/tools/partitions/boot_app0.bin" "${OUTPUT}/boot_app0.bin" ONLY_IF_DIFFERENT)
file(GLOB generated "${OUTPUT}/*")
foreach(path IN LISTS generated)
  if(NOT path MATCHES "\\.bin$" OR path MATCHES "\\.merged\\.")
    file(REMOVE "${path}")
  endif()
endforeach()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" "-DWORK=${WORK}"
  "-DOUTPUT=${OUTPUT}" "-DDATA=${DATA}" "-DCACHE=${LEGAL_CACHE}" "-DVERSION=${VERSION}"
  "-DPython3_EXECUTABLE=${Python3_EXECUTABLE}"
  -P "${ROOT}/cmake/scripts/release/PrepareFirmwareKit.cmake" COMMAND_ERROR_IS_FATAL ANY)
set(files "{}")
file(GLOB_RECURSE artifacts LIST_DIRECTORIES FALSE RELATIVE "${OUTPUT}" "${OUTPUT}/*")
foreach(name IN LISTS artifacts)
  file(SHA256 "${OUTPUT}/${name}" digest)
  string(JSON files SET "${files}" "${name}" "\"${digest}\"")
endforeach()
set(manifest "{}")
foreach(key board project_version host_platform firmware_protocol_version arduino_cli esp32_core fqbn maintenance)
  if(key STREQUAL board)
    set(value "${BOARD}")
  elseif(key STREQUAL project_version)
    set(value "${VERSION}")
  elseif(key STREQUAL host_platform)
    set(value "${CMAKE_HOST_SYSTEM_NAME}")
  elseif(key STREQUAL firmware_protocol_version)
    set(value R)
  elseif(key STREQUAL arduino_cli)
    set(value "${ALLPOWERS_ARDUINO_VERSION}")
  elseif(key STREQUAL esp32_core)
    set(value "${ALLPOWERS_ESP32_VERSION}")
  elseif(key STREQUAL fqbn)
    set(value "${ALLPOWERS_FQBN}")
  else()
    set(value "BOOT-R2500!!")
  endif()
  ap_json_quote(OUTPUT value VALUE "${value}")
  string(JSON manifest SET "${manifest}" "${key}" "${value}")
endforeach()
string(JSON descriptor GET "${contract}" descriptor_sha256)
string(JSON manifest SET "${manifest}" descriptor_sha256 "\"${descriptor}\"")
string(JSON manifest SET "${manifest}" files "${files}")
string(JSON manifest SET "${manifest}" partitions "${partitions}")
string(JSON manifest SET "${manifest}" sources "${before}")
string(JSON manifest SET "${manifest}" efuse_writes false)
# Archive compatibility is part of the maintenance contract. Require an actual
# compiled marker as well as the manifest so old raw images cannot be declared
# compatible by adding metadata beside them.
ap_history_metadata(OUTPUT history_storage BINARY "${OUTPUT}/R2500Adapter.ino.bin")
string(JSON manifest SET "${manifest}" history_storage "${history_storage}")
ap_json_quote(OUTPUT commit VALUE "${ALLPOWERS_BUILD_COMMIT}")
string(JSON manifest SET "${manifest}" build_commit "${commit}")
if(ALLPOWERS_BUILD_DIRTY)
  string(JSON manifest SET "${manifest}" build_dirty true)
else()
  string(JSON manifest SET "${manifest}" build_dirty false)
endif()
ap_source_hashes(OUTPUT after ROOT "${ROOT}" DIRECTORIES core/src firmware)
file(SHA256 "${ROOT}/core/library.properties.in" library_metadata_hash)
string(JSON after SET "${after}" "core/library.properties.in" "\"${library_metadata_hash}\"")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "Firmware build modified its source files")
endif()
file(WRITE "${OUTPUT}/manifest.json" "${manifest}\n")
