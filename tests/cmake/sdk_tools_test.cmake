cmake_minimum_required(VERSION 4.4)
if(CASE STREQUAL ninja-worker)
  include("${FIXTURE}/cmake/modules/sdk/Ninja.cmake")
  ap_setup_ninja(DESTINATION "${DESTINATION}" OUTPUT tool)
  return()
elseif(CASE STREQUAL wdk-reject)
  include("${FIXTURE}/cmake/modules/sdk/Wdk.cmake")
  ap_setup_wdk(DEPS_DIR "${DESTINATION}" OUTPUT tool)
  return()
elseif(CASE STREQUAL missing-argument)
  include("${ROOT}/cmake/modules/sdk/${MODULE}.cmake")
  cmake_language(CALL "${FUNCTION}")
  return()
elseif(CASE STREQUAL lock-probe)
  file(LOCK "${LOCK}" GUARD PROCESS TIMEOUT 0 RESULT_VARIABLE status)
  if(status STREQUAL "0")
    message(FATAL_ERROR "Installer lock was not held")
  endif()
  return()
elseif(CASE STREQUAL setup-lock)
  include("${FIXTURE}/cmake/modules/sdk/${MODULE}.cmake")
  cmake_language(CALL "${FUNCTION}" WORK "${DESTINATION}" ${OPTIONS} OUTPUT tool)
  return()
endif()

# All payloads are local. No dependency service or existing SDK is required.
set(fixture "${WORK}/fixture source")
set(destination "${WORK}/ninja install")
file(MAKE_DIRECTORY "${fixture}" "${destination}" "${WORK}/payload")
file(COPY "${ROOT}/cmake" DESTINATION "${fixture}")
if(CMAKE_HOST_WIN32)
  set(executable ninja.exe)
  set(platform WINDOWS)
  set(archive_name ninja-win.zip)
  set(extension .exe)
else()
  set(executable ninja)
  set(platform LINUX)
  set(archive_name ninja-linux.zip)
endif()
execute_process(COMMAND "${NINJA}" --version OUTPUT_VARIABLE version
  OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
file(COPY_FILE "${NINJA}" "${WORK}/payload/${executable}" ONLY_IF_DIFFERENT)
set(archive "${destination}/${version}-${archive_name}")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip -- "${executable}"
  WORKING_DIRECTORY "${WORK}/payload" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${archive}" hash)
file(WRITE "${fixture}/cmake/Dependencies.cmake"
  "set(ALLPOWERS_NINJA_VERSION ${version})\nset(ALLPOWERS_NINJA_${platform}_SHA256 ${hash})\n")
include("${fixture}/cmake/modules/sdk/Ninja.cmake")
set(ALLPOWERS_NINJA_VERSION caller-value)
set(ENV{GITHUB_PATH} "${WORK}/ci-path.txt")
file(WRITE "$ENV{GITHUB_PATH}" "")
ap_setup_ninja(DESTINATION "${destination}" OUTPUT tool)
if(NOT tool STREQUAL "${destination}/${executable}" OR NOT ALLPOWERS_NINJA_VERSION STREQUAL caller-value)
  message(FATAL_ERROR "Ninja installer lost its explicit result or leaked dependency variables")
endif()
file(READ "$ENV{GITHUB_PATH}" ci_path)
if(ci_path)
  message(FATAL_ERROR "Library installer changed CI environment")
endif()
execute_process(COMMAND "${CMAKE_COMMAND}" "-DDESTINATION=${destination}"
  -P "${fixture}/cmake/scripts/sdk/SetupNinja.cmake" COMMAND_ERROR_IS_FATAL ANY)
file(READ "$ENV{GITHUB_PATH}" ci_path)
if(NOT ci_path STREQUAL "${destination}\n")
  message(FATAL_ERROR "Ninja command-line entry lost its CI integration")
endif()
unset(ENV{GITHUB_PATH})

# Both producers must restore the executable from the pinned archive safely.
file(WRITE "${tool}" "damaged executable\n")
file(CONFIGURE OUTPUT "${WORK}/parallel/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(ConcurrentToolInstall NONE)
foreach(index RANGE 1 2)
  add_custom_target(install-${index} ALL COMMAND "@CMAKE_COMMAND@" -DCASE=ninja-worker
    "-DFIXTURE=@fixture@" "-DDESTINATION=@destination@" -P "@CMAKE_CURRENT_LIST_FILE@" VERBATIM)
endforeach()
]=] @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/parallel" -B "${WORK}/parallel-build"
  -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}" COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${WORK}/parallel-build" --parallel 2
  COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${NINJA}" expected)
file(SHA256 "${tool}" actual)
if(NOT actual STREQUAL expected)
  message(FATAL_ERROR "Concurrent Ninja install did not restore the original executable")
endif()

set(deps "${WORK}/wdk cache")
file(MAKE_DIRECTORY "${deps}/downloads" "${WORK}/wdk-payload/c/Include/wdf/kmdf/fixture")
file(WRITE "${WORK}/wdk-payload/c/Include/wdf/kmdf/fixture/wdf.h" "// WDK fixture\n")
set(archive "${deps}/downloads/microsoft.windows.wdk.x64.fixture.nupkg")
execute_process(COMMAND "${CMAKE_COMMAND}" -E tar cf "${archive}" --format=zip -- c
  WORKING_DIRECTORY "${WORK}/wdk-payload" COMMAND_ERROR_IS_FATAL ANY)
file(SHA256 "${archive}" hash)
file(APPEND "${fixture}/cmake/Dependencies.cmake"
  "set(ALLPOWERS_WDK_VERSION fixture)\nset(ALLPOWERS_KMDF_VERSION fixture)\nset(ALLPOWERS_WDK_SHA256 ${hash})\n")
include("${fixture}/cmake/modules/sdk/Wdk.cmake")
ap_setup_wdk(DEPS_DIR "${deps}" OUTPUT installed)
set(header "${installed}/c/Include/wdf/kmdf/fixture/wdf.h")
if(NOT installed STREQUAL "${deps}/wdk/fixture" OR NOT EXISTS "${header}")
  message(FATAL_ERROR "WDK installer returned the wrong installation")
endif()
# A second invocation in the same process must release/reacquire its lock.
file(TIMESTAMP "${header}" before "%s")
ap_setup_wdk(DEPS_DIR "${deps}" OUTPUT installed)
file(TIMESTAMP "${header}" after "%s")
if(NOT before STREQUAL after)
  message(FATAL_ERROR "WDK cache hit rewrote installed headers")
endif()
file(WRITE "${archive}" "damaged cached archive\n")
execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=wdk-reject "-DFIXTURE=${fixture}"
  "-DDESTINATION=${deps}" -P "${CMAKE_CURRENT_LIST_FILE}"
  RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
file(READ "${archive}" rejected)
if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "checksum mismatch" OR
    NOT rejected STREQUAL "damaged cached archive\n" OR NOT EXISTS "${header}")
  message(FATAL_ERROR "WDK did not reject a corrupt archive while preserving evidence and installation")
endif()
foreach(pair Ninja:ap_setup_ninja Upx:ap_setup_upx Wdk:ap_setup_wdk ClangFormat:ap_setup_clang_format
    Coverage:ap_setup_coverage Mutation:ap_setup_mutation AnalysisTools:ap_setup_analysis_tools)
  string(REPLACE ":" ";" pair "${pair}")
  list(GET pair 0 module)
  list(GET pair 1 function)
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=missing-argument "-DROOT=${ROOT}"
    "-DMODULE=${module}" "-DFUNCTION=${function}" -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "Missing required argument")
    message(FATAL_ERROR "${module} accepted missing arguments or started setup before validation")
  endif()
endforeach()
# Check the installation lock at the download boundary, without fetching a real
# SDK. A child process must be unable to acquire it. Omitting the outer lock
# makes this control fail, even though the real downloader has its own lock.
file(CONFIGURE OUTPUT "${fixture}/cmake/modules/common/Download.cmake" CONTENT [=[
include("${CMAKE_CURRENT_LIST_DIR}/Arguments.cmake")
function(ap_download_verified)
  execute_process(COMMAND "@CMAKE_COMMAND@" -DCASE=lock-probe "-DLOCK=${LOCK}"
    -P "@CMAKE_CURRENT_LIST_FILE@" RESULT_VARIABLE status)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Installation is not serialized")
  endif()
  message(FATAL_ERROR "INSTALLATION_LOCK_CONFIRMED")
endfunction()
]=] @ONLY)
set(lock_cases Coverage:ap_setup_coverage:coverage)
if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
  list(APPEND lock_cases Mutation:ap_setup_mutation:mutation
    AnalysisTools:ap_setup_analysis_tools:analysis_tools)
endif()
foreach(record IN LISTS lock_cases)
  string(REPLACE ":" ";" fields "${record}")
  list(GET fields 0 module)
  list(GET fields 1 function)
  list(GET fields 2 lock_name)
  set(destination "${WORK}/locked ${module}")
  set(options)
  if(module STREQUAL "AnalysisTools")
    set(options KIND cppcheck)
  endif()
  execute_process(COMMAND "${CMAKE_COMMAND}" -DCASE=setup-lock "-DFIXTURE=${fixture}"
    "-DMODULE=${module}" "-DFUNCTION=${function}" "-DDESTINATION=${destination}"
    "-DLOCK=${destination}/.setup-${lock_name}.lock" "-DOPTIONS=${options}"
    -P "${CMAKE_CURRENT_LIST_FILE}"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT "${output}${error}" MATCHES "INSTALLATION_LOCK_CONFIRMED")
    message(FATAL_ERROR "${module} installation lock control failed: ${output}${error}")
  endif()
endforeach()
message(STATUS "SDK tool controls passed: explicit results, scope, CI adapter, concurrent restore and corrupt-cache rejection")
