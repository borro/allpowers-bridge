cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/Dependencies.cmake")
set(package "microsoft.windows.wdk.x64.${ALLPOWERS_WDK_VERSION}.nupkg")
file(MAKE_DIRECTORY "${ROOT}/build/deps/downloads")
set(archive "${ROOT}/build/deps/downloads/${package}")
if(NOT EXISTS "${archive}")
  file(DOWNLOAD "https://api.nuget.org/v3-flatcontainer/microsoft.windows.wdk.x64/${ALLPOWERS_WDK_VERSION}/${package}"
    "${archive}" EXPECTED_HASH "SHA256=${ALLPOWERS_WDK_SHA256}" TLS_VERIFY ON)
endif()
file(SHA256 "${archive}" actual)
if(NOT actual STREQUAL ALLPOWERS_WDK_SHA256)
  message(FATAL_ERROR "WDK package checksum mismatch")
endif()
if(NOT EXISTS "${ROOT}/build/deps/wdk-26100/c/Include/wdf/kmdf/1.31/wdf.h")
  file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${ROOT}/build/deps/wdk-26100")
endif()
