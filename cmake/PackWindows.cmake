cmake_minimum_required(VERSION 4.4)

function(ap_pack_windows)
  if(NOT ALLPOWERS_BUILD_ROOT OR NOT CPACK_PACKAGE_DIRECTORY OR
      NOT CPACK_TEMPORARY_DIRECTORY OR NOT CPACK_PACKAGE_VERSION)
    message(FATAL_ERROR "UPX packaging requires the configured CPack staging directory and version")
  endif()
  file(REAL_PATH "${CPACK_PACKAGE_DIRECTORY}/_CPack_Packages" package_root)
  file(REAL_PATH "${CPACK_TEMPORARY_DIRECTORY}" stage)
  cmake_path(IS_PREFIX package_root "${stage}" NORMALIZE inside)
  if(NOT inside OR stage STREQUAL package_root)
    message(FATAL_ERROR "UPX may modify only a CPack staging subdirectory")
  endif()
  # Validate the entire stage before downloading a tool or modifying any file.
  foreach(app AllpowersMonitor AllpowersWidget)
    if(NOT EXISTS "${stage}/${app}.exe" OR IS_SYMLINK "${stage}/${app}.exe")
      message(FATAL_ERROR "Missing or symlinked staged executable: ${app}")
    endif()
  endforeach()
  set(DEPS_DIR "${ALLPOWERS_DEPS_DIR}")
  set(WORK "${ALLPOWERS_BUILD_ROOT}/tools/upx")
  include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/SetupUpx.cmake")
  foreach(app AllpowersMonitor AllpowersWidget)
    set(exe "${stage}/${app}.exe")
    file(SIZE "${exe}" before)
    execute_process(COMMAND "${UPX_EXECUTABLE}" -9 "${exe}" COMMAND_ERROR_IS_FATAL ANY)
    execute_process(COMMAND "${UPX_EXECUTABLE}" -t "${exe}" COMMAND_ERROR_IS_FATAL ANY)
    file(SIZE "${exe}" after)
    if(NOT after LESS before)
      message(FATAL_ERROR "UPX did not reduce ${app}")
    endif()
    set(options)
    if(app STREQUAL "AllpowersWidget")
      list(APPEND options -DWIDGET=ON)
    elseif(ALLPOWERS_DRIVER_PACKAGE_DIR)
      list(APPEND options "-DDRIVER_PACKAGE=${ALLPOWERS_DRIVER_PACKAGE_DIR}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DEXE=${exe}"
      "-DWORK=${ALLPOWERS_BUILD_ROOT}/packed-exe-checks/${app}"
      "-DVERSION=${CPACK_PACKAGE_VERSION}" ${options}
      -P "${ALLPOWERS_ROOT}/cmake/CheckSingleExe.cmake" COMMAND_ERROR_IS_FATAL ANY)
    message(STATUS "Packed and verified ${app}: ${before} -> ${after} bytes")
  endforeach()
endfunction()

ap_pack_windows()
