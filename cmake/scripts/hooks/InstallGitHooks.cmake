cmake_minimum_required(VERSION 4.4)
find_package(Git REQUIRED)
if(NOT ROOT)
  get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
endif()
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/hooks/GitHookSupport.cmake")
include("${ROOT}/.githooks/Host.cmake")
if(NOT CONFIG)
  set(CONFIG "${ROOT}/.local/hooks.json")
endif()
ap_hook_install_host(ROOT "${ROOT}" CONFIG "${CONFIG}" OUTPUT config KEY_OUTPUT key)
file(MAKE_DIRECTORY "${ROOT}/.local")
file(WRITE "${ROOT}/.local/hooks.json" "${config}\n")
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" config --get core.hooksPath
  OUTPUT_VARIABLE previous OUTPUT_STRIP_TRAILING_WHITESPACE RESULT_VARIABLE code)
if(NOT code EQUAL 0 AND NOT code EQUAL 1)
  message(FATAL_ERROR "Cannot read hook configuration")
endif()
if(previous AND NOT previous STREQUAL ".githooks")
  message(FATAL_ERROR "Existing core.hooksPath=${previous}; integrate the existing hooks first")
endif()
ap_hook_git(OUTPUT hooks ROOT "${ROOT}" ARGS rev-parse --path-format=absolute --git-path hooks)
foreach(name pre-commit pre-push)
  if(NOT previous AND EXISTS "${hooks}/${name}")
    message(FATAL_ERROR "An existing ${name} hook needs to be integrated first")
  endif()
  file(CHMOD "${ROOT}/.githooks/${name}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE
    GROUP_READ GROUP_EXECUTE WORLD_READ WORLD_EXECUTE)
endforeach()
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" config --local "${key}" "${CMAKE_COMMAND}"
  COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${ROOT}" config --local core.hooksPath .githooks
  COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "Installed CMake/CTest hooks; local tool paths: ${ROOT}/.local/hooks.json")
