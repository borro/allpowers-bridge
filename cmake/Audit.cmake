cmake_minimum_required(VERSION 3.25)
find_package(Git REQUIRED)
execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files WORKING_DIRECTORY "${ROOT}"
  OUTPUT_VARIABLE tracked COMMAND_ERROR_IS_FATAL ANY)
execute_process(COMMAND "${GIT_EXECUTABLE}" ls-files --others --exclude-standard WORKING_DIRECTORY "${ROOT}"
  OUTPUT_VARIABLE untracked COMMAND_ERROR_IS_FATAL ANY)
if(untracked)
  message(FATAL_ERROR "Stage/review public files before auditing:\n${untracked}")
endif()
if(NOT tracked)
  message(FATAL_ERROR "Git index is empty")
endif()
set(identities "")
if(EXISTS "${ROOT}/.local/devices.json")
  file(READ "${ROOT}/.local/devices.json" local)
  string(JSON count LENGTH "${local}")
  math(EXPR last "${count}-1")
  foreach(index RANGE ${last})
    string(JSON board MEMBER "${local}" ${index})
    foreach(key mac serial)
      string(JSON value ERROR_VARIABLE error GET "${local}" "${board}" "${key}")
      if(NOT error AND value)
        string(TOLOWER "${value}" value)
        list(APPEND identities "${value}")
      endif()
    endforeach()
  endforeach()
endif()
string(REPLACE "\n" ";" names "${tracked}")
foreach(name IN LISTS names)
  if(NOT name)
    continue()
  endif()
  if(name MATCHES "\\.(bin|zip|elf|dll|so|exe|sqlite3|log|pdb|jsonl)$" OR
      name MATCHES "^(\\.local|recovery|artifacts|evidence|research|dist|build|\\.venv)/")
    message(FATAL_ERROR "Private/generated file in index: ${name}")
  endif()
  if(name MATCHES "\\.(png|ico)$")
    continue()
  endif()
  execute_process(COMMAND "${GIT_EXECUTABLE}" show ":${name}" WORKING_DIRECTORY "${ROOT}"
    OUTPUT_VARIABLE text COMMAND_ERROR_IS_FATAL ANY)
  string(TOLOWER "${text}" text)
  if(text MATCHES [=[([a-z]:|/mnt/[a-z])[/\\]users[/\\]]=])
    message(FATAL_ERROR "Absolute user path in index: ${name}")
  endif()
  foreach(identity IN LISTS identities)
    string(FIND "${text}" "${identity}" found)
    if(NOT found LESS 0)
      message(FATAL_ERROR "Private hardware identity in index: ${name}")
    endif()
  endforeach()
endforeach()
message(STATUS "Git index audit passed")
