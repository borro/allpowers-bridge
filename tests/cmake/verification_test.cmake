cmake_minimum_required(VERSION 4.4)
foreach(path ROOT WORK CXX NINJA)
  file(TO_CMAKE_PATH "${${path}}" ${path})
endforeach()
set(fixture "${WORK}/graph with spaces")
file(MAKE_DIRECTORY "${fixture}/child")
file(CONFIGURE OUTPUT "${fixture}/child/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(CheckChild LANGUAGES CXX)
if(NOT EXISTS "${CMAKE_BINARY_DIR}/../prepared")
  message(FATAL_ERROR "Child configured before its tool dependency")
endif()
enable_testing()
add_executable(unit main.cpp)
file(GENERATE OUTPUT "${CMAKE_BINARY_DIR}/unit-path" CONTENT "$<TARGET_FILE:unit>")
add_custom_target(native-tests DEPENDS unit)
add_test(NAME unit COMMAND unit)
add_test(NAME control COMMAND "${CMAKE_COMMAND}" -P "${CMAKE_SOURCE_DIR}/control.cmake")
set(ALLPOWERS_BUILD_JOBS 2)
include("@ROOT@/cmake/modules/quality/Verification.cmake")
ap_add_check_target(ROOT "${CMAKE_SOURCE_DIR}" BUILD_ROOT "${CMAKE_BINARY_DIR}")
]=] @ONLY)
file(WRITE "${fixture}/child/main.cpp" "int main() { return 0; }\n")
file(WRITE "${fixture}/child/control.cmake" [=[
file(APPEND "${CMAKE_CURRENT_LIST_DIR}/runs" "checked\n")
if(EXISTS "${CMAKE_CURRENT_LIST_DIR}/fail")
  message(FATAL_ERROR "Deliberate failed check")
endif()
]=])
file(WRITE "${fixture}/child/CMakePresets.json" [=[
{"version":6,"configurePresets":[{"name":"fixture","generator":"Ninja"}]}
]=])
file(CONFIGURE OUTPUT "${fixture}/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(VerificationGraph NONE)
set_property(GLOBAL PROPERTY JOB_POOLS verification=2)
include("@ROOT@/cmake/modules/quality/Verification.cmake")
add_custom_target(prepare COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_BINARY_DIR}/prepared")
add_custom_target(check-all)
ap_add_check_configuration(ROOT "${CMAKE_SOURCE_DIR}/child" BUILD_ROOT "${CMAKE_BINARY_DIR}"
  PRESET fixture DEPENDS prepare OPTIONS "-DCMAKE_CXX_COMPILER=@CXX@" -DCMAKE_BUILD_TYPE=Release)
add_custom_target(package COMMAND "${CMAKE_COMMAND}" -E touch "${CMAKE_BINARY_DIR}/packaged"
  DEPENDS check-all)
]=] @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${fixture}" -B "${fixture}/build"
  -G Ninja "-DCMAKE_MAKE_PROGRAM=${NINJA}" COMMAND_ERROR_IS_FATAL ANY)
foreach(run RANGE 1 2)
  execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --target package --parallel 2
    COMMAND_ERROR_IS_FATAL ANY)
  if(NOT EXISTS "${fixture}/build/packaged")
    message(FATAL_ERROR "Successful checks did not permit packaging")
  endif()
  file(READ "${fixture}/build/fixture/unit-path" executable)
  file(TIMESTAMP "${executable}" timestamp "%s")
  if(run EQUAL 2 AND NOT timestamp STREQUAL previous)
    message(FATAL_ERROR "Warm verification needlessly rebuilt an unchanged executable")
  endif()
  set(previous "${timestamp}")
endforeach()
file(STRINGS "${fixture}/child/runs" runs)
list(LENGTH runs count)
if(NOT count EQUAL 2)
  message(FATAL_ERROR "Warm builds must rerun checks, not reuse a success stamp")
endif()
file(REMOVE "${fixture}/build/packaged")
file(WRITE "${fixture}/child/fail" "negative control")
execute_process(COMMAND "${CMAKE_COMMAND}" --build "${fixture}/build" --target package --parallel 2
  RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
if(code EQUAL 0 OR EXISTS "${fixture}/build/packaged" OR NOT "${out}${err}" MATCHES "Deliberate failed check")
  message(FATAL_ERROR "A failed child check did not block packaging: ${out}${err}")
endif()
file(REMOVE "${fixture}/child/fail" "${fixture}/child/runs")
message(STATUS "Cold build dependencies, repeated checks and packaging failure gate passed")
