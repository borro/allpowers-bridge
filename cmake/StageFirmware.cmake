# Mirror only managed build inputs. Preserve unchanged timestamps and the two
# generated metadata files; the compiler cache lives outside these directories.
function(ap_sync_firmware_inputs source destination generated)
  if(IS_SYMLINK "${source}" OR IS_SYMLINK "${destination}")
    message(FATAL_ERROR "Firmware staging must not use linked directories")
  endif()
  if(ARGC GREATER 3)
    file(GLOB_RECURSE inputs LIST_DIRECTORIES TRUE RELATIVE "${source}" "${source}/${ARGV3}/*")
    list(APPEND inputs "${ARGV3}")
  else()
    file(GLOB_RECURSE inputs LIST_DIRECTORIES TRUE RELATIVE "${source}" "${source}/*")
  endif()
  list(FILTER inputs EXCLUDE REGEX "(^|/)build(/|$)")
  foreach(relative IN LISTS inputs)
    if(IS_SYMLINK "${source}/${relative}")
      message(FATAL_ERROR "Firmware inputs must not use links: ${source}/${relative}")
    endif()
  endforeach()
  file(GLOB_RECURSE staged LIST_DIRECTORIES TRUE RELATIVE "${destination}" "${destination}/*")
  # Validate the entire old tree before copying or removing anything. In
  # particular, never traverse a junction/symlink into an external directory.
  foreach(relative IN LISTS staged)
    set(path "${destination}/${relative}")
    if(IS_SYMLINK "${path}")
      message(FATAL_ERROR "Firmware staging must not contain linked inputs: ${path}")
    endif()
    file(REAL_PATH "${path}" resolved)
    cmake_path(IS_PREFIX destination "${resolved}" NORMALIZE inside)
    if(NOT inside)
      message(FATAL_ERROR "Firmware staging input escaped its workspace: ${path}")
    endif()
  endforeach()
  # Children first, including the file -> directory and directory -> file cases.
  list(SORT staged ORDER DESCENDING)
  foreach(relative IN LISTS staged)
    if(relative STREQUAL generated)
      continue()
    endif()
    set(path "${destination}/${relative}")
    if(NOT relative IN_LIST inputs OR
        (IS_DIRECTORY "${path}" AND NOT IS_DIRECTORY "${source}/${relative}") OR
        (NOT IS_DIRECTORY "${path}" AND IS_DIRECTORY "${source}/${relative}"))
      file(REMOVE_RECURSE "${path}")
    endif()
  endforeach()
  foreach(relative IN LISTS inputs)
    if(IS_DIRECTORY "${source}/${relative}")
      file(MAKE_DIRECTORY "${destination}/${relative}")
    else()
      get_filename_component(parent "${destination}/${relative}" DIRECTORY)
      file(MAKE_DIRECTORY "${parent}")
      file(COPY_FILE "${source}/${relative}" "${destination}/${relative}" ONLY_IF_DIFFERENT)
    endif()
  endforeach()
endfunction()

function(ap_stage_firmware root work)
  file(MAKE_DIRECTORY "${work}")
  file(REAL_PATH "${work}" workspace)
  foreach(relative sketch/R2500Adapter library/AllpowersCore)
    set(destination "${workspace}/${relative}")
    get_filename_component(parent "${destination}" DIRECTORY)
    if(IS_SYMLINK "${parent}" OR IS_SYMLINK "${destination}")
      message(FATAL_ERROR "Firmware staging must not use linked directories: ${destination}")
    endif()
    file(MAKE_DIRECTORY "${parent}")
    file(REAL_PATH "${parent}" resolved_parent)
    cmake_path(IS_PREFIX workspace "${resolved_parent}" NORMALIZE parent_inside)
    if(NOT parent_inside)
      message(FATAL_ERROR "Firmware staging parent escaped its workspace: ${parent}")
    endif()
    if(EXISTS "${destination}")
      file(REAL_PATH "${destination}" resolved)
    else()
      get_filename_component(name "${destination}" NAME)
      set(resolved "${resolved_parent}/${name}")
    endif()
    cmake_path(IS_PREFIX workspace "${resolved}" NORMALIZE inside)
    if(NOT inside OR resolved STREQUAL workspace)
      message(FATAL_ERROR "Firmware staging escaped its workspace: ${destination}")
    endif()
    file(MAKE_DIRECTORY "${destination}")
  endforeach()
  ap_sync_firmware_inputs("${root}/firmware/R2500Adapter"
    "${workspace}/sketch/R2500Adapter" ProductIdentity.h)
  ap_sync_firmware_inputs("${root}/core" "${workspace}/library/AllpowersCore" library.properties src)
endfunction()
