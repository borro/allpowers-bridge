cmake_minimum_required(VERSION 3.26)
include("${ROOT}/cmake/Dependencies.cmake")
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" scratch)
file(REAL_PATH "${BUILD_ROOT}" build_root)
cmake_path(IS_PREFIX build_root "${scratch}" NORMALIZE inside)
if(NOT inside OR scratch STREQUAL build_root)
  message(FATAL_ERROR "Staging test requires a dedicated binary subdirectory")
endif()
file(REMOVE_RECURSE "${scratch}")
set(source "${scratch}/source")
file(MAKE_DIRECTORY "${source}/core" "${source}/firmware" "${source}/tests/fixtures"
  "${scratch}/data/packages/esp32/hardware/esp32/${ALLPOWERS_ESP32_VERSION}")
file(COPY "${ROOT}/core/src" "${ROOT}/core/native" "${ROOT}/core/library.properties.in" DESTINATION "${source}/core")
file(COPY "${ROOT}/firmware/R2500Adapter" DESTINATION "${source}/firmware")
file(COPY "${ROOT}/tests/fixtures/usb-contract.json" DESTINATION "${source}/tests/fixtures")
file(WRITE "${source}/firmware/R2500Adapter/removed.cpp" "// stale sketch input\n")
file(WRITE "${source}/core/src/removed.h" "// stale library input\n")
if(CMAKE_HOST_WIN32)
  set(cli "${scratch}/fake-cli.cmd")
  file(WRITE "${cli}" "@echo off\r\nif \"%1\"==\"version\" (\r\necho {\"VersionString\":\"${ALLPOWERS_ARDUINO_VERSION}\"}\r\nexit /b 0\r\n)\r\nexit /b 37\r\n")
else()
  set(cli "${scratch}/fake-cli")
  file(WRITE "${cli}" "#!/bin/sh\nif [ \"$1\" = version ]; then\nprintf '%s\\n' '{\"VersionString\":\"${ALLPOWERS_ARDUINO_VERSION}\"}'\nexit 0\nfi\nexit 37\n")
  file(CHMOD "${cli}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
endif()
function(stage)
  execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${source}" "-DWORK=${scratch}/work"
    "-DCLI=${cli}" "-DDATA=${scratch}/data" "-DOUTPUT=${scratch}/output" -DVERSION=1.2.3
    -P "${ROOT}/cmake/BuildFirmware.cmake" RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "37")
    message(FATAL_ERROR "Expected fake compiler to stop after actual staging: ${log}\n${error}")
  endif()
endfunction()
stage()
if(NOT EXISTS "${scratch}/work/sketch/R2500Adapter/removed.cpp")
  message(FATAL_ERROR "First real orchestration did not stage the fixture")
endif()
# Content, rather than a source timestamp, must invalidate staged inputs.
set(stable "${scratch}/work/library/AllpowersCore/src/AllpowersCore.h")
set(identity "${scratch}/work/sketch/R2500Adapter/ProductIdentity.h")
file(TIMESTAMP "${stable}" stable_time "%s")
file(TIMESTAMP "${identity}" identity_time "%s")
execute_process(COMMAND "${CMAKE_COMMAND}" -E sleep 1 COMMAND_ERROR_IS_FATAL ANY)
# A timestamp-only source change must not invalidate a staged compiler input.
file(TOUCH "${source}/core/src/AllpowersCore.h")
stage()
file(TIMESTAMP "${stable}" stable_again "%s")
file(TIMESTAMP "${identity}" identity_again "%s")
if(NOT stable_time STREQUAL stable_again OR NOT identity_time STREQUAL identity_again)
  message(FATAL_ERROR "Unchanged staged inputs or generated identity lost their timestamps")
endif()
file(APPEND "${source}/core/src/AllpowersCore.h" "\n// staging content change\n")
stage()
file(SHA256 "${source}/core/src/AllpowersCore.h" expected)
file(SHA256 "${stable}" actual)
file(TIMESTAMP "${stable}" changed_time "%s")
if(NOT actual STREQUAL expected OR changed_time STREQUAL stable_time)
  message(FATAL_ERROR "Changed source was not synchronized to the staged library")
endif()
# Membership changes must also handle transitions between files/directories.
file(WRITE "${source}/firmware/R2500Adapter/shape" "first a file\n")
stage()
file(REMOVE "${source}/firmware/R2500Adapter/shape")
file(MAKE_DIRECTORY "${source}/firmware/R2500Adapter/shape")
file(WRITE "${source}/firmware/R2500Adapter/shape/child.h" "then a directory\n")
stage()
file(READ "${scratch}/work/sketch/R2500Adapter/shape/child.h" child)
if(NOT child STREQUAL "then a directory\n")
  message(FATAL_ERROR "Staging did not replace a file with a directory")
endif()
file(REMOVE "${source}/firmware/R2500Adapter/shape/child.h")
file(REMOVE_RECURSE "${source}/firmware/R2500Adapter/shape")
file(WRITE "${source}/firmware/R2500Adapter/shape" "a file again\n")
stage()
file(READ "${scratch}/work/sketch/R2500Adapter/shape" shape)
if(NOT shape STREQUAL "a file again\n")
  message(FATAL_ERROR "Staging did not replace a directory with a file")
endif()

file(RENAME "${source}/firmware/R2500Adapter/removed.cpp" "${source}/firmware/R2500Adapter/renamed.cpp")
file(REMOVE "${source}/core/src/removed.h")
file(MAKE_DIRECTORY "${scratch}/work/compile")
file(WRITE "${scratch}/work/compile/cache-marker" "preserve")
stage()
if(EXISTS "${scratch}/work/sketch/R2500Adapter/removed.cpp" OR
    EXISTS "${scratch}/work/library/AllpowersCore/src/removed.h" OR
    NOT EXISTS "${scratch}/work/sketch/R2500Adapter/renamed.cpp" OR
    NOT EXISTS "${scratch}/work/compile/cache-marker")
  message(FATAL_ERROR "Real firmware staging retained deleted inputs or removed its compiler cache")
endif()
if(CMAKE_HOST_UNIX)
  file(MAKE_DIRECTORY "${scratch}/outside")
  file(WRITE "${scratch}/outside/sentinel" "preserve outside staging\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -E create_symlink "${scratch}/outside"
    "${scratch}/work/sketch/R2500Adapter/linked" COMMAND_ERROR_IS_FATAL ANY)
  file(WRITE "${scratch}/linked.cmake"
    "include(\"${ROOT}/cmake/StageFirmware.cmake\")\nap_stage_firmware(\"${source}\" \"${scratch}/work\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -P "${scratch}/linked.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(result EQUAL 0 OR NOT error MATCHES "linked inputs")
    message(FATAL_ERROR "Staging accepted a linked directory: ${log}\n${error}")
  endif()
  file(READ "${scratch}/outside/sentinel" sentinel)
  if(NOT sentinel STREQUAL "preserve outside staging\n")
    message(FATAL_ERROR "Staging modified a path outside its input mirror")
  endif()
  file(REMOVE "${scratch}/work/sketch/R2500Adapter/linked")
endif()
