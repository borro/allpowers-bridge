cmake_minimum_required(VERSION 4.4)
file(MAKE_DIRECTORY "${WORK}/source")
file(CONFIGURE OUTPUT "${WORK}/source/CMakeLists.txt" CONTENT [=[
cmake_minimum_required(VERSION 4.4)
project(ModuleBoundaryProbe LANGUAGES NONE)
set(CMAKE_DISABLE_FIND_PACKAGE_Git TRUE)
set(CMAKE_DISABLE_FIND_PACKAGE_Python3 TRUE)
# Conflicting selections deliberately must not be validated by include().
set(ALLPOWERS_COVERAGE ON)
set(ALLPOWERS_SANITIZERS ON)
set(ALLPOWERS_MUTATION ON)
set(ALLPOWERS_FUZZING ON)
set(ALLPOWERS_STATIC_ANALYSIS ON)
get_cmake_property(before CACHE_VARIABLES)
file(GLOB_RECURSE modules "@ROOT@/cmake/modules/*.cmake")
foreach(module IN LISTS modules)
  file(READ "${module}" content)
  if(content MATCHES "include[ \t\r\n]*\\([^)]*/scripts/")
    message(FATAL_ERROR "A reusable module includes an executable entry: ${module}")
  endif()
  include("${module}")
endforeach()
get_cmake_property(after CACHE_VARIABLES)
get_property(targets DIRECTORY PROPERTY BUILDSYSTEM_TARGETS)
get_property(compile_options DIRECTORY PROPERTY COMPILE_OPTIONS)
get_property(link_options DIRECTORY PROPERTY LINK_OPTIONS)
if(NOT before STREQUAL after OR targets OR compile_options OR link_options)
  message(FATAL_ERROR "Including modules must not configure options, create targets or set global flags")
endif()
]=] @ONLY)
execute_process(COMMAND "${CMAKE_COMMAND}" -S "${WORK}/source" -B "${WORK}/build" -G Ninja
  "-DCMAKE_MAKE_PROGRAM=${NINJA}" COMMAND_ERROR_IS_FATAL ANY)
message(STATUS "All reusable modules include without configuring a build or discovering external tools")
