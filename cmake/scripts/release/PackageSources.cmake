cmake_minimum_required(VERSION 4.4)
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/Files.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../Dependencies.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../../modules/common/PublicSources.cmake")
execute_process(COMMAND "${CMAKE_COMMAND}" -DMODE=VERIFY "-DPREFIX=${QT_ROOT}"
  "-DSOURCE_CACHE=${SOURCE_CACHE}" -P "${CMAKE_CURRENT_LIST_DIR}/../sdk/QtSourceIdentity.cmake"
  COMMAND_ERROR_IS_FATAL ANY)
ap_public_sources(OUTPUT public_files ROOT "${ROOT}")
execute_process(COMMAND "${CMAKE_COMMAND}" "-DROOT=${ROOT}" -DMODE=worktree
  -P "${CMAKE_CURRENT_LIST_DIR}/../quality/Audit.cmake" COMMAND_ERROR_IS_FATAL ANY)
if(NOT BUILD_ROOT)
  message(FATAL_ERROR "Set BUILD_ROOT to the configured binary directory")
endif()
file(REAL_PATH "${BUILD_ROOT}" build_root)
file(MAKE_DIRECTORY "${WORK}")
file(REAL_PATH "${WORK}" work_path)
set(payload_path "${work_path}/payload")
if(EXISTS "${payload_path}")
  file(REAL_PATH "${payload_path}" payload_path)
endif()
ap_remove_tree(ROOT "${build_root}" PATH "${payload_path}")
file(MAKE_DIRECTORY "${WORK}/payload/allpowers" "${WORK}/payload/qt-source" "${OUTPUT}")
set(payload "${WORK}/payload")
foreach(name IN LISTS public_files)
  get_filename_component(parent "${name}" DIRECTORY)
  file(MAKE_DIRECTORY "${payload}/allpowers/${parent}")
  file(COPY_FILE "${ROOT}/${name}" "${payload}/allpowers/${name}" ONLY_IF_DIFFERENT)
endforeach()
string(REPLACE ";" "\n" inventory "${public_files}")
file(WRITE "${payload}/allpowers/SOURCE_FILES" "${inventory}\n")
file(WRITE "${payload}/allpowers/VERSION" "${VERSION}\n")
foreach(module qtbase qtconnectivity qttools)
  set(name "${module}-everywhere-src-${ALLPOWERS_QT_VERSION}.tar.xz")
  string(TOUPPER "${module}" key)
  file(SHA256 "${SOURCE_CACHE}/${name}" actual)
  if(NOT actual STREQUAL ALLPOWERS_${key}_SHA256)
    message(FATAL_ERROR "Qt corresponding-source hash mismatch: ${name}")
  endif()
  file(COPY_FILE "${SOURCE_CACHE}/${name}" "${payload}/qt-source/${name}" ONLY_IF_DIFFERENT)
endforeach()
file(COPY_FILE "${QT_ROOT}/allpowers-source-identity.cmake" "${payload}/qt-source/SDK-LIBRARIES.sha256")
set(config "${WORK}/CPackSourceConfig.cmake")
file(CONFIGURE OUTPUT "${config}" CONTENT [=[
set(CPACK_GENERATOR ZIP)
set(CPACK_PACKAGE_NAME AllpowersMonitor)
set(CPACK_PACKAGE_VERSION "@VERSION@")
set(CPACK_PACKAGE_DESCRIPTION_SUMMARY "ALLPOWERS corresponding application and Qt sources")
set(CPACK_PACKAGE_DESCRIPTION_FILE "@ROOT@/README.md")
set(CPACK_PACKAGE_FILE_NAME "AllpowersMonitor-@VERSION@-sources-with-qt")
set(CPACK_PACKAGE_DIRECTORY "@OUTPUT@")
set(CPACK_PACKAGE_CHECKSUM SHA256)
set(CPACK_INCLUDE_TOPLEVEL_DIRECTORY OFF)
set(CPACK_INSTALLED_DIRECTORIES "@payload@;/")
]=] @ONLY)
execute_process(COMMAND "${CMAKE_CPACK_COMMAND}" --config "${config}" COMMAND_ERROR_IS_FATAL ANY)
